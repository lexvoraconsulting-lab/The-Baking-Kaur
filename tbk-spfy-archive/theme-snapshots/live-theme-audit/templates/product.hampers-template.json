            "custom_liquid": "<div id=\"upload-wrapper-{{ section.id }}\" class=\"product-custom-uploads\">\n  <label class=\"hdt-product-form__label hdt-s-text hdt-quantity__label \" style=\"font-weight: bold;\">Upload your images:</label>\n  <div id=\"upload-fields-{{ section.id }}\"></div>\n  <button class=\"hdt-inline-block hdt-product__form-qty hdt-s-text\" style=\"margin-top: 10px;\" type=\"button\" id=\"add-upload-{{ section.id }}\"> + Add More </button>\n</div>\n\n<script>\n(function() {\n  var uploadWrapper = document.getElementById(\"upload-fields-{{ section.id }}\");\n  var addBtn = document.getElementById(\"add-upload-{{ section.id }}\");\n  var counter = 1;\n\n  function addField() {\n    var div = document.createElement(\"div\");\n    div.style.marginTop = \"8px\";\n    div.innerHTML = `\n      <div class=\"hdt-product-form_value  is-type-block\" >\n      <label class=\"hdt-product-form__label hdt-s-text is-type-block\">Image ${counter}:</label>\n      <input type=\"file\" name=\"properties[Custom Image ${counter}]\" accept=\"image/*\" />\n      </div> <button class=\"remove_btn\">\nRemove\n</button>\n    `;\n    uploadWrapper.appendChild(div);\n    counter++;\n  }\n\n  addBtn.addEventListener(\"click\", function() {\n    addField();\n  });\n\n  // Add first field by default\n  addField();\n})();\n</script>"
          }
