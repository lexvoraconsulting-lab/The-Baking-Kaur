        "custom_liquid_gEjgr6": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<h3 style=\"margin-bottom:15px;\">Select Cake Design</h3>\n\n<div class=\"cake-grid\">\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Chocolate Cake\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/7.png?v=1780510703\">\n<p>Chocolate</p>\n</label>\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Red Velvet\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/6.png?v=1780510703\">\n<p>Red Velvet</p>\n</label>\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Black Forest\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/2.png?v=1780510703\">\n<p>Black Forest</p>\n</label>\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Butterscotch\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/9.webp?v=1780510688\">\n<p>Butterscotch</p>\n</label>\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Fresh Fruit\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/9.webp?v=1780510688\">\n<p>Fresh Fruit</p>\n</label>\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Floral Cake\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/5.webp?v=1780510688\">\n<p>Floral Cake</p>\n</label>\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Designer Cake\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/8.webp?v=1780510688\">\n<p>Designer Cake</p>\n</label>\n\n<label class=\"cake-card\">\n<input type=\"radio\" name=\"properties[Cake Design]\" value=\"Heart Cake\">\n<img src=\"https://cdn.shopify.com/s/files/1/0667/9930/4873/files/1_46a5cd2a-f89f-48bd-8d8c-29be199493c2.png?v=1780510703\">\n<p>Heart Cake</p>\n</label>\n\n</div>\n\n<style>\n\n.cake-grid{\ndisplay:grid;\ngrid-template-columns:repeat(4,1fr);\ngap:10px;\nmargin-top:10px;\n}\n\n.cake-card{\nborder:1px solid #e8e8e8;\nborder-radius:12px;\npadding:8px;\nbackground:#fff;\ncursor:pointer;\ntext-align:center;\ntransition:all .25s ease;\n}\n\n.cake-card:hover{\nbox-shadow:0 6px 18px rgba(0,0,0,.08);\ntransform:translateY(-2px);\n}\n\n.cake-card input{\ndisplay:none;\n}\n\n.cake-card img{\nwidth:100%;\nheight:85px;\nobject-fit:cover;\nborder-radius:8px;\n}\n\n.cake-card p{\nfont-size:12px;\nfont-weight:600;\nmargin:6px 0 0;\nline-height:1.3;\n}\n\n.cake-card input:checked + img{\nborder:3px solid #c96b8f;\n}\n\n@media(max-width:768px){\n\n.cake-grid{\ngrid-template-columns:repeat(2,1fr);\ngap:8px;\n}\n\n.cake-card img{\nheight:75px;\n}\n\n}\n\n</style>"
