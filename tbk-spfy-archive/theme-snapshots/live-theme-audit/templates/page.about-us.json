    "custom_liquid_tWfYTV": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-faq-wrapper\">\n\n  <h2 class=\"tbk-faq-heading\">\n    Frequently Asked Questions\n  </h2>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Do you make custom cakes in Meerut?</h3>\n    <p>\n      Yes, The Baking Kaur specialises in luxury custom cakes in Meerut.\n      All cakes are designed to order based on your occasion, theme, flavour,\n      and serving size requirements.\n    </p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Are your cakes 100% eggless?</h3>\n    <p>\n      Yes, we offer 100% eggless cakes without compromising on taste,\n      texture, or quality. Eggless options are available for all custom orders.\n    </p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>How early should I place a custom cake order?</h3>\n    <p>\n      We recommend placing custom cake orders at least 2–3 days in advance.\n      For wedding cakes or large celebrations, earlier booking is advised.\n    </p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Do you provide cake delivery in Meerut?</h3>\n    <p>\n      Yes, we offer reliable same-day and scheduled cake delivery across Meerut,\n      with secure packaging to maintain freshness and design.\n    </p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>How can I place an order with The Baking Kaur?</h3>\n    <p>\n      You can place an order by contacting us via WhatsApp or by browsing\n      our cake collections on the website and sharing your requirements.\n    </p>\n  </div>\n\n</div>\n\n<style>\n.tbk-faq-wrapper {\n  max-width: 820px;\n  margin: auto;\n}\n\n.tbk-faq-heading {\n  font-size: 26px;\n  text-align: center;\n  margin-bottom: 24px;\n}\n\n.tbk-faq-item {\n  margin-bottom: 18px;\n}\n\n.tbk-faq-item h3 {\n  font-size: 16px;\n  margin-bottom: 6px;\n}\n\n.tbk-faq-item p {\n  font-size: 15px;\n  line-height: 1.8;\n  color: #4a4a4a;\n}\n\n/* Mobile */\n@media (max-width: 768px) {\n  .tbk-faq-heading {\n    font-size: 22px;\n  }\n}\n</style>",
