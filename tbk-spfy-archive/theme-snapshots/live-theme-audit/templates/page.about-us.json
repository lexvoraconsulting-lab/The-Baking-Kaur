      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-about-text\">\n  <ul class=\"tbk-about-list\">\n    <li>Made-to-order luxury cakes using premium-quality ingredients</li>\n    <li>100% eggless options with rich, balanced flavours</li>\n    <li>Expertise in wedding, anniversary, and designer cakes</li>\n    <li>Strict hygiene standards and professional baking practices</li>\n    <li>Reliable same-day and scheduled delivery across Meerut</li>\n  </ul>\n</div>\n\n<style>\n/* FORCE BULLETS TO SHOW */\n.tbk-about-list {\n  list-style-type: disc !important;\n  padding-left: 22px !important;\n  margin-top: 14px;\n}\n\n.tbk-about-list li {\n  display: list-item !important;\n  margin-bottom: 10px;\n  font-size: 15px;\n  line-height: 1.8;\n  color: #4a4a4a;\n}\n\n/* Mobile optimization */\n@media (max-width: 768px) {\n  .tbk-about-list {\n    padding-left: 18px !important;\n  }\n}\n</style>",
