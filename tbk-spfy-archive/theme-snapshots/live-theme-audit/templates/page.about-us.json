    "custom_liquid_CUGUeK": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-process-wrapper\">\n\n  <h2 class=\"tbk-process-heading\">\n    Our Custom Cake Process – From Idea to Celebration\n  </h2>\n\n  <p class=\"tbk-process-intro\">\n    At <strong>The Baking Kaur</strong>, we follow a refined, step-by-step process to create luxury custom cakes in Meerut. \n    Every order is handled with precision, hygiene, and personalised attention to deliver a flawless celebration experience.\n  </p>\n\n  <div class=\"tbk-process-steps\">\n\n    <div class=\"tbk-step\">\n      <span class=\"tbk-step-number\">01</span>\n      <h3>Consultation & Design Planning</h3>\n      <p>\n        We begin by understanding your occasion, design preferences, flavour choices, and serving size. \n        Whether it’s a wedding, anniversary, or birthday, every detail is carefully discussed.\n      </p>\n    </div>\n\n    <div class=\"tbk-step\">\n      <span class=\"tbk-step-number\">02</span>\n      <h3>Premium Ingredient Selection</h3>\n      <p>\n        All cakes are made-to-order using high-quality ingredients, with 100% eggless options available. \n        We focus on balanced sweetness, rich flavours, and consistent quality.\n      </p>\n    </div>\n\n    <div class=\"tbk-step\">\n      <span class=\"tbk-step-number\">03</span>\n      <h3>Handcrafted Baking & Detailing</h3>\n      <p>\n        Each cake is freshly baked and handcrafted by skilled professionals, ensuring refined finishing, \n        elegant aesthetics, and precise detailing.\n      </p>\n    </div>\n\n    <div class=\"tbk-step\">\n      <span class=\"tbk-step-number\">04</span>\n      <h3>Quality Check & Safe Delivery</h3>\n      <p>\n        Before dispatch, every cake goes through strict hygiene and quality checks. \n        We offer reliable same-day and scheduled delivery across Meerut for a smooth, stress-free experience.\n      </p>\n    </div>\n\n  </div>\n\n</div>\n\n<style>\n.tbk-process-wrapper {\n  max-width: 780px;\n  margin: auto;\n}\n\n.tbk-process-heading {\n  text-align: center;\n  font-size: 26px;\n  margin-bottom: 12px;\n}\n\n.tbk-process-intro {\n  text-align: center;\n  font-size: 15px;\n  line-height: 1.8;\n  color: #4a4a4a;\n  margin-bottom: 30px;\n}\n\n.tbk-process-steps {\n  display: flex;\n  flex-direction: column;\n  gap: 26px;\n}\n\n.tbk-step {\n  position: relative;\n  padding-left: 56px;\n}\n\n.tbk-step-number {\n  position: absolute;\n  left: 0;\n  top: 0;\n  font-size: 22px;\n  font-weight: 600;\n  color: #c06;\n}\n\n.tbk-step h3 {\n  font-size: 17px;\n  margin-bottom: 6px;\n}\n\n.tbk-step p {\n  font-size: 15px;\n  line-height: 1.8;\n  color: #4a4a4a;\n}\n\n/* Mobile */\n@media (max-width: 768px) {\n  .tbk-process-heading {\n    font-size: 22px;\n  }\n\n  .tbk-step {\n    padding-left: 44px;\n  }\n\n  .tbk-step-number {\n    font-size: 20px;\n  }\n}\n</style>",
        "color_scheme": "",
        "padding_top": 40,
