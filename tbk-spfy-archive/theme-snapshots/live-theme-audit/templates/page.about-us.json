    "custom_liquid_nNWL9P": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-cta-wrapper\">\n\n  <h2 class=\"tbk-cta-heading\">\n    Ready to Order Your Luxury Custom Cake?\n  </h2>\n\n  <p class=\"tbk-cta-text\">\n    Whether you’re planning a wedding, birthday, anniversary, or a special celebration,\n    <strong>The Baking Kaur</strong> is here to create a cake that reflects your style,\n    taste, and occasion. Get in touch today to discuss your custom cake requirements.\n  </p>\n\n  <div class=\"tbk-cta-buttons\">\n    <a href=\"https://wa.me/91?text=Hi%20The%20Baking%20Kaur%2C%20I%20want%20to%20order%20a%20custom%20cake.\"\n       class=\"tbk-btn tbk-btn-primary\">\n      WhatsApp Us to Order\n    </a>\n\n    <a href=\"/collections/all\" class=\"tbk-btn tbk-btn-secondary\">\n      View Our Cake Collection\n    </a>\n  </div>\n\n</div>\n\n<style>\n.tbk-cta-wrapper {\n  max-width: 900px;\n  margin: 60px auto;\n  padding: 50px 30px;\n  text-align: center;\n  background: #faf7f8;\n  border-radius: 12px;\n}\n\n.tbk-cta-heading {\n  font-size: 28px;\n  margin-bottom: 14px;\n}\n\n.tbk-cta-text {\n  font-size: 15px;\n  line-height: 1.8;\n  color: #4a4a4a;\n  max-width: 680px;\n  margin: 0 auto 30px;\n}\n\n.tbk-cta-buttons {\n  display: flex;\n  justify-content: center;\n  gap: 18px;\n  flex-wrap: wrap;\n}\n\n.tbk-btn {\n  padding: 12px 26px;\n  font-size: 15px;\n  text-decoration: none;\n  border-radius: 6px;\n  font-weight: 500;\n}\n\n.tbk-btn-primary {\n  background: #7a1f3d;\n  color: #ffffff;\n}\n\n.tbk-btn-primary:hover {\n  opacity: 0.9;\n}\n\n.tbk-btn-secondary {\n  background: transparent;\n  border: 1px solid #7a1f3d;\n  color: #7a1f3d;\n}\n\n.tbk-btn-secondary:hover {\n  background: #7a1f3d;\n  color: #ffffff;\n}\n\n/* Mobile */\n@media (max-width: 768px) {\n  .tbk-cta-heading {\n    font-size: 22px;\n  }\n\n  .tbk-cta-wrapper {\n    padding: 40px 20px;\n  }\n}\n</style>",
        "color_scheme": "",
