    "custom_liquid_rjhmzr": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-geo-wrapper\">\n\n  <h2 class=\"tbk-geo-heading\">\n    Luxury Custom Cake Delivery in Meerut\n  </h2>\n\n  <p class=\"tbk-geo-intro\">\n    <strong>The Baking Kaur</strong> proudly serves as a trusted luxury cake bakery in Meerut, Uttar Pradesh, \n    offering freshly baked, custom-designed cakes with reliable delivery across the city.\n  </p>\n\n  <p class=\"tbk-geo-text\">\n    We provide same-day and scheduled cake delivery in major areas of Meerut, ensuring your celebrations \n    are seamless and stress-free. Every cake is prepared fresh, packaged securely, and delivered with care.\n  </p>\n\n  <ul class=\"tbk-geo-list\">\n    <li>Luxury custom cakes in <strong>Meerut Cantt</strong></li>\n    <li>Designer cakes delivery in <strong>Shastri Nagar</strong></li>\n    <li>Birthday & anniversary cakes in <strong>Pallavpuram</strong></li>\n    <li>Wedding cakes in <strong>Modipuram</strong></li>\n    <li>Same-day cake delivery in <strong>Partapur</strong></li>\n    <li>Custom cake orders across <strong>Central & South Meerut</strong></li>\n  </ul>\n\n  <p class=\"tbk-geo-footer\">\n    Whether you’re planning a wedding, birthday, anniversary, or premium celebration, \n    The Baking Kaur is your go-to destination for <strong>luxury custom cakes in Meerut</strong>.\n  </p>\n\n</div>\n\n<style>\n.tbk-geo-wrapper {\n  max-width: 780px;\n  margin: auto;\n}\n\n.tbk-geo-heading {\n  text-align: center;\n  font-size: 26px;\n  margin-bottom: 14px;\n}\n\n.tbk-geo-intro,\n.tbk-geo-text,\n.tbk-geo-footer {\n  font-size: 15px;\n  line-height: 1.8;\n  color: #4a4a4",
