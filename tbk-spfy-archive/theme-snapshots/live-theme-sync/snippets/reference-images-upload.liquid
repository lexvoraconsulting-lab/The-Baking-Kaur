<div class="tbk-upload-wrapper" style="margin:15px 0;">
  <label><strong>Upload Reference Images (Max 10)</strong></label>

  <input
    type="file"
    name="properties[Reference Images]"
    accept="image/*"
    multiple
    id="tbk-reference-images"
  >

  <small>You can upload up to 10 images (JPG / PNG)</small>

  <div id="tbk-preview" style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;"></div>
</div>
