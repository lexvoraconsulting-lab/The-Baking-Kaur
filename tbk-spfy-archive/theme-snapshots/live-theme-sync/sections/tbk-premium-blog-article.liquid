innerHTML='<a href="#'+id+'"><span class="num">'+(i===0?'✓':i)+'</span><span>'+h.textContent.trim()+'</span></a>';d.appendChild(x.cloneNode(true));m.appendChild(x)});const words=b.innerText.trim().split(/\s+/).length,rt=root.querySelector('#rt-{{ section.id }}');if(rt)rt.textContent=Math.max(3,Math.round(words/200))+' min read';const as=root.querySelectorAll('.toc a');const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)as.forEach(a=>a.classList.toggle('active',a.hash==='#'+e.target.id))}),{rootMargin:'-20% 0px -70% 0px'});hs.forEach(h=>io.observe(h))})();</script>{% schema %}{"name":"TBK Premium Blog Article","settings":[]}{% endschema %}