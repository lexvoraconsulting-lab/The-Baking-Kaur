{%- assign cur = product.selected_or_first_available_variant -%}
<div class="tbk-buybox">
  <div class="tbk-buybox-head">
    <span class="tbk-eyebrow">Personalise your celebration</span>
    <p class="tbk-buybox-copy">Select the perfect flavour, size and delivery details to ensure your cake arrives beautifully.</p>
  </div>

  <div class="tbk-configurator">
    {%- for opt in product.options_with_values -%}
      <div class="tbk-field">
        <label for="tbk-option-{{ section.id }}-{{ forloop.index0 }}">{{ opt.name }}</label>
        <div class="tbk-control">
          <span class="icon">{% case opt.name | downcase %}{% when 'flavour' or 'flavor' %}🍓{% when 'size' or 'weight' %}⚖️{% when 'type' %}🍰{% else %}🍰{% endcase %}</span>
          <select id="tbk-option-{{ section.id }}-{{ forloop.index0 }}" data-tbk-option="{{ forloop.index0 }}" aria-label="Select {{ opt.name }}">
            {%- for val in opt.values -%}
              <option value="{{ val | escape }}" {% if opt.selected_value == val %}selected{% endif %}>{{ val }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>
    {%- endfor -%}
  </div>

  <div class="tbk-customization">
    <div class="tbk-field">
      <label for="tbk-delivery-date-{{ section.id }}">Delivery Date</label>
      <div class="tbk-control">
        <span class="icon">📅</span>
        <input id="tbk-delivery-date-{{ section.id }}" type="date" name="properties[Delivery Date]" required aria-required="true">
      </div>
    </div>

    <div class="tbk-field">
      <label for="tbk-time-slot-{{ section.id }}">Delivery Time Slot</label>
      <div class="tbk-control">
        <span class="icon">🕒</span>
        <select id="tbk-time-slot-{{ section.id }}" name="properties[Time Slot]" required aria-required="true">
          <option value="" disabled selected>Select Time Slot</option>
          <option>9 AM – 12 PM</option>
          <option>12 PM – 3 PM</option>
          <option>3 PM – 6 PM</option>
          <option>6 PM – 9 PM</option>
          <option>Midnight</option>
        </select>
      </div>
    </div>

    <div class="tbk-field">
      <label for="tbk-cake-message-{{ section.id }}">Cake Message</label>
      <div class="tbk-control">
        <span class="icon">✍️</span>
        <textarea id="tbk-cake-message-{{ section.id }}" name="properties[Cake Message]" placeholder="Add a message for the cake"></textarea>
      </div>
    </div>

    <div class="tbk-field">
      <label for="tbk-reference-image-{{ section.id }}">Reference Image</label>
      <div class="tbk-control">
        <span class="icon">📎</span>
        <input id="tbk-reference-image-{{ section.id }}" type="file" name="properties[Reference Image]" accept="image/*" aria-label="Upload reference image">
      </div>
    </div>
  </div>

  <input type="hidden" name="id" id="tbk-vid-{{ section.id }}" value="{{ cur.id }}">

  <div class="tbk-ctas">
    <button type="submit" class="tbk-btn tbk-btn-cart" id="tbk-add-{{ section.id }}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1.6"/><circle cx="18" cy="21" r="1.6"/><path d="M2.5 3h2l2.2 12.4a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.2L21 7H6"/></svg>
      <span data-tbk-addlabel>ADD TO CART</span>
      <span style="opacity:.7">•</span>
      <span data-tbk-addprice>{{ cur.price | money }}</span>
    </button>
    <a class="tbk-btn tbk-btn-wa" id="tbk-wa-{{ section.id }}" target="_blank" rel="noopener" href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ 'Hi! I would like to customize: ' | append: product.title | url_encode }}%20{{ shop.url | append: product.url | url_encode }}">
      <svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.2 0-.3 0-.5l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.6 4c2.1.9 2.1.6 2.5.6a2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
      WHATSAPP CUSTOMIZATION
    </a>
  </div>
  <p class="tbk-note">Add a delivery date and slot so we can confirm your cake on time.</p>
</div>
