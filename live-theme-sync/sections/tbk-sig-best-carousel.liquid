 .tbk-art .tbk-sec:has(.tbk-products){padding:18px 10px 20px!important;overflow:visible!important;background:#fffdfb!important}
 .tbk-art .tbk-sec:has(.tbk-products)>h2{font-size:23px!important;line-height:1.1!important;margin:0 0 12px!important;color:#6f173f!important;white-space:nowrap!important}
