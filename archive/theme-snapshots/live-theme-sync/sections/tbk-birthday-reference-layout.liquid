{% comment %} TBK Birthday Collection reference layout. Header is untouched. {% endcomment %}
{% if collection.handle == 'birthday-cakes' %}
{% assign birthday_hero = 'https://cdn.shopify.com/s/files/1/0667/9930/4873/files/tbk-birthday-collection.jpg?v=1787081306' %}
<section class="tbk-bday-page">
<div class="tbk-bday-hero"><img src="{{ birthday_hero }}" alt="Birthday Cakes in Meerut — The Baking Kaur" loading="eager" fetchpriority="high" width="1600" height="900"></div>
<div class="tbk-bday-wrap">
<div class="tbk-bday-title"><span>EXPLORE</span> BIRTHDAY CAKES</div><div class="tbk-bday-rule">♡</div>
<div class="tbk-cat-grid">
{% assign cat_handles = 'kids-birthday-cakes-meerut,designer-theme-cakes,photo-cakes,chocolate-cakes,floral-cakes,minimal-cakes' | split: ',' %}
{% for handle in cat_handles %}{% assign cat = collections[handle] %}{% if cat != blank %}{% assign cat_img = cat.featured_image %}{% if cat_img == blank and cat.products_count > 0 %}{% assign cat_img = cat.products.first.featured_image %}{% endif %}
<a class="tbk-cat-card" href="{{ cat.url }}"><div class="tbk-cat-img">{% if cat_img %}<img src="{{ cat_img | image_url: width: 600 }}" alt="{{ cat.title | escape }} in Meerut" loading="lazy">{% endif %}</div><div class="tbk-cat-name">{{ cat.title }}</div><div class="tbk-cat-link">EXPLORE →</div></a>
{% endif %}{% endfor %}
</div>
<div class="tbk-bday-title tbk-best-title">BESTSELLING BIRTHDAY CAKES</div><div class="tbk-bday-rule"></div>
<div class="tbk-product-grid">{% for product in collection.products limit: 5 %}<article class="tbk-product-card"><a href="{{ product.url }}" class="tbk-product-image">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }} in Meerut" loading="lazy">{% endif %}</a><div class="tbk-product-body"><a href="{{ product.url }}" class="tbk-product-name">{{ product.title }}</a><div class="tbk-product-price">From {{ product.price_min | money }}</div><div class="tbk-stars">★★★★★</div><a href="{{ product.url }}" class="tbk-product-btn">SELECT OPTIONS</a></div></article>{% endfor %}</div>
<div class="tbk-service-grid"><div><b>◔ MIDNIGHT DELIVERY</b><span>Delivering smiles even after 12 AM</span></div><div><b>◔ LATE NIGHT DELIVERY</b><span>Available for night surprises</span></div><div><b>♧ SURPRISE DELIVERY</b><span>We keep it a secret, you make it special</span></div><div><b>♧ SAME-DAY DELIVERY</b><span>Express 2–4 hour delivery in Meerut</span></div><div><b>♧ DELIVERY ACROSS MEERUT</b><span>Fast & reliable delivery in selected areas</span></div></div>
<div class="tbk-order-bar"><div><b>♧ Order by 5 PM for Same-Day Delivery</b><span>Midnight & late night delivery available on advance confirmation.</span></div><a href="/pages/contact-us">CHECK DELIVERY AVAILABILITY</a></div>
<div class="tbk-info-grid"><div class="tbk-about"><h2>Birthday Cakes in Meerut</h2><p>From adorable kids theme cakes to elegant designer cakes, The Baking Kaur creates 100% eggless birthday cakes with love, premium ingredients and the perfect finishing.</p><ul><li>100% Eggless & Pure Vegetarian</li><li>Wide Range of Flavours</li><li>Custom Designs for Kids & Adults</li><li>Late Night, Midnight & Surprise Delivery</li><li>Doorstep Delivery Across Meerut</li></ul><div class="tbk-trust-mini"><span>TOP 10 BAKERIES<br>IN MEERUT BY ZOMATO</span><span>GOOGLE RATING<br><b>4.8 ★★★★★</b></span></div></div>
<div class="tbk-faq"><h2>Frequently Asked Questions</h2><details><summary>How can I order a birthday cake in Meerut?</summary><p>Choose your cake, select the required options and place your order online. You can also contact us for custom designs.</p></details><details><summary>Do you offer same-day or late night delivery?</summary><p>Yes. Same-day delivery is available for eligible orders, and late-night or midnight delivery can be arranged in Meerut with advance confirmation.</p></details><details><summary>Can I get a cake delivered at midnight?</summary><p>Yes, midnight delivery is available in selected Meerut areas subject to advance confirmation.</p></details><details><summary>Are your cakes 100% eggless?</summary><p>Yes. Our cakes are 100% eggless and vegetarian.</p></details><details><summary>Can I customize the design and message on the cake?</summary><p>Yes. Custom designs, names and messages can be requested before ordering.</p></details><details><summary>Do you deliver outside Meerut city?</summary><p>Delivery availability depends on the exact location. Contact us to check.</p></details></div></div>
<div class="tbk-bday-title">YOU MAY ALSO LIKE</div>
<div class="tbk-related-grid">{% assign related_handles = 'anniversary-cakes,engagement-cakes,wedding-cakes,cake-hampers' | split: ',' %}{% for handle in related_handles %}{% assign rel = collections[handle] %}{% if rel != blank %}{% assign rel_img = rel.featured_image %}{% if rel_img == blank and rel.products_count > 0 %}{% assign rel_img = rel.products.first.featured_image %}{% endif %}<a href="{{ rel.url }}" class="tbk-related-card">{% if rel_img %}<img src="{{ rel_img | image_url: width: 800 }}" alt="{{ rel.title | escape }} in Meerut" loading="lazy">{% endif %}<b>{{ rel.title }}</b><span>EXPLORE →</span></a>{% endif %}{% endfor %}</div>
<div class="tbk-bottom-trust"><div><b>♙</b><strong>10,000+</strong><span>Happy Customers</span></div><div><b>☆</b><strong>4.8 Star Rating</strong><span>on Google</span></div><div><b>♙</b><strong>100% Secure</strong><span>Payments</span></div><div><b>♧</b><strong>Hygienic Preparation</strong><span>Always</span></div><div><b>♡</b><strong>Made With Love</strong><span>For Every Celebration</span></div></div>
</div></section>
<style>
.tbk-bday-page{background:#fbf3e9;color:#2f2925}.tbk-bday-hero{width:100%;overflow:hidden;background:#eee0d0}.tbk-bday-hero img{display:block;width:100%;height:auto;max-height:620px;object-fit:cover}.tbk-bday-wrap{max-width:1440px;margin:0 auto;padding:0 32px 48px}.tbk-bday-title{text-align:center;font-family:Georgia,serif;font-size:22px;letter-spacing:.05em;margin:24px 0 2px}.tbk-bday-title span{color:#b84f50}.tbk-bday-rule{text-align:center;color:#b84f50;font-size:20px;margin-bottom:18px}.tbk-cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}.tbk-cat-card,.tbk-related-card{display:block;background:#fffaf3;border:1px solid #eadbc9;border-radius:9px;overflow:hidden;text-decoration:none;color:inherit;box-shadow:0 1px 3px rgba(50,30,20,.05)}.tbk-cat-img{aspect-ratio:1.28;overflow:hidden;background:#eee2d3}.tbk-cat-img img,.tbk-related-card img{width:100%;height:100%;object-fit:cover;display:block}.tbk-cat-name{text-align:center;font-family:Georgia,serif;font-size:14px;font-weight:700;padding:8px 5px 3px}.tbk-cat-link{text-align:center;font-size:10px;font-weight:700;color:#a94649;padding:0 0 11px}.tbk-best-title{margin-top:30px}.tbk-product-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}.tbk-product-card{background:#fffaf3;border:1px solid #eadbc9;border-radius:10px;overflow:hidden}.tbk-product-image{display:block;aspect-ratio:1/1;overflow:hidden;background:#eee2d3}.tbk-product-image img{width:100%;height:100%;object-fit:cover;display:block}.tbk-product-body{padding:10px 11px 12px}.tbk-product-name{display:block;color:#29231f;text-decoration:none;font-family:Georgia,serif;font-size:14px;font-weight:700;min-height:36px}.tbk-product-price{font-size:12px;margin-top:3px}.tbk-stars{color:#c99418;font-size:13px;margin:4px 0 7px;letter-spacing:1px}.tbk-product-btn{display:block;text-align:center;border:1px solid #dfb8a8;border-radius:5px;color:#a94649;text-decoration:none;font-size:10px;font-weight:700;padding:7px 4px}.tbk-service-grid{display:grid;grid-template-columns:repeat(5,1fr);margin-top:22px;background:#f7e9da;border:1px solid #ead8c5;border-radius:6px;overflow:hidden}.tbk-service-grid>div{padding:13px 12px;border-right:1px solid #e7d3bf}.tbk-service-grid>div:last-child{border-right:0}.tbk-service-grid b{display:block;font-size:10px;color:#6e4c42}.tbk-service-grid span{display:block;font-size:10px;margin-top:3px;line-height:1.35}.tbk-order-bar{display:flex;align-items:center;justify-content:space-between;gap:20px;background:#f8eee3;border:1px solid #ead8c5;border-radius:6px;margin-top:12px;padding:12px 18px}.tbk-order-bar b{display:block;font-family:Georgia,serif;font-size:14px}.tbk-order-bar span{display:block;font-size:10px;margin-top:3px}.tbk-order-bar a{white-space:nowrap;border:1px solid #bd6863;color:#a94c4d;text-decoration:none;border-radius:5px;padding:8px 13px;font-size:10px;font-weight:700}.tbk-info-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:30px;margin-top:18px;background:#f8eee3;border:1px solid #ead8c5;border-radius:7px;padding:22px}.tbk-info-grid h2{font-family:Georgia,serif;font-size:22px;margin:0 0 8px}.tbk-info-grid p{font-size:12px;line-height:1.6;margin:0 0 10px}.tbk-about ul{padding:0;margin:0;list-style:none;font-size:11px;line-height:1.9}.tbk-about li:before{content:'✓';color:#b56b58;margin-right:8px}.tbk-trust-mini{display:flex;gap:10px;margin-top:14px}.tbk-trust-mini span{background:#fffaf3;border:1px solid #ead8c5;border-radius:5px;padding:8px 12px;font-size:9px;line-height:1.4}.tbk-faq details{border:1px solid #e5d6c6;border-radius:4px;background:#fffaf3;margin-bottom:5px}.tbk-faq summary{cursor:pointer;list-style:none;padding:8px 10px;font-size:11px}.tbk-faq summary::-webkit-details-marker{display:none}.tbk-faq summary:after{content:'+';float:right;font-size:15px}.tbk-faq p{font-size:10px;line-height:1.5;padding:0 10px 9px;margin:0}.tbk-related-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.tbk-related-card{text-align:center;aspect-ratio:2/1;position:relative}.tbk-related-card img{height:70%;object-fit:cover}.tbk-related-card b{display:block;font-family:Georgia,serif;font-size:12px;margin-top:4px}.tbk-related-card span{display:block;font-size:9px;color:#a94649;font-weight:700}.tbk-bottom-trust{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;margin-top:22px;background:#ead8c5;border:1px solid #ead8c5}.tbk-bottom-trust div{background:#fffaf3;text-align:center;padding:12px 6px}.tbk-bottom-trust b{display:block;color:#a94c4d;font-size:18px}.tbk-bottom-trust strong{display:block;font-family:Georgia,serif;font-size:11px}.tbk-bottom-trust span{display:block;font-size:9px}@media(max-width:990px){.tbk-cat-grid{grid-template-columns:repeat(3,1fr)}.tbk-product-grid{grid-template-columns:repeat(3,1fr)}.tbk-service-grid{grid-template-columns:repeat(2,1fr)}.tbk-service-grid>div:nth-child(2n){border-right:0}.tbk-info-grid{grid-template-columns:1fr}.tbk-bottom-trust{grid-template-columns:repeat(3,1fr)}}@media(max-width:640px){.tbk-bday-wrap{padding:0 12px 30px}.tbk-bday-hero img{min-height:280px;object-fit:cover}.tbk-cat-grid{grid-template-columns:repeat(2,1fr);gap:9px}.tbk-product-grid{grid-template-columns:repeat(2,1fr);gap:9px}.tbk-service-grid{grid-template-columns:1fr}.tbk-service-grid>div{border-right:0;border-bottom:1px solid #e7d3bf}.tbk-service-grid>div:last-child{border-bottom:0}.tbk-order-bar{display:block}.tbk-order-bar a{display:block;text-align:center;margin-top:10px}.tbk-info-grid{padding:15px;gap:20px}.tbk-related-grid{grid-template-columns:repeat(2,1fr)}.tbk-bottom-trust{grid-template-columns:repeat(2,1fr)}.tbk-bottom-trust div:last-child{grid-column:1/-1}.tbk-bday-title{font-size:18px}}
</style>
{% endif %}
{% schema %}
{"name":"Birthday Reference","settings":[],"presets":[{"name":"Birthday Reference"}]}
{% endschema %}