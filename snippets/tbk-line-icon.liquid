{%- comment -%}
  Thin line icons for TBK sections. Stroke-based to match the reference's
  restrained editorial treatment. Usage: {%- render 'tbk-line-icon', icon: 'star' -%}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'delivery' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="23" r="3.5"/><circle cx="24" cy="23" r="3.5"/><path d="M11.5 23h9M4 23V13a2 2 0 0 1 2-2h9v12M15 15h6l4 4v4"/></svg>
  {%- when 'cake' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 27h22M6 27v-7a3 3 0 0 1 3-3h14a3 3 0 0 1 3 3v7M9 17v-4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4M16 11V7"/><circle cx="16" cy="5.5" r="1.5"/></svg>
  {%- when 'palette' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 27c6.1 0 11-4.9 11-11S22.1 5 16 5 5 9.9 5 16c0 3 2 4 4 4h2a3 3 0 0 1 0 6c0 .6.4 1 1 1z"/><circle cx="11" cy="12.5" r="1.3"/><circle cx="16.5" cy="10" r="1.3"/><circle cx="21.5" cy="14" r="1.3"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4l10 4v8c0 6-4.2 10.6-10 12-5.8-1.4-10-6-10-12V8z"/><path d="M12 16l3 3 5-6"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4l3.6 7.6 8.4 1.2-6 6 1.4 8.4L16 24.2 8.6 27.2 10 18.8l-6-6 8.4-1.2z"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 27S4 20 4 12.5A6.5 6.5 0 0 1 16 9a6.5 6.5 0 0 1 12 3.5C28 20 16 27 16 27z"/></svg>
  {%- when 'users' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M4 26c0-4.4 3.6-8 8-8s8 3.6 8 8"/><path d="M21 8.2a4.5 4.5 0 0 1 0 8.6M23 26c0-3.2-1.2-5.6-3-7"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="16" r="12"/><path d="M16 9v7l5 3"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M26 6C14 6 7 11 7 19c0 3 1 5 1 5s10 1 14-4c3.5-4 4-14 4-14z"/><path d="M6 27c2-6 6-10 12-13"/></svg>
  {%- when 'gift' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13h22v5H5zM7 18v9h18v-9M16 13v14"/><path d="M16 13s-1-5-4.5-5a3 3 0 0 0 0 6M16 13s1-5 4.5-5a3 3 0 0 1 0 6"/></svg>
  {%- when 'flower' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="16" cy="13" r="3"/><path d="M16 10a3.5 3.5 0 1 1 3 5M16 16a3.5 3.5 0 1 0-3-5M13 15a3.5 3.5 0 1 0 3 5M19 15a3.5 3.5 0 1 1-3 5M16 21v7M16 25c-2 0-4-1-5-2"/></svg>
  {%- when 'balloon' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21c4 0 7-3.6 7-8s-3-8-7-8-7 3.6-7 8 3 8 7 8z"/><path d="M16 21l-1.5 2.5h3L16 21zM16 23.5c0 2-2 2-2 4"/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 28s9-8 9-14a9 9 0 1 0-18 0c0 6 9 14 9 14z"/><circle cx="16" cy="14" r="3.2"/></svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M16 5l2.4 6.6L25 14l-6.6 2.4L16 23l-2.4-6.6L7 14l6.6-2.4zM25 22l1 2.6L28.5 26 26 27l-1 2.5L24 27l-2.5-1 2.5-1.4z"/></svg>
{%- endcase -%}
