{% comment %}
  The Baking Kaur — LocalBusiness (Bakery) structured data
  ---------------------------------------------------------
  INSTALL: place this file in your theme's snippets/ folder,
  then add ONE line inside the <head> of layout/theme.liquid:

      {% render 'bk-local-business' %}

  It renders on every page (correct for site-wide business info).
  ⚠ Verify the geo latitude/longitude from Google Maps for your
  exact shop pin, then update the two numbers below.

  🚫 DO NOT ADD aggregateRating HERE.
  A hardcoded "4.8 / 500 reviews" was removed on 2026-07-16: it was not
  backed by any real review data, and this snippet renders in <head> on
  EVERY page, so it declared an unverifiable rating site-wide.
  Google requires aggregate ratings to come from genuine user ratings that
  are visible on the page; a hardcoded value is spammy structured markup
  and risks a manual action.
  AggregateRating may only ever be emitted from a verified review source,
  computed from real entries — never typed in. See REVIEW_STRATEGY.md.
{% endcomment %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Bakery",
  "@id": "https://thebakingkaur.com/#organization",
  "name": "The Baking Kaur",
  "description": "100% eggless premium designer cake studio in Meerut. Handcrafted celebration cakes with same-day & midnight delivery across the city.",
  "url": "https://thebakingkaur.com",
  "telephone": "+918218862928",
  "priceRange": "₹₹",
  "servesCuisine": "Eggless Cakes & Desserts",
  {%- comment -%}
    2026-07-18: previous hardcoded storefront.jpg returned HTTP 404, which
    invalidates the LocalBusiness image. Using settings.logo — a real, verified
    asset already used as the Organization logo in tbk-schema-website.liquid.
    Replace with a genuine storefront photograph when one is available.
  {%- endcomment -%}
  "image": "{{ settings.logo | image_url: width: 1200 }}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Fatah Complex, Thapar Nagar Lane 7",
    "addressLocality": "Meerut",
    "addressRegion": "Uttar Pradesh",
    "postalCode": "250001",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "28.9931",
    "longitude": "77.6939"
  },
  "areaServed": {
    "@type": "City",
    "name": "Meerut"
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "09:00",
      "closes": "23:59"
    }
  ],
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": { "@type": "Service", "name": "Midnight Cake Delivery" },
    "areaServed": "Meerut"
  },
  "sameAs": [
    "https://www.instagram.com/thebakingkaur",
    "https://www.facebook.com/thebakingkaur"
  ]
}
</script>
