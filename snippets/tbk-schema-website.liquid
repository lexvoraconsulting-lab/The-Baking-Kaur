<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://thebakingkaur.com/#website",
      "url": "https://thebakingkaur.com",
      "name": "The Baking Kaur",
      "description": "Custom cakes, wedding cakes and luxury desserts delivered in Meerut",
      "inLanguage": "en-IN",
      "publisher": {
        "@id": "https://thebakingkaur.com/#organization"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://thebakingkaur.com/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://thebakingkaur.com/#organization",
      "name": "The Baking Kaur",
      "url": "https://thebakingkaur.com",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ settings.logo | image_url: width: 600 }}",
        "width": 600,
        "height": 200
      },
      "image": "{{ settings.logo | image_url: width: 600 }}"
      {%- comment -%}
        2026-07-18: telephone, address and sameAs removed here.
        This node shares @id with the Bakery node in snippets/bk-local-business.liquid,
        so the two merge into one entity. Those properties are declared there —
        the fuller, more specific source — to keep a single authoritative copy
        and stop the two nodes from drifting apart.
      {%- endcomment -%}
    }
  ]
}
</script>
