      <div class="tbk-bottom-price">{{ cur.price | money }}</div>
      <div class="tbk-bottom-status">In stock • Fast delivery</div>
    </div>
    <div class="tbk-bottom-cta">
      <button type="submit" form="tbk-form-{{ section.id }}" class="tbk-btn tbk-btn-cart">ADD TO CART</button>
      <a href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ 'Hi! I would like to customize: ' | append: product.title | url_encode }}%20{{ shop.url | append: product.url | url_encode }}" class="tbk-btn tbk-btn-wa">WHATSAPP</a>
    </div>
  </div>
</div>

<script>
(function(){
  var root = document.getElementById('tbk-{{ section.id }}');
  if(!root) return;
  var variants = {{ p.variants | json }};
  var selects = root.querySelectorAll('[data-tbk-option]');
  var vid = document.getElementById('tbk-vid-{{ section.id }}');
  var priceEls = root.querySelectorAll('[data-tbk-price]');
  var addBtn = document.getElementById('tbk-add-{{ section.id }}');
  var addLabel = root.querySelector('[data-tbk-addlabel]');
  var addPriceEls = root.querySelectorAll('[data-tbk-addprice]');

  function money(cents){ return '₹' + (cents/100).toLocaleString('en-IN',{minimumFractionDigits:2,maximumFractionDigits:2}); }
  function chosen(){ return Array.prototype.map.call(selects, function(s){ return s.value; }); }
  function match(){
    var c = chosen();
    return variants.filter(function(v){
      for(var i=0;i<c.length;i++){ if(String(v.options[i]) !== String(c[i])) return false; }
      return true;
    })[0];
  }
  function update(){
    var v = match();
    if(!v){ if(addBtn){addBtn.disabled=true;} if(addLabel){addLabel.textContent='UNAVAILABLE';} return; }
    vid.value = v.id;
    priceEls.forEach(function(el){ el.textContent = money(v.price); });
    addPriceEls.forEach(function(el){ el.textContent = money(v.price); });
    if(addBtn){ addBtn.disabled = !v.available; }
    if(addLabel){ addLabel.textContent = v.available ? 'ADD TO CART' : 'SOLD OUT'; }
  }
  selects.forEach(function(s){ s.addEventListener('change', update); });
  update();

  var main = root.querySelector('[data-tbk-main]');
  var thumbs = root.querySelectorAll('[data-tbk-thumb]');
  var counter = root.querySelector('[data-tbk-counter]');
  var current = 0;
  var images = [{%- for img in p.images -%}{{ img | image_url: width: 1200 | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}];

  function setImage(index){
    current = (index + images.length) % images.length;
    if(main) main.src = images[current];
    if(counter) counter.textContent = (current + 1) + ' / ' + images.length;
    thumbs.forEach(function(btn,n){ btn.classList.toggle('is-active', n===current); });
  }

  thumbs.forEach(function(btn){
    btn.addEventListener('click', function(){ setImage(parseInt(btn.getAttribute('data-tbk-thumb'),10)); });
  });

  var stage = root.querySelector('[data-tbk-carousel]');
  if(stage && images.length>1){
    var startX = 0;
    stage.addEventListener('touchstart', function(e){ if(e.touches.length===1){ startX = e.touches[0].clientX; } }, {passive:true});
    stage.addEventListener('touchend', function(e){ if(e.changedTouches.length===1){ var diff = e.changedTouches[0].clientX - startX; if(Math.abs(diff) > 40){ setImage(diff < 0 ? current + 1 : current - 1); } } }, {passive:true});
  }

  var mainWrap = root.querySelector('.tbk-gallery-stage');
  if(mainWrap){
    mainWrap.addEventListener('click', function(){ window.open(images[current], '_blank'); });
  }

  var pincodeInput = root.querySelector('#tbk-pincode-{{ section.id }}');
  var pincodeResult = root.querySelector('#tbk-pincode-result-{{ section.id }}');
  var pincodeButton = root.querySelector('#tbk-pincode-btn-{{ section.id }}');

  function updatePincodeResult(){
    if(!pincodeInput || !pincodeResult) return;
    var value = pincodeInput.value.trim();
    if(/^\d{6}$/.test(value)){
      pincodeResult.innerHTML = '<strong>Delivery available!</strong> We can deliver this cake to PIN ' + value + ' within 2–4 hours.';
    } else if(value.length > 0){
      pincodeResult.innerHTML = '<strong>Invalid PIN code.</strong> Please enter a 6-digit code.';
    } else {
      pincodeResult.innerHTML = 'Enter your PIN code to check delivery availability.';
    }
  }

  if(pincodeButton){
    pincodeButton.addEventListener('click', function(e){
      e.preventDefault();
      updatePincodeResult();
    });
  }

  if(pincodeInput){
    pincodeInput.addEventListener('input', function(){
      if(this.value.length === 6){
        updatePincodeResult();
      }
    });
  }
})();
</script>

</div>

{% schema %}
{
  "name": "TBK Product",
  "settings": [
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (with country code, no +)", "default": "919999999999" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8" },
    { "type": "text", "id": "reviews_label", "label": "Reviews label (trust strip)", "default": "500+ Reviews" },
    { "type": "text", "id": "customers_label", "label": "Rating label (top)", "default": "500+ Happy Customers" },
    { "type": "checkbox", "id": "show_bestseller", "label": "Show BESTSELLER badge", "default": true },
    { "type": "text", "id": "city", "label": "Delivery city", "default": "Meerut" },
    { "type": "text", "id": "serves_weight", "label": "Serves weight", "default": "1 Kg" },
    { "type": "text", "id": "serves_people", "label": "Serves people", "default": "8–10 People" },
    { "type": "textarea", "id": "about_text", "label": "About text", "default": "Premium eggless cake crafted with fresh ingredients and luxurious presentation. Perfect for birthdays, anniversaries and all special celebrations." },
    { "type": "url", "id": "about_link", "label": "View ingredients link" },
    { "type": "collection", "id": "related_collection", "label": "You May Also Like collection" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "q", "label": "Question", "default": "Are your products 100% eggless?" },
        { "type": "textarea", "id": "a", "label": "Answer", "default": "Yes — every cake we bake is 100% eggless, with no compromise on taste or texture." }
      ]
    }
  ],
  "presets": [ { "name": "TBK Product" } ]
}
{% endschema %}
