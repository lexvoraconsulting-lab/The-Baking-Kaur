<section class="tbk-info">
  <div class="tbk-info-grid">
    <div class="tbk-about-card">
      <div class="tbk-about-title">About This Cake</div>
      <p class="tbk-about-copy">{{ section.settings.about_text }}</p>
      <ul class="tbk-about-list">
