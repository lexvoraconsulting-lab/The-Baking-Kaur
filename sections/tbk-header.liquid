             aria-label="{{ 'sections.cart.title' | t | default: 'Cart' }}">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 7H5a1 1 0 00-1 1v11a1 1 0 001 1h14a1 1 0 001-1V8a1 1 0 00-1-1z"/>
              <path d="M16 7V5a4 4 0 00-8 0v2"/>
            </svg>
            <span class="tbk-hdr-badge"
                  id="tbk-cart-count-{{ sid }}"
                  data-count="{{ cart.item_count }}"
                  aria-hidden="true">{{- cart.item_count -}}</span>
          </a>

        </div>
      </div>

      {%- comment -%} ── MOBILE SEARCH ROW ── {%- endcomment -%}
      {%- if s.show_search -%}
        <div class="tbk-hdr-mob-search" id="tbk-smob-{{ sid }}">
          <form action="{{ routes.search_url }}" method="get" role="search" autocomplete="off">
            <input type="hidden" name="type" value="product">
            <div class="tbk-search-field">
              <svg class="s-ico" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7"/>
                <path d="m21 21-4.35-4.35"/>
              </svg>
              <input class="tbk-search-input"
                     id="tbk-search-input-mob-{{ sid }}"
                     type="search"
                     name="q"
                     placeholder="{{ s.search_placeholder | default: 'Find your perfect cake…' }}"
                     autocomplete="off"
                     autocorrect="off"
                     spellcheck="false"
                     aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
                     aria-haspopup="listbox"
                     aria-expanded="false"
                     aria-controls="tbk-predict-mob-{{ sid }}"
                     role="combobox">
              <button type="submit"
                      class="tbk-search-submit"
                      aria-label="{{ 'general.search.search' | t | default: 'Search' }}">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </button>
            </div>
            <div class="tbk-search-drop"
                 id="tbk-predict-mob-{{ sid }}"
                 role="listbox"
                 aria-label="Search suggestions">
            </div>
          </form>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

