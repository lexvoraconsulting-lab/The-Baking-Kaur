{%- comment -%}
  sections/tbk-header.liquid
  The Baking Kaur — Design System Header v4
  Desktop: [Burger | Logo] [     Search     ] [Wishlist | Account | Cart]
  Mobile:  [Burger | Logo | Wishlist | Account | Cart] + [Full-width search row]
{%- endcomment -%}

{%- assign s      = section.settings -%}
{%- assign sid    = section.id -%}
{%- assign nav    = linklists[s.main_menu] -%}
{%- assign logo2x = s.logo_width | times: 2 -%}

{%- comment -%}
  Mobile search row: border(1) + pt(10) + field(48) + pb(12) = 71 px → reserve 72
{%- endcomment -%}
{%- assign search_row_h = 72 -%}

{%- style -%}
  :root {
    --tbk-hdr-h:    {{ s.header_height }}px;
    --tbk-hdr-h-mb: {{ s.mobile_header_height }}px;
    --tbk-srch-row: {{ search_row_h }}px;
  }
  @media (max-width: 1023px) {
    /* TBK — shorter mobile header: override the row + search-row reserve so
       the fixed-header spacer doesn't keep pushing content down. */
    :root{
      --tbk-hdr-h-mb: 50px;
      --tbk-srch-row: 54px;
    }
    #tbk-spacer-{{ sid }} {
      height: calc(var(--tbk-hdr-h-mb) + var(--tbk-srch-row)) !important;
    }
  }
{%- endstyle -%}

{%- render 'tbk-tokens' -%}

<style>
  /* ── Merchant-customisable overrides (from schema settings) ── */
  #tbk-hdr-{{ sid }} {
  --c-bg: var(--tbk-surface);
  --c-fg: var(--tbk-ink);
  --c-border: var(--tbk-border);
  font-family: var(--tbk-font-ui);
}

  /* ── Scoped reset ── */
  #tbk-hdr-{{ sid }} *, #tbk-drawer-{{ sid }} * { box-sizing: border-box; }
  #tbk-hdr-{{ sid }} a { color: inherit; text-decoration: none; }
  #tbk-hdr-{{ sid }} button,
  #tbk-drawer-{{ sid }} button {
    font: inherit; cursor: pointer;
    border: 0; background: none; padding: 0; color: inherit;
  }
  #tbk-hdr-{{ sid }} ul, #tbk-hdr-{{ sid }} li,
  #tbk-drawer-{{ sid }} ul, #tbk-drawer-{{ sid }} li {
    list-style: none; margin: 0; padding: 0;
  }
  #tbk-hdr-{{ sid }} svg, #tbk-drawer-{{ sid }} svg { display: block; }
  #tbk-hdr-{{ sid }} img, #tbk-drawer-{{ sid }} img { display: block; }

  /* ── Spacer — holds document flow before JS runs ── */
  .tbk-hdr-spacer { display: block; width: 100%; }

  /* ══ STICKY WRAPPER ══════════════════════════════════════════ */
  .tbk-hdr-sticky-always .tbk-hdr-fixed,
  .tbk-hdr-sticky-scroll_up .tbk-hdr-fixed {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: var(--tbk-z-hdr);
    will-change: transform;
    transition:
      transform   0.30s var(--tbk-ease),
      box-shadow  0.28s var(--tbk-ease);
  }
  #tbk-hdr-{{ sid }}.tbk-hdr-scrolled .tbk-hdr-fixed {
   box-shadow:
0 4px 20px rgba(35,25,15,.08);
  }
  .tbk-hdr-sticky-scroll_up.tbk-hdr-hidden .tbk-hdr-fixed {
    transform: translateY(-100%);
    box-shadow: none !important;
  }

  /* ══ BAR SHELL ═══════════════════════════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-hdr-bar {
    background: var(--tbk-surface);
   border-bottom:1px solid rgba(25,25,25,.06);
    color: var(--c-fg);
    width: 100%;
  }

  /* ══ INNER CONTAINER ═════════════════════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-hdr-inner {
    max-width: {{ s.container_width }}px;
    margin: 0 auto;
    padding:0 48px;
    height: var(--tbk-hdr-h);
    display: flex;
    align-items: center;
   gap:40px;
  }
  @media (max-width: 1023px) {
    #tbk-hdr-{{ sid }} .tbk-hdr-inner {
      height: var(--tbk-hdr-h-mb);
      padding: 0 var(--tbk-sp-4);
      gap: var(--tbk-sp-3);
    }
  }

  /* ══ UNIVERSAL ICON BUTTON ═══════════════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-btn-icon {
    width:  var(--tbk-touch);
    height: var(--tbk-touch);
    border-radius: var(--tbk-r-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    position: relative;
    color: var(--c-fg);
    transition:
      color       var(--tbk-dur-fast) var(--tbk-ease),
      background  var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-hdr-{{ sid }} .tbk-btn-icon:hover {
    color: var(--tbk-pink);
    background: var(--tbk-tint-1);
  }
  #tbk-hdr-{{ sid }} .tbk-btn-icon svg {
    width:  var(--tbk-icon-base);
    height: var(--tbk-icon-base);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
  }

  /* ══ LEFT: BURGER + LOGO ═════════════════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-hdr-left {
    display: flex;
    align-items: center;
    gap: var(--tbk-sp-3);
    flex: 0 0 auto;
  }
  @media (max-width: 1023px) {
    #tbk-hdr-{{ sid }} .tbk-hdr-left { gap: var(--tbk-sp-2); }
  }

  /* Burger */
  #tbk-hdr-{{ sid }} .tbk-hdr-burger { border-radius: var(--tbk-r-sm); }
  #tbk-hdr-{{ sid }} .tbk-hdr-burger svg {
    width: 20px; height: 14px;
    stroke-width: 2;
  }

  /* Logo */
 #tbk-hdr-{{ sid }} .tbk-hdr-logo {
      display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    flex: 0 0 auto;
    transition: opacity var(--tbk-dur-fast) var(--tbk-ease);
}
}
  #tbk-hdr-{{ sid }} .tbk-hdr-logo:hover { opacity: 0.84; }

  #tbk-hdr-{{ sid }} .tbk-hdr-logo img {
    width: {{ s.logo_width }}px;
    height: auto;
    object-fit: contain;
  }
  #tbk-hdr-{{ sid }} .tbk-hdr-logo-text{
    display:flex;
    flex-direction:column;
    justify-content:center;
}
  @media (max-width: 1023px) {
    #tbk-hdr-{{ sid }} .tbk-hdr-logo img { #tbk-hdr-{{ sid }} .tbk-hdr-logo-text{
    display:flex;
    flex-direction:column;
    justify-content:center;
    line-height:1;
}}
  }

  #tbk-hdr-{{ sid }} #tbk-hdr-{{ sid }} .tbk-hdr-logo-name{
    font-family: var(--tbk-font-display);
    font-weight: 400;
    font-size: 44px;
    color: #C81E63;
    line-height: .92;
    letter-spacing: .2px;
    white-space: nowrap;
}

  #tbk-hdr-{{ sid }} #tbk-hdr-{{ sid }} .tbk-hdr-logo-tag{
    font-family: var(--tbk-font-ui);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: #7A6D66;
    margin-top: 3px;
    white-space: nowrap;
}
 @media (max-width:1023px){

    #tbk-hdr-{{ sid }} .tbk-hdr-logo{
        display:none;
    }

    #tbk-hdr-{{ sid }} .tbk-hdr-logo-text{
        display:none;
    }

} {
    #tbk-hdr-{{ sid }} .tbk-hdr-logo-tag { display: none; }
  }

  /* ══ CENTER: SEARCH (desktop only) ══════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-hdr-center {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 720px;
    position: relative;
    display: flex;
    align-items: center;
  }
  @media (max-width: 1023px) {
    #tbk-hdr-{{ sid }} .tbk-hdr-center { display: none; }
  }

  /* ── Search wrap ── */
  #tbk-hdr-{{ sid }} .tbk-search-wrap { position: relative; width: 100%; }

  /* ── Search pill ── */
  #tbk-hdr-{{ sid }} .tbk-search-field {
    display: flex;
    align-items: center;
    height: var(--tbk-search-h);
    background: var(--tbk-surface-el);
    border: 1.5px solid var(--tbk-border-subtle);
    border-radius: var(--tbk-r-full);
    padding: 0 var(--tbk-sp-2) 0 var(--tbk-sp-5);
    gap: var(--tbk-sp-3);
    cursor: text;
    transition:
      border-color  var(--tbk-dur-base) var(--tbk-ease),
      box-shadow    var(--tbk-dur-base) var(--tbk-ease),
      background    var(--tbk-dur-base) var(--tbk-ease);
  }
  #tbk-hdr-{{ sid }} .tbk-search-field:hover {
    border-color: var(--tbk-border);
    background: var(--tbk-surface-el);
  }
  #tbk-hdr-{{ sid }} .tbk-search-field:focus-within {
    border-color: var(--tbk-pink);
    background: var(--tbk-surface-el);
   box-shadow:
0 0 0 4px rgba(192,20,87,.08);
  }

  /* Glass icon (left inside pill) */
  #tbk-hdr-{{ sid }} .tbk-search-field .s-ico {
    width: var(--tbk-icon-base);
    height: var(--tbk-icon-base);
    flex: 0 0 auto;
    fill: none;
    stroke: var(--tbk-muted-light);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    pointer-events: none;
    transition: stroke var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-hdr-{{ sid }} .tbk-search-field:focus-within .s-ico { stroke: var(--tbk-pink); }

  /* Input */
  #tbk-hdr-{{ sid }} .tbk-search-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-family: var(--tbk-font-ui);
    font-size: var(--tbk-text-base);
    font-weight: 400;
    color: var(--tbk-ink);
    min-width: 0;
    letter-spacing: 0.15px;
  }
  #tbk-hdr-{{ sid }} .tbk-search-input::placeholder {
    color: var(--tbk-muted-light);
    font-weight: 400;
  }

  /* Submit (right inside pill) */
  #tbk-hdr-{{ sid }} .tbk-search-submit {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--tbk-pink);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background  var(--tbk-dur-fast) var(--tbk-ease),
      transform   var(--tbk-dur-fast) var(--tbk-ease-spring);
  }
  #tbk-hdr-{{ sid }} .tbk-search-submit:hover {
    background: var(--tbk-pink-mid);
    transform: scale(1.08);
  }
  #tbk-hdr-{{ sid }} .tbk-search-submit:active { transform: scale(0.94); }
  #tbk-hdr-{{ sid }} .tbk-search-submit svg {
    width: 15px; height: 15px;
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ══ PREDICTIVE DROPDOWN ═════════════════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-search-drop {
    position: absolute;
    top: calc(100% + 10px);
    left: 0; right: 0;
    background: var(--tbk-surface-el);
    border-radius: var(--tbk-r-xl);
    border: 1px solid var(--tbk-border);
    box-shadow:0 4px 20px rgba(0,0,0,.06);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity    var(--tbk-dur-base) var(--tbk-ease),
      transform  var(--tbk-dur-base) var(--tbk-ease),
      visibility var(--tbk-dur-base);
    z-index: 300;
  }
  #tbk-hdr-{{ sid }} .tbk-search-drop.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  #tbk-hdr-{{ sid }} .tbk-drop-list { padding: var(--tbk-sp-2); }

  #tbk-hdr-{{ sid }} .tbk-drop-item {
    display: flex;
    align-items: center;
    gap: var(--tbk-sp-3);
    padding: 10px var(--tbk-sp-3);
    border-radius: var(--tbk-r-md);
    text-decoration: none;
    color: var(--tbk-ink);
    transition: background var(--tbk-dur-fast) var(--tbk-ease);
    cursor: pointer;
  }
  #tbk-hdr-{{ sid }} .tbk-drop-item:hover { background: var(--tbk-tint-1); }

  #tbk-hdr-{{ sid }} .tbk-drop-thumb {
    width: 52px; height: 52px;
    border-radius: var(--tbk-r-md);
    object-fit: cover;
    flex: 0 0 auto;
    background: var(--tbk-tint-1);
  }
  #tbk-hdr-{{ sid }} .tbk-drop-thumb-ph {
    width: 52px; height: 52px;
    border-radius: var(--tbk-r-md);
    background: var(--tbk-tint-1);
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--tbk-border-strong);
  }
  #tbk-hdr-{{ sid }} .tbk-drop-thumb-ph svg {
    width: 22px; height: 22px;
    fill: currentColor; stroke: none;
  }

  #tbk-hdr-{{ sid }} .tbk-drop-info { flex: 1; min-width: 0; }
  #tbk-hdr-{{ sid }} .tbk-drop-name {
    font-size: var(--tbk-text-sm);
    font-weight: 600;
    color: var(--tbk-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.3;
  }
  #tbk-hdr-{{ sid }} .tbk-drop-price {
    font-size: 12px;
    font-weight: 700;
    color: var(--tbk-gold);
    margin-top: 3px;
    letter-spacing: 0.2px;
  }

  #tbk-hdr-{{ sid }} .tbk-drop-footer {
    display: flex;
    align-items: center;
    gap: var(--tbk-sp-2);
    padding: var(--tbk-sp-3) var(--tbk-sp-5);
    border-top: 1px solid var(--tbk-border);
    font-size: 13px;
    font-weight: 600;
    color: var(--tbk-pink);
    text-decoration: none;
    transition: background var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-hdr-{{ sid }} .tbk-drop-footer:hover { background: var(--tbk-tint-1); }
  #tbk-hdr-{{ sid }} .tbk-drop-footer svg {
    width: 13px; height: 13px;
    fill: none; stroke: currentColor;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
  }
  #tbk-hdr-{{ sid }} .tbk-drop-empty {
    padding: 20px var(--tbk-sp-5);
    font-size: var(--tbk-text-sm);
    color: var(--tbk-muted);
    text-align: center;
  }

  /* ══ RIGHT: ICON CLUSTER ═════════════════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-hdr-right {
    display: flex;
    align-items: center;
    gap: var(--tbk-sp-2);
    flex: 0 0 auto;
    margin-left: auto;
  }
  @media (max-width: 1023px) {
    #tbk-hdr-{{ sid }} .tbk-hdr-right { gap: var(--tbk-sp-1); }
  }

  /* Cart badge */
  #tbk-hdr-{{ sid }} .tbk-hdr-badge {
    position: absolute;
    top: 4px; right: 2px;
    min-width: 16px; height: 16px;
    border-radius: 8px;
    padding: 0 3.5px;
    background: var(--tbk-pink);
    color: #fff;
    font-size: 9px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    pointer-events: none;
    border: 1.5px solid var(--c-bg);
    transition: transform 0.24s var(--tbk-ease-spring);
  }
  #tbk-hdr-{{ sid }} .tbk-hdr-badge[data-count="0"] { transform: scale(0); }

  /* ══ MOBILE SEARCH ROW ═══════════════════════════════════════ */
  #tbk-hdr-{{ sid }} .tbk-hdr-mob-search {
    display: none;
   border:1px solid var(--tbk-border);
    border-top: 1px solid var(--c-border);
    padding: 10px var(--tbk-sp-4) 12px;
  }
  #tbk-hdr-{{ sid }} .tbk-hdr-mob-search form { position: relative; }
  @media (max-width: 1023px) {
    #tbk-hdr-{{ sid }} .tbk-hdr-mob-search { display: block; padding: 6px var(--tbk-sp-4); }
    #tbk-hdr-{{ sid }} .tbk-hdr-mob-search .tbk-search-field {
      height: 40px;
    }
  }

  /* ══ DRAWER ══════════════════════════════════════════════════ */
  #tbk-drawer-{{ sid }} {
    position: fixed;
    inset: 0;
    z-index: var(--tbk-z-drawer);
    pointer-events: none;
  }
  #tbk-drawer-{{ sid }}.is-open { pointer-events: auto; }

  /* Overlay */
  #tbk-drawer-{{ sid }} .tbk-drawer-ov {
    position: absolute;
    inset: 0;
    background: rgba(26, 8, 16, 0.62);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity var(--tbk-dur-drawer) var(--tbk-ease);
  }
  #tbk-drawer-{{ sid }}.is-open .tbk-drawer-ov { opacity: 1; }

  /* Panel */
  #tbk-drawer-{{ sid }} .tbk-drawer-panel {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(340px, 90vw);
    background: var(--tbk-surface);
    transform: translateX(-100%);
    transition: transform var(--tbk-dur-drawer) var(--tbk-ease);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: var(--tbk-shadow-lg);
  }
  #tbk-drawer-{{ sid }}.is-open .tbk-drawer-panel { transform: translateX(0); }

  /* Drawer head */
  #tbk-drawer-{{ sid }} .tbk-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--tbk-sp-5) var(--tbk-sp-5) var(--tbk-sp-4);
    border-bottom: 1px solid var(--tbk-border);
    flex: 0 0 auto;
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-brand {
    display: flex;
    align-items: center;
    gap: var(--tbk-sp-3);
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-brand img {
    width: 44px; height: 44px;
    border-radius: 50%;
    object-fit: contain;
    flex: 0 0 auto;
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-brand .nm {
    font-family: var(--tbk-font-display);
    font-weight: 800;
    font-size: 15px;
    color: var(--tbk-pink);
    line-height: 1.2;
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-brand .tg {
    font-family: var(--tbk-font-ui);
    font-size: var(--tbk-text-2xs);
    letter-spacing: 2.2px;
    text-transform: uppercase;
    color: var(--tbk-muted);
    margin-top: 2px;
    line-height: 1;
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-close {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--tbk-tint-1);
    display: flex; align-items: center; justify-content: center;
    color: var(--tbk-pink);
    flex: 0 0 auto;
    transition: background var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-close:hover { background: var(--tbk-tint-2); }
  #tbk-drawer-{{ sid }} .tbk-drawer-close svg {
    width: 11px; height: 11px;
    fill: currentColor; stroke: none;
  }

  /* Nav */
  #tbk-drawer-{{ sid }} .tbk-drawer-nav { flex: 1 1 auto; padding: var(--tbk-sp-2) 0; }
  #tbk-drawer-{{ sid }} .tbk-mob-item { border-bottom: 1px solid rgba(237,216,227,0.5); }

  #tbk-drawer-{{ sid }} .tbk-mob-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px var(--tbk-sp-5);
    font-size: var(--tbk-text-base);
    font-weight: 600;
    color: var(--tbk-ink);
    text-decoration: none;
    cursor: pointer;
    transition:
      color       var(--tbk-dur-fast) var(--tbk-ease),
      background  var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-drawer-{{ sid }} .tbk-mob-link:hover {
    color: var(--tbk-pink);
    background: var(--tbk-tint-1);
  }
  #tbk-drawer-{{ sid }} details[open] > .tbk-mob-link { color: var(--tbk-pink); }
  #tbk-drawer-{{ sid }} details[open] > .tbk-mob-link svg { transform: rotate(180deg); }
  #tbk-drawer-{{ sid }} .tbk-mob-link svg {
    width: 14px; height: 14px;
    fill: none; stroke: currentColor;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    transition: transform var(--tbk-dur-base) var(--tbk-ease);
    flex: 0 0 auto;
  }

  #tbk-drawer-{{ sid }} .tbk-mob-sub { background: var(--tbk-tint-1); padding: 4px 0; }
  #tbk-drawer-{{ sid }} .tbk-mob-sub a {
    display: block;
    padding: 12px var(--tbk-sp-5) 12px 38px;
    font-size: 13px;
    font-weight: 500;
    color: var(--tbk-ink-soft);
    text-decoration: none;
    transition:
      color       var(--tbk-dur-fast) var(--tbk-ease),
      background  var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-drawer-{{ sid }} .tbk-mob-sub a:hover { color: var(--tbk-pink); background: var(--tbk-tint-2); }

  /* Footer */
  #tbk-drawer-{{ sid }} .tbk-drawer-foot {
    flex: 0 0 auto;
    padding: var(--tbk-sp-5);
    border-top: 1px solid var(--tbk-border);
    display: flex;
    flex-direction: column;
    gap: var(--tbk-sp-3);
  }
  #tbk-drawer-{{ sid }} .tbk-foot-row {
    display: flex;
    align-items: center;
    gap: var(--tbk-sp-3);
    font-size: var(--tbk-text-sm);
    font-weight: 500;
    color: var(--tbk-muted);
  }
  #tbk-drawer-{{ sid }} .tbk-foot-row svg {
    width: var(--tbk-icon-xs); height: var(--tbk-icon-xs);
    fill: none; stroke: currentColor;
    stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
    flex: 0 0 auto;
  }
  #tbk-drawer-{{ sid }} .tbk-foot-row a {
    color: var(--tbk-ink-soft);
    text-decoration: none;
    transition: color var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-drawer-{{ sid }} .tbk-foot-row a:hover { color: var(--tbk-pink); }

  #tbk-drawer-{{ sid }} .tbk-drawer-socials {
    display: flex;
    gap: var(--tbk-sp-2);
    margin-top: var(--tbk-sp-1);
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-socials a {
    width: var(--tbk-touch); height: var(--tbk-touch);
    border-radius: var(--tbk-r-md);
    background: var(--tbk-tint-1);
    display: flex; align-items: center; justify-content: center;
    color: var(--tbk-pink);
    text-decoration: none;
    transition: background var(--tbk-dur-fast) var(--tbk-ease);
  }
  #tbk-drawer-{{ sid }} .tbk-drawer-socials a:hover { background: var(--tbk-tint-2); }
  #tbk-drawer-{{ sid }} .tbk-drawer-socials svg {
    width: 18px; height: 18px;
    fill: currentColor; stroke: none;
  }

  /* ══ ACCESSIBILITY ═══════════════════════════════════════════ */
  #tbk-hdr-{{ sid }} :focus-visible,
  #tbk-drawer-{{ sid }} :focus-visible {
    outline: 2px solid var(--tbk-pink);
    outline-offset: 3px;
    border-radius: var(--tbk-r-sm);
  }
</style>

{%- comment -%} CLS spacer — height = header + search row (on mobile) {%- endcomment -%}
{%- if s.sticky_type != 'none' -%}
  <div class="tbk-hdr-spacer"
       id="tbk-spacer-{{ sid }}"
       aria-hidden="true"
       style="height: {{ s.header_height }}px"></div>
{%- endif -%}

<div id="tbk-hdr-{{ sid }}" class="tbk-hdr-sticky-{{ s.sticky_type }}">
  <div class="tbk-hdr-fixed" role="banner">
    <div class="tbk-hdr-bar">

      {%- comment -%} ── MAIN ROW ── {%- endcomment -%}
      <div class="tbk-hdr-inner">

        {%- comment -%} LEFT: burger + logo {%- endcomment -%}
        <div class="tbk-hdr-left">

          <button class="tbk-btn-icon tbk-hdr-burger"
                  aria-controls="tbk-drawer-{{ sid }}"
                  aria-expanded="false"
                  aria-label="{{ 'general.accessibility.nav_menu' | t | default: 'Open menu' }}">
            <svg viewBox="0 0 20 14" fill="none" aria-hidden="true">
              <line x1="0" y1="1"  x2="20" y2="1"/>
              <line x1="0" y1="7"  x2="20" y2="7"/>
              <line x1="0" y1="13" x2="20" y2="13"/>
            </svg>
          </button>

      <a href="{{ routes.root_url }}"
   class="tbk-hdr-logo"
   aria-label="{{ shop.name }}">

  {% if s.logo %}
    <img
      src="{{ s.logo | image_url: width: logo2x }}"
      width="{{ s.logo_width }}"
      height="auto"
      alt="{{ shop.name }}"
      loading="eager"
      fetchpriority="high">
  {% endif %}

  <div class="tbk-hdr-logo-text">

      <div class="tbk-hdr-logo-name">
          {{ s.logo_text | default: shop.name }}
      </div>

      {% if s.logo_tagline != blank %}
          <div class="tbk-hdr-logo-tag">
              {{ s.logo_tagline }}
          </div>
      {% endif %}

  </div>

</a>

        </div>

        {%- comment -%} CENTER: inline search (desktop) {%- endcomment -%}
        {%- if s.show_search -%}
          <div class="tbk-hdr-center">
            <div class="tbk-search-wrap" id="tbk-sdsk-{{ sid }}">
              <form action="{{ routes.search_url }}" method="get" role="search" autocomplete="off">
                <input type="hidden" name="type" value="product">
                <div class="tbk-search-field">
                  <svg class="s-ico" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <path d="m21 21-4.35-4.35"/>
                  </svg>
                  <input class="tbk-search-input"
                         id="tbk-search-input-desk-{{ sid }}"
                         type="search"
                         name="q"
                         placeholder="{{ s.search_placeholder | default: 'Find your perfect cake…' }}"
                         autocomplete="off"
                         autocorrect="off"
                         spellcheck="false"
                         aria-label="{{ 'general.search.search' | t | default: 'Search' }}"
                         aria-haspopup="listbox"
                         aria-expanded="false"
                         aria-controls="tbk-predict-desk-{{ sid }}"
                         role="combobox">
                  <button type="submit"
                          class="tbk-search-submit"
                          aria-label="{{ 'general.search.search' | t | default: 'Search' }}">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6"/>
                    </svg>
                  </button>
                </div>
              </form>
              <div class="tbk-search-drop"
                   id="tbk-predict-desk-{{ sid }}"
                   role="listbox"
                   aria-label="Search suggestions">
              </div>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} RIGHT: icon cluster {%- endcomment -%}
        <div class="tbk-hdr-right">

          {%- if s.show_wishlist -%}
            <a href="{{ routes.root_url }}pages/wishlist"
               class="tbk-btn-icon"
               aria-label="{{ 'general.wishlist.wishlist_text' | t | default: 'Wishlist' }}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if s.show_account -%}
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
               class="tbk-btn-icon"
               aria-label="{% if customer %}{{ 'customer.account.title' | t | default: 'Account' }}{% else %}{{ 'customer.account.login' | t | default: 'Sign in' }}{% endif %}">
              <svg viewBox="0 0 24 24" aria-hidden="true">
