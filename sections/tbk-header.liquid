</div>

<script>
(function () {
  'use strict';

  var ROOT   = document.getElementById('tbk-hdr-{{ sid }}');
  var SPACER = document.getElementById('tbk-spacer-{{ sid }}');
  var DRAWER = document.getElementById('tbk-drawer-{{ sid }}');
  var CARTCT = document.getElementById('tbk-cart-count-{{ sid }}');
  if (!ROOT) return;

  var fixed      = ROOT.querySelector('.tbk-hdr-fixed');
  var BURGER     = ROOT.querySelector('.tbk-hdr-burger');
  var stickyType = '{{ s.sticky_type }}';

  /* ── Sticky + scroll-up behaviour ──────────────────────── */
  if (stickyType === 'always' || stickyType === 'scroll_up') {

    var annEl = document.querySelector('.tbk-ann-section');

    function annBottom() {
      return annEl ? Math.max(0, annEl.getBoundingClientRect().bottom) : 0;
    }

    function syncSpacer() {
      if (SPACER) SPACER.style.height = (fixed.offsetHeight + annBottom()) + 'px';
    }
    syncSpacer();
    window.addEventListener('resize', syncSpacer, { passive: true });

    fixed.style.top = annBottom() + 'px';

    if (stickyType === 'scroll_up') {
      var lastY = 0, ticking = false;

      function onFrame() {
        var y    = window.scrollY;
        var annH = annBottom();

        fixed.style.top = annH + 'px';

        if (annH === 0) {
          ROOT.classList.toggle('tbk-hdr-hidden', y > lastY && y > fixed.offsetHeight + 10);
        } else {
          ROOT.classList.remove('tbk-hdr-hidden');
        }

        lastY   = Math.max(0, y);
        ticking = false;
      }

      window.addEventListener('scroll', function () {
        if (!ticking) { requestAnimationFrame(onFrame); ticking = true; }
      }, { passive: true });

    } else {
      var annT = false;
      window.addEventListener('scroll', function () {
        if (!annT) {
          requestAnimationFrame(function () { fixed.style.top = annBottom() + 'px'; annT = false; });
          annT = true;
        }
      }, { passive: true });
    }
  }

  /* ── Scrolled-shadow class ──────────────────────────────── */
  function updateScrolled() {
    ROOT.classList.toggle('tbk-hdr-scrolled', window.scrollY > 32);
  }
  window.addEventListener('scroll', updateScrolled, { passive: true });
  updateScrolled();

  /* ── Drawer ─────────────────────────────────────────────── */
  function openDrawer() {
    DRAWER.classList.add('is-open');
    DRAWER.setAttribute('aria-hidden', 'false');
    if (BURGER) BURGER.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
    var first = DRAWER.querySelector('a, button, [tabindex="0"]');
    if (first) setTimeout(function () { first.focus(); }, 50);
  }
  function closeDrawer() {
    DRAWER.classList.remove('is-open');
    DRAWER.setAttribute('aria-hidden', 'true');
    if (BURGER) { BURGER.setAttribute('aria-expanded', 'false'); BURGER.focus(); }
    document.documentElement.style.overflow = '';
  }

  if (BURGER) BURGER.addEventListener('click', openDrawer);
  DRAWER.querySelectorAll('[data-tbk-close]').forEach(function (el) {
    el.addEventListener('click', closeDrawer);
  });
  DRAWER.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeDrawer(); return; }
    if (e.key !== 'Tab') return;
    var focusable = Array.from(
      DRAWER.querySelectorAll('a, button:not([disabled]), input, [tabindex="0"]')
    ).filter(function (el) { return el.offsetParent !== null; });
    if (!focusable.length) return;
    var first = focusable[0], last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first)      { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  /* ── Predictive Search ──────────────────────────────────── */
  function initSearch(inputEl, dropEl) {
    if (!inputEl || !dropEl) return;

    var debounceTimer = null;
    var lastQuery     = '';

    function rupees(cents) {
      return '₹' + (cents / 100).toLocaleString('en-IN', {
        minimumFractionDigits: 0, maximumFractionDigits: 0
      });
    }

    function openDrop()  { dropEl.classList.add('is-open');    inputEl.setAttribute('aria-expanded', 'true'); }
    function closeDrop() { dropEl.classList.remove('is-open'); inputEl.setAttribute('aria-expanded', 'false'); }

    function esc(str) {
      return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function renderResults(data) {
      var products = (data.resources && data.resources.results && data.resources.results.products) || [];
      var html = '';

      if (products.length) {
        html += '<div class="tbk-drop-list" role="group">';
        products.slice(0, 5).forEach(function (p) {
          var thumb = p.featured_image
            ? '<img class="tbk-drop-thumb" src="' + p.featured_image.url + '" alt="" loading="lazy" width="52" height="52">'
            : '<span class="tbk-drop-thumb-ph" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M19 7H5c-.6 0-1 .4-1 1v11c0 .6.4 1 1 1h14c.6 0 1-.4 1-1V8c0-.6-.4-1-1-1z"/><path d="M16 7V5a4 4 0 00-8 0v2"/></svg></span>';
          var price = p.price ? '<div class="tbk-drop-price">' + rupees(p.price) + '</div>' : '';
          html += '<a href="' + p.url + '" class="tbk-drop-item" role="option" tabindex="-1">'
                + thumb
                + '<div class="tbk-drop-info">'
                + '<div class="tbk-drop-name">' + esc(p.title) + '</div>'
                + price
                + '</div></a>';
        });
        html += '</div>';
        html += '<a href="/search?q=' + encodeURIComponent(inputEl.value) + '&type=product" '
              + 'class="tbk-drop-footer" role="option" tabindex="-1">'
              + 'View all results for &ldquo;' + esc(inputEl.value) + '&rdquo;'
              + '<svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>'
              + '</a>';
      } else {
        html = '<p class="tbk-drop-empty">No results for &ldquo;' + esc(inputEl.value) + '&rdquo;</p>';
      }

      dropEl.innerHTML = html;
      openDrop();
    }

    function doSearch(q) {
      if (q.length < 2)   { closeDrop(); return; }
      if (q === lastQuery) { openDrop(); return; }
      lastQuery = q;

      fetch('/search/suggest.json?q=' + encodeURIComponent(q)
          + '&resources[type]=product&resources[limit]=5'
          + '&resources[fields]=title,variants.price,featured_image')
        .then(function (r) { return r.json(); })
        .then(function (d) { renderResults(d); })
        .catch(function ()  { closeDrop(); });
    }

    inputEl.addEventListener('input', function () {
      clearTimeout(debounceTimer);
      var q = inputEl.value.trim();
      if (!q) { closeDrop(); return; }
      debounceTimer = setTimeout(function () { doSearch(q); }, 200);
    });
    inputEl.addEventListener('focus', function () {
      if (inputEl.value.trim().length >= 2) openDrop();
    });

    document.addEventListener('click', function (e) {
      if (!dropEl.contains(e.target) && e.target !== inputEl) closeDrop();
    });

    inputEl.addEventListener('keydown', function (e) {
      if (!dropEl.classList.contains('is-open')) return;
      var items = Array.from(dropEl.querySelectorAll('[role="option"]'));
      if (!items.length) return;
      var idx = items.indexOf(document.activeElement);
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        (items[idx + 1] || items[0]).focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        (items[idx - 1] || items[items.length - 1]).focus();
      } else if (e.key === 'Escape') {
        closeDrop(); inputEl.focus();
      }
    });
  }

  initSearch(
    document.getElementById('tbk-search-input-desk-{{ sid }}'),
    document.getElementById('tbk-predict-desk-{{ sid }}')
  );
  initSearch(
    document.getElementById('tbk-search-input-mob-{{ sid }}'),
    document.getElementById('tbk-predict-mob-{{ sid }}')
  );

  /* ── Cart count live updates ────────────────────────────── */
  function setCount(n) {
    if (!CARTCT) return;
    CARTCT.textContent = n;
    CARTCT.dataset.count = n;
  }
  document.addEventListener('cart:updated',      function (e) { if (e.detail && e.detail.cart) setCount(e.detail.cart.item_count); });
  document.addEventListener('theme:cart:update', function (e) { if (e.detail && e.detail.cart) setCount(e.detail.cart.item_count); });

})();
</script>

