        {%- if s.logo -%}
          <img src="{{ s.logo | image_url: width: 90 }}"
               alt="{{ shop.name }}"
               width="44"
               height="44"
               loading="lazy">
        {%- endif -%}
        <div>
          <div class="nm">{{ s.logo_text | default: shop.name }}</div>
