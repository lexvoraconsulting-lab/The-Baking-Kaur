{%- comment -%}
  sections/home-occasions.liquid — Homepage §3 Occasion Navigation (Phase C1)

  ASSEMBLY ONLY — zero new components:
    • FROZEN B3 `tbkx-card` + `tbkx-card--collection` (1:1 media, display title)
      + `--link/--interactive` + `tbkx-card__media--fallback` (graceful empty state)
    • FROZEN tokens for type/spacing. Whole-card link pattern reused from S2.
  tbkx- namespaced → protected product page untouched.

  Heading hierarchy: H1 (hero) → H2 (this section) → H3 (each card).
  Schema: ItemList (occasion entities) — strengthens crawlability + AI entity relations.
  Perf: images lazy + srcset + explicit w/h + fixed 1:1 ratio → CLS 0. Zero JS.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
-%}

{%- if count > 0 -%}
<section class="tbkx-occ" aria-labelledby="tbkx-occ-h">
  <div class="tbkx-occ__inner">

    {%- if s.overline != blank -%}<p class="tbkx-occ__overline">{{ s.overline }}</p>{%- endif -%}
    <h2 class="tbkx-occ__title" id="tbkx-occ-h">{{ s.heading | default: 'Shop by occasion' }}</h2>
    {%- if s.subheading != blank -%}<p class="tbkx-occ__sub">{{ s.subheading }}</p>{%- endif -%}

    <ul class="tbkx-occ__grid" style="--tbkx-occ-cols:{{ count }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign col = b.collection
          # destination: explicit link wins, else the collection's own url
          assign href = b.link
          if href == blank and col != blank
            assign href = col.url
          endif
          # media: block image → collection image → collection's first product image
          assign media = b.image
          if media == blank and col != blank
            assign media = col.image
          endif
          if media == blank and col != blank
            assign media = col.products.first.featured_image
          endif
          # label
          assign label = b.title
          if label == blank and col != blank
            assign label = col.title
          endif
        -%}
        {%- if href != blank and label != blank -%}
        <li class="tbkx-card tbkx-card--collection tbkx-card--link tbkx-card--interactive" {{ block.shopify_attributes }}>
          <a class="tbkx-occ__link" href="{{ href }}">
            <div class="tbkx-card__media{% if media == blank %} tbkx-card__media--fallback{% endif %}">
              {%- if media != blank -%}
                <img src="{{ media | image_url: width: 600, format: 'webp' }}"
                     srcset="{{ media | image_url: width: 300, format: 'webp' }} 300w,
                             {{ media | image_url: width: 450, format: 'webp' }} 450w,
                             {{ media | image_url: width: 600, format: 'webp' }} 600w"
                     sizes="(min-width: 990px) 16vw, (min-width: 768px) 30vw, 45vw"
                     width="{{ media.width }}" height="{{ media.height }}"
                     alt="{{ b.image_alt | default: label | escape }}"
                     loading="lazy" decoding="async">
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16M5 20v-7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7M8 11V8m4 3V7m4 4V8"/></svg>
              {%- endif -%}
            </div>
            <div class="tbkx-card__body">
              <h3 class="tbkx-card__title tbkx-card__title--display">{{ label }}</h3>
              {%- if b.caption != blank -%}
                <p class="tbkx-card__text tbkx-occ__cap">{{ b.caption }}</p>
              {%- elsif col != blank and s.show_counts -%}
                <p class="tbkx-card__text tbkx-occ__cap">{{ col.all_products_count }} designs</p>
              {%- endif -%}
            </div>
          </a>
        </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

  </div>
</section>

{%- comment -%} ItemList — occasion entities for crawlability + AI entity relations {%- endcomment -%}
{%- capture occ_items -%}
  {%- assign pos = 0 -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign col = b.collection
      assign href = b.link
      if href == blank and col != blank
        assign href = col.url
      endif
      assign label = b.title
      if label == blank and col != blank
        assign label = col.title
      endif
    -%}
    {%- if href != blank and label != blank -%}
      {%- assign pos = pos | plus: 1 -%}
      {%- unless pos == 1 %},{% endunless -%}
      {"@type":"ListItem","position":{{ pos }},"name":{{ label | json }},"url":{{ shop.url | append: href | json }}}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ItemList","name":{{ s.heading | default: 'Shop by occasion' | json }},"itemListElement":[{{ occ_items | strip_newlines }}]}
</script>

<style>
  .tbkx-occ{background:var(--tbk-surface,#FDFAF8);}
  .tbkx-occ__inner{
    max-width:var(--tbk-container,1280px);margin:0 auto;
    padding:var(--tbk-section-y,clamp(56px,8vw,128px)) var(--tbk-edge,clamp(16px,5vw,80px));
  }
  .tbkx-occ__overline{
    margin:0 0 var(--tbk-sp-3,12px);
    font:var(--tbk-fw-semibold,600) var(--tbk-text-xs,11px)/1 var(--tbk-font-ui,'Manrope',sans-serif);
    letter-spacing:var(--tbk-ls-overline,.14em);text-transform:uppercase;color:var(--tbk-muted,#876575);
  }
  .tbkx-occ__title{
    margin:0;font-family:var(--tbk-font-display,'Cormorant Garamond',Georgia,serif);font-weight:600;
    font-size:var(--tbk-display-1,clamp(32px,4vw,52px));line-height:var(--tbk-lh-heading,1.2);
    letter-spacing:var(--tbk-ls-tight,-.01em);color:var(--tbk-ink,#1A0810);
  }
  .tbkx-occ__sub{
    margin:var(--tbk-sp-3,12px) 0 0;font-size:var(--tbk-text-lg,16px);line-height:var(--tbk-lh-body,1.65);
    color:var(--tbk-ink-soft,#3B1F2E);max-width:52ch;
  }

  /* Mobile-first: 2 columns */
  .tbkx-occ__grid{
    list-style:none;margin:var(--tbk-sp-8,32px) 0 0;padding:0;display:grid;
    gap:var(--tbk-sp-3,12px);grid-template-columns:repeat(2,minmax(0,1fr));
  }
  @media (min-width:768px){ .tbkx-occ__grid{gap:var(--tbk-sp-4,16px);grid-template-columns:repeat(3,minmax(0,1fr));} }
  @media (min-width:990px){ .tbkx-occ__grid{grid-template-columns:repeat(var(--tbkx-occ-cols,5),minmax(0,1fr));} }

  .tbkx-occ__link{display:flex;flex-direction:column;flex:1;text-decoration:none;color:inherit;border-radius:inherit;}
  .tbkx-occ__link:focus-visible{outline:none;box-shadow:var(--tbk-focus-ring,0 0 0 3px rgba(192,20,87,.22));border-radius:var(--tbk-r-lg,16px);}
  .tbkx-occ__grid .tbkx-card__body{padding:var(--tbk-sp-4,16px);gap:4px;}
  .tbkx-occ__grid .tbkx-card__title--display{font-size:clamp(18px,1.6vw,22px);}
  .tbkx-occ__cap{font-size:var(--tbk-text-xs,11px);color:var(--tbk-muted,#876575);}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Home · Occasions",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "Homepage §3. Assembly of the FROZEN collection card — no new components. Each card links to ONE canonical destination. Only link populated collections (never a 0-product collection)." },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Find your cake" },
    { "type": "text", "id": "heading", "label": "Section heading (H2)", "default": "Shop by occasion" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "From first birthdays to golden anniversaries — every cake handcrafted and 100% eggless." },
    { "type": "checkbox", "id": "show_counts", "label": "Show product counts (off for clean editorial)", "default": false }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection (provides link, title, image, count)" },
        { "type": "url", "id": "link", "label": "Override link (use for page destinations)" },
        { "type": "text", "id": "title", "label": "Override title" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "caption", "label": "Override caption" }
      ]
    }
  ],
  "presets": [{ "name": "Home · Occasions" }]
}
{% endschema %}
