{%- comment -%}
  sections/home-reviews.liquid — Homepage §5 Social Proof (Phase C1 · S5)

  ASSEMBLY ONLY — zero new components:
    • FROZEN B3 `tbkx-card--review` (__stars, __author, __avatar, __verified)
    • FROZEN tokens. tbkx- namespaced → protected product page untouched.

  ─────────────────────────────────────────────────────────────────────
  🚫 GENUINE DATA ONLY. This section CANNOT fabricate.
  ─────────────────────────────────────────────────────────────────────
  Source: `testimonial` metaobjects ("Verified Review"), each carrying
  author · body · rating · source · source_url (proof) · review_date ·
  verified. Entries are transcribed from an approved source with a public
  link a human can open. There is NO hardcoded review text, author, rating
  or count anywhere in this file — by construction, not by policy.

  Only `verified == true` entries render. Everything else is invisible.
  At 0 verified reviews the section renders NOTHING to customers:
  no heading, no cards, no schema. In the theme editor only, it shows
  "Waiting for verified review source." so the slot is discoverable.

  🚫 NO AggregateRating / Review schema is emitted here — deliberately.
  Google's review-snippet guidelines disallow SELF-SERVING reviews for
  LocalBusiness/Organization: ratings a business collects and marks up
  about itself are not eligible for rich results. A hardcoded 4.8/500 was
  removed from `snippets/bk-local-business.liquid` on 2026-07-16 for
  exactly this reason. Re-adding it would be wrong even with real data.
  Review/AggregateRating is permitted ONLY on Product pages, ONLY from a
  genuine product-review source. See REVIEW_STRATEGY.md §"Schema rules".

  GEO note: AI assistants read the visible text, not just schema — so real
  reviews still earn AI-search visibility with no markup at all.

  Heading hierarchy: H1 (hero) → H2 (this section) → H3 (each review).
  Perf: 0 JS · no images · CLS 0.
{%- endcomment -%}
{%- liquid
  assign s = section.settings

  # Count verified entries first — decides whether ANYTHING renders.
  assign verified_count = 0
  for entry in shop.metaobjects.testimonial.values
    if entry.verified.value == true and entry.body != blank and entry.author != blank
      assign verified_count = verified_count | plus: 1
    endif
  endfor

  assign limit = s.limit | default: 3
-%}

{%- if verified_count > 0 -%}

<section class="tbkx-rev" aria-labelledby="tbkx-rev-h">
  <div class="tbkx-rev__inner">

    {%- if s.overline != blank -%}<p class="tbkx-rev__overline">{{ s.overline }}</p>{%- endif -%}
    <h2 class="tbkx-rev__title" id="tbkx-rev-h">{{ s.heading | default: 'In their words' }}</h2>
    {%- if s.subheading != blank -%}<p class="tbkx-rev__sub">{{ s.subheading }}</p>{%- endif -%}

    <ul class="tbkx-rev__grid">
      {%- assign rendered = 0 -%}
      {%- for entry in shop.metaobjects.testimonial.values -%}
        {%- if rendered >= limit -%}{%- break -%}{%- endif -%}
        {%- if entry.verified.value == true and entry.body != blank and entry.author != blank -%}
          {%- liquid
            assign rendered = rendered | plus: 1
            assign name = entry.author.value | default: entry.author
            assign initial = name | strip | slice: 0 | upcase
            assign stars = entry.rating.value | times: 1
          -%}
          <li class="tbkx-card tbkx-card--review">
            <div class="tbkx-card__body">
              {%- if stars > 0 -%}
                <p class="tbkx-card__stars" aria-label="{{ stars }} out of 5">
                  {%- for i in (1..5) -%}{% if i <= stars %}★{% else %}☆{% endif %}{%- endfor -%}
                </p>
              {%- endif -%}

              <h3 class="tbkx-card__text tbkx-rev__quote">{{ entry.body }}</h3>

              <div class="tbkx-card__author">
                <span class="tbkx-card__avatar" aria-hidden="true">{{ initial }}</span>
                <span>
                  <span class="tbkx-rev__name">{{ name }}</span>
                  {%- if entry.source != blank -%}
                    <span class="tbkx-card__verified">
                      {%- if entry.source_url != blank -%}
                        Verified · <a class="tbkx-rev__src" href="{{ entry.source_url }}" target="_blank" rel="nofollow noopener ugc">{{ entry.source }}</a>
                      {%- else -%}
                        {{ entry.source }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                </span>
              </div>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- if s.cta_label != blank and s.cta_link != blank -%}
      <div class="tbkx-rev__cta">
        {%- render 'tbk-button', label: s.cta_label, href: s.cta_link, variant: 'secondary', size: 'md' -%}
      </div>
    {%- endif -%}

  </div>
</section>

<style>
  .tbkx-rev{background:var(--tbk-surface,#FDFAF8);}
  .tbkx-rev__inner{
    max-width:var(--tbk-container,1280px);margin:0 auto;
    padding:var(--tbk-section-y,clamp(56px,8vw,128px)) var(--tbk-edge,clamp(16px,5vw,80px));
  }
  .tbkx-rev__overline{
    margin:0 0 var(--tbk-sp-3,12px);
    font:var(--tbk-fw-semibold,600) var(--tbk-text-xs,11px)/1 var(--tbk-font-ui,'Manrope',sans-serif);
    letter-spacing:var(--tbk-ls-overline,.14em);text-transform:uppercase;color:var(--tbk-muted,#876575);
  }
  .tbkx-rev__title{
    margin:0;font-family:var(--tbk-font-display,'Cormorant Garamond',Georgia,serif);font-weight:600;
    font-size:var(--tbk-display-1,clamp(32px,4vw,52px));line-height:var(--tbk-lh-heading,1.2);
    letter-spacing:var(--tbk-ls-tight,-.01em);color:var(--tbk-ink,#1A0810);
  }
  .tbkx-rev__sub{
    margin:var(--tbk-sp-3,12px) 0 0;font-size:var(--tbk-text-lg,16px);line-height:var(--tbk-lh-body,1.65);
    color:var(--tbk-ink-soft,#3B1F2E);max-width:52ch;
  }
  .tbkx-rev__grid{
    list-style:none;margin:var(--tbk-sp-8,32px) 0 0;padding:0;display:grid;
    gap:var(--tbk-sp-4,16px);grid-template-columns:1fr;
  }
  @media (min-width:768px){ .tbkx-rev__grid{grid-template-columns:repeat(3,minmax(0,1fr));} }
  .tbkx-rev__grid .tbkx-card__body{padding:var(--tbk-sp-6,24px);}
  /* H3 carries the quote — reset heading weight so it reads as body copy */
  .tbkx-rev__quote{
    margin:0;font-family:var(--tbk-font-ui,'Manrope',sans-serif);font-weight:400;
    font-size:var(--tbk-text-lg,16px);line-height:var(--tbk-lh-body,1.65);color:var(--tbk-ink-soft,#3B1F2E);
  }
  .tbkx-rev__name{display:block;font:var(--tbk-fw-semibold,600) var(--tbk-text-sm,14px)/1.3 var(--tbk-font-ui,'Manrope',sans-serif);color:var(--tbk-ink,#1A0810);}
  .tbkx-rev__src{color:inherit;text-decoration:underline;text-underline-offset:2px;}
  .tbkx-rev__src:focus-visible{outline:none;box-shadow:var(--tbk-focus-ring,0 0 0 3px rgba(192,20,87,.22));border-radius:4px;}
  .tbkx-rev__cta{margin-top:var(--tbk-sp-8,32px);}
</style>

{%- elsif request.design_mode -%}
  {%- comment -%}
    Theme editor ONLY (request.design_mode). Never reaches a customer:
    it is inside the `verified_count == 0` branch and gated on design_mode.
  {%- endcomment -%}
  <section class="tbkx-rev-ph">
    <p class="tbkx-rev-ph__t">Waiting for verified review source.</p>
    <p class="tbkx-rev-ph__d">
      This section is hidden from customers until at least one <strong>Verified Review</strong>
      exists. Add entries in <strong>Content → Metaobjects → Verified Review</strong>, tick
      <strong>Verified against source</strong>, and they appear here automatically.
      Approved sources, in priority order: Google Business Profile · Judge.me · Loox ·
      Shopify Product Reviews · Zomato. Never write a review by hand — see REVIEW_STRATEGY.md.
    </p>
  </section>
  <style>
    .tbkx-rev-ph{max-width:var(--tbk-container,1280px);margin:0 auto;
      padding:var(--tbk-sp-8,32px) var(--tbk-edge,clamp(16px,5vw,80px));
      background:var(--tbk-surface-sub,#F8F2F6);border:1px dashed var(--tbk-border-strong,#D4ADC0);
      border-radius:var(--tbk-r-lg,16px);}
    .tbkx-rev-ph__t{margin:0 0 8px;font:600 var(--tbk-text-lg,16px)/1.4 var(--tbk-font-ui,'Manrope',sans-serif);color:var(--tbk-ink,#1A0810);}
    .tbkx-rev-ph__d{margin:0;font:400 var(--tbk-text-sm,14px)/1.6 var(--tbk-font-ui,'Manrope',sans-serif);color:var(--tbk-muted,#876575);max-width:70ch;}
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Home · Reviews",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Homepage §5. GENUINE reviews only, from Content → Metaobjects → Verified Review. Only entries ticked 'Verified against source' render. With 0 verified reviews this section is completely hidden from customers — no heading, no cards, no schema." },
    { "type": "paragraph", "content": "No review text, name, rating or count can be typed into this section. That is deliberate — it is what makes fabrication impossible." },
    { "type": "range", "id": "limit", "label": "Maximum reviews shown", "min": 3, "max": 9, "step": 3, "default": 3 },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Reviews" },
    { "type": "text", "id": "heading", "label": "Section heading (H2)", "default": "In their words" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real reviews from real celebrations across Meerut." },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Home · Reviews" }]
}
{% endschema %}
