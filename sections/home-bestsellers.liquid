{%- comment -%}
  sections/home-bestsellers.liquid — Homepage §4 Bestsellers (Phase C1 · S4)

  ASSEMBLY ONLY — zero new components:
    • FROZEN B3 `tbkx-card--product` (4:5 media, __price, __trust, __eyebrow)
      + `--link/--interactive` + `tbkx-card__media--fallback`
    • FROZEN tokens. Whole-card link pattern reused from S2/S3.
  tbkx- namespaced → protected product page untouched.

  MERCHANDISING (CATALOG_ARCHITECTURE §1b): storefront Liquid can only see
  Active products — drafts are structurally unreachable here, so "live only"
  is guaranteed, not configured. 584 of 1,235 products are draft, so this
  section MUST degrade gracefully: renders however many exist, and the whole
  section disappears at 0 rather than showing an empty grid.

  No add-to-cart: the protected PDP owns the customization flow (weight,
  flavour, message). A homepage ATC would bypass it and ship the wrong cake.
  The card converts by routing to the PDP — the decision surface.

  Heading hierarchy: H1 (hero) → H2 (this section) → H3 (each card).
  Schema: ItemList of Product entities.
  Perf: 0 JS · lazy WebP srcset · explicit w/h · fixed 4:5 ratio → CLS 0.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign col = s.collection
  assign limit = s.limit | default: 8

  assign items = col.products
  assign shown = 0
  if col != blank
    assign shown = col.products.size
  endif
  if shown > limit
    assign shown = limit
  endif
-%}

{%- if shown > 0 -%}
<section class="tbkx-best" aria-labelledby="tbkx-best-h">
  <div class="tbkx-best__inner">

    <div class="tbkx-best__head">
      <div>
        {%- if s.overline != blank -%}<p class="tbkx-best__overline">{{ s.overline }}</p>{%- endif -%}
        <h2 class="tbkx-best__title" id="tbkx-best-h">{{ s.heading | default: 'Most loved' }}</h2>
        {%- if s.subheading != blank -%}<p class="tbkx-best__sub">{{ s.subheading }}</p>{%- endif -%}
      </div>
      {%- if s.cta_label != blank and s.cta_link != blank -%}
        <div class="tbkx-best__cta">
          {%- render 'tbk-button', label: s.cta_label, href: s.cta_link, variant: 'secondary', size: 'md' -%}
        </div>
      {%- endif -%}
    </div>

    <ul class="tbkx-best__grid">
      {%- for product in items limit: limit -%}
        {%- assign media = product.featured_image -%}
        <li class="tbkx-card tbkx-card--product tbkx-card--link tbkx-card--interactive">
          <a class="tbkx-best__link" href="{{ product.url }}">
            <div class="tbkx-card__media{% if media == blank %} tbkx-card__media--fallback{% endif %}">
              {%- if media != blank -%}
                <img src="{{ media | image_url: width: 600, format: 'webp' }}"
                     srcset="{{ media | image_url: width: 300, format: 'webp' }} 300w,
                             {{ media | image_url: width: 450, format: 'webp' }} 450w,
                             {{ media | image_url: width: 600, format: 'webp' }} 600w"
                     sizes="(min-width: 990px) 22vw, (min-width: 768px) 30vw, 45vw"
                     width="{{ media.width }}" height="{{ media.height }}"
                     alt="{{ media.alt | default: product.title | escape }}"
                     loading="lazy" decoding="async">
              {%- else -%}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h16M5 20v-7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7M8 11V8m4 3V7m4 4V8"/></svg>
              {%- endif -%}
            </div>
            <div class="tbkx-card__body">
              <h3 class="tbkx-card__title tbkx-card__title--display">{{ product.title }}</h3>
              <p class="tbkx-card__price">
                {%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}
              </p>
              {%- if s.trust_line != blank -%}
                <p class="tbkx-card__trust">{{ s.trust_line }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{%- comment -%} ItemList — Product entities for crawlability + AI entity relations {%- endcomment -%}
{%- capture best_items -%}
  {%- assign pos = 0 -%}
  {%- for product in items limit: limit -%}
    {%- assign pos = pos | plus: 1 -%}
    {%- unless pos == 1 %},{% endunless -%}
    {"@type":"ListItem","position":{{ pos }},"url":{{ shop.url | append: product.url | json }},"item":{"@type":"Product","name":{{ product.title | json }},"url":{{ shop.url | append: product.url | json }}{% if product.featured_image %},"image":{{ product.featured_image | image_url: width: 800 | prepend: 'https:' | json }}{% endif %},"brand":{"@type":"Brand","name":{{ shop.name | json }}},"offers":{"@type":"Offer","price":{{ product.price | divided_by: 100.0 | json }},"priceCurrency":{{ cart.currency.iso_code | json }},"availability":{% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},"url":{{ shop.url | append: product.url | json }}}}}
  {%- endfor -%}
{%- endcapture -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"ItemList","name":{{ s.heading | default: 'Most loved' | json }},"itemListElement":[{{ best_items | strip_newlines }}]}
</script>

<style>
  .tbkx-best{background:var(--tbk-surface-sub,#F8F2F6);}
  .tbkx-best__inner{
    max-width:var(--tbk-container,1280px);margin:0 auto;
    padding:var(--tbk-section-y,clamp(56px,8vw,128px)) var(--tbk-edge,clamp(16px,5vw,80px));
  }
  .tbkx-best__head{display:flex;flex-direction:column;gap:var(--tbk-sp-5,20px);}
  @media (min-width:768px){
    .tbkx-best__head{flex-direction:row;align-items:flex-end;justify-content:space-between;gap:var(--tbk-sp-8,32px);}
    .tbkx-best__cta{flex:none;}
  }
  .tbkx-best__overline{
    margin:0 0 var(--tbk-sp-3,12px);
    font:var(--tbk-fw-semibold,600) var(--tbk-text-xs,11px)/1 var(--tbk-font-ui,'Manrope',sans-serif);
    letter-spacing:var(--tbk-ls-overline,.14em);text-transform:uppercase;color:var(--tbk-muted,#876575);
  }
  .tbkx-best__title{
    margin:0;font-family:var(--tbk-font-display,'Cormorant Garamond',Georgia,serif);font-weight:600;
    font-size:var(--tbk-display-1,clamp(32px,4vw,52px));line-height:var(--tbk-lh-heading,1.2);
    letter-spacing:var(--tbk-ls-tight,-.01em);color:var(--tbk-ink,#1A0810);
  }
  .tbkx-best__sub{
    margin:var(--tbk-sp-3,12px) 0 0;font-size:var(--tbk-text-lg,16px);line-height:var(--tbk-lh-body,1.65);
    color:var(--tbk-ink-soft,#3B1F2E);max-width:52ch;
  }

  /* Mobile-first: 2 columns → 3 → 4. Never a lonely stretched tile. */
  .tbkx-best__grid{
    list-style:none;margin:var(--tbk-sp-8,32px) 0 0;padding:0;display:grid;
    gap:var(--tbk-sp-3,12px);grid-template-columns:repeat(2,minmax(0,1fr));
  }
  @media (min-width:768px){ .tbkx-best__grid{gap:var(--tbk-sp-4,16px);grid-template-columns:repeat(3,minmax(0,1fr));} }
  @media (min-width:990px){ .tbkx-best__grid{grid-template-columns:repeat(4,minmax(0,1fr));} }

  .tbkx-best__link{display:flex;flex-direction:column;flex:1;text-decoration:none;color:inherit;border-radius:inherit;}
  .tbkx-best__link:focus-visible{outline:none;box-shadow:var(--tbk-focus-ring,0 0 0 3px rgba(192,20,87,.22));border-radius:var(--tbk-r-lg,16px);}
  .tbkx-best__grid .tbkx-card__body{padding:var(--tbk-sp-4,16px);gap:6px;}
  .tbkx-best__grid .tbkx-card__title--display{font-size:clamp(16px,1.4vw,19px);}
</style>
{%- endif -%}

{% schema %}
{
  "name": "Home · Bestsellers",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Homepage §4. Assembly of the FROZEN product card — no new components. Shows LIVE products only (drafts are invisible to the storefront). Renders fewer tiles if the collection is thin, and hides itself entirely at 0 products." },
    { "type": "collection", "id": "collection", "label": "Source collection (use Best Selling Products)" },
    { "type": "range", "id": "limit", "label": "Maximum products", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "text", "id": "overline", "label": "Overline", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Section heading (H2)", "default": "Most loved" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The cakes Meerut orders again and again." },
    { "type": "text", "id": "trust_line", "label": "Trust line on each card", "default": "100% eggless" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View all cakes" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Home · Bestsellers" }]
}
{% endschema %}
