{%- comment -%}
  sections/home-delivery-promise.liquid — Homepage §2 Delivery Promise / Trust (Phase C1)

  ASSEMBLY ONLY — zero new components:
    • Card:    FROZEN B3 `tbkx-card` + `tbkx-card--trust` (+ `--link/--interactive` when linked)
    • Icon:    FROZEN card icon slot `tbkx-card__icon` (thin-line SVG inlined here; extract to the
               B5 icon snippet once a 2nd section needs the same set — requires approval)
    • Type/spacing: FROZEN tokens only. No new CSS primitives.
  tbkx- namespaced → protected product page untouched.

  Semantics: a <ul> of trust points (NOT headings) → no unnecessary H2s, clean outline.
  Performance: zero JavaScript, zero images — inline SVG only.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
-%}

{%- if count > 0 -%}
<section class="tbkx-promise" aria-label="{{ s.aria_label | default: 'Our promise' | escape }}">
  <div class="tbkx-promise__inner">

    {%- if s.overline != blank -%}
      <p class="tbkx-promise__overline">{{ s.overline }}</p>
    {%- endif -%}

    <ul class="tbkx-promise__grid" style="--tbkx-promise-cols:{{ count }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign tag = 'li'
        -%}
        <li class="tbkx-card tbkx-card--trust{% if b.link != blank %} tbkx-card--link tbkx-card--interactive{% endif %}" {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a class="tbkx-promise__link" href="{{ b.link }}">{%- endif -%}
          <div class="tbkx-card__body">
            <span class="tbkx-card__icon" aria-hidden="true">
              {%- case b.icon -%}
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
                {%- when 'moon' -%}
                  <svg viewBox="0 0 24 24"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24"><path d="M4 20c0-8 6-14 16-14 0 10-6 14-16 14z"/><path d="M4 20c4-4 8-6 12-7"/></svg>
                {%- when 'oven' -%}
                  <svg viewBox="0 0 24 24"><path d="M4 20h16M5 20v-7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7M8 11V8m4 3V7m4 4V8"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z"/><path d="M9 12l2 2 4-4"/></svg>
                {%- when 'palette' -%}
                  <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18h1.5a2 2 0 0 0 1.6-3.2 2 2 0 0 1 1.6-3.2H19a3 3 0 0 0 3-3A9 9 0 0 0 12 3z"/><circle cx="8" cy="10" r="1"/><circle cx="12" cy="7.5" r="1"/><circle cx="16" cy="10" r="1"/></svg>
                {%- when 'clock' -%}
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24"><path d="M12 4l2.3 4.9 5.2.7-3.8 3.6.9 5.3-4.6-2.5-4.6 2.5.9-5.3L4.5 9.6l5.2-.7z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>
              {%- endcase -%}
            </span>
            {%- if b.heading != blank -%}<p class="tbkx-card__title">{{ b.heading }}</p>{%- endif -%}
            {%- if b.text != blank -%}<p class="tbkx-card__text tbkx-promise__text">{{ b.text }}</p>{%- endif -%}
          </div>
          {%- if b.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

<style>
  .tbkx-promise{background:var(--tbk-surface,#FDFAF8);}
  .tbkx-promise__inner{
    max-width:var(--tbk-container,1280px);margin:0 auto;
    padding:var(--tbk-section-y-sm,clamp(40px,6vw,96px)) var(--tbk-edge,clamp(16px,5vw,80px));
  }
  .tbkx-promise__overline{
    margin:0 0 var(--tbk-sp-6,24px);text-align:center;
    font:var(--tbk-fw-semibold,600) var(--tbk-text-xs,11px)/1 var(--tbk-font-ui,'Manrope',sans-serif);
    letter-spacing:var(--tbk-ls-overline,.14em);text-transform:uppercase;color:var(--tbk-muted,#876575);
  }

  /* Mobile: 2 columns (per spec) */
  .tbkx-promise__grid{
    list-style:none;margin:0;padding:0;display:grid;gap:var(--tbk-sp-3,12px);
    grid-template-columns:repeat(2,minmax(0,1fr));
  }
  /* Tablet: 3 across */
  @media (min-width:768px){ .tbkx-promise__grid{gap:var(--tbk-sp-4,16px);grid-template-columns:repeat(3,minmax(0,1fr));} }
  /* Desktop: all cards in one elegant row (4–6, driven by block count) */
  @media (min-width:990px){ .tbkx-promise__grid{grid-template-columns:repeat(var(--tbkx-promise-cols,4),minmax(0,1fr));} }

  /* Card tuning within the FROZEN card system (spacing/scale only — no new component) */
  .tbkx-promise__grid .tbkx-card__body{padding:var(--tbk-sp-5,20px) var(--tbk-sp-4,16px);gap:var(--tbk-sp-2,8px);}
  .tbkx-promise__grid .tbkx-card__icon{width:28px;height:28px;}      /* restrained — no oversized icons */
  .tbkx-promise__grid .tbkx-card__title{font-size:var(--tbk-text-base,14px);}
  .tbkx-promise__text{font-size:var(--tbk-text-sm,12.5px);color:var(--tbk-muted,#876575);}

  /* Linked cards: whole card is one focusable target (≥44px by construction) */
  .tbkx-promise__link{display:flex;flex:1;text-decoration:none;color:inherit;border-radius:inherit;}
  .tbkx-promise__link:focus-visible{outline:none;box-shadow:var(--tbk-focus-ring,0 0 0 3px rgba(192,20,87,.22));border-radius:var(--tbk-r-lg,16px);}
</style>

{% schema %}
{
  "name": "Home · Delivery Promise",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Homepage §2. Assembly of the FROZEN card system — no new components. Semantic list (no H2s). Zero JS, zero images. Add 4–6 trust items; desktop shows them in one row." },
    { "type": "text", "id": "overline", "label": "Overline (optional — leave blank for none)" },
    { "type": "text", "id": "aria_label", "label": "Accessible section label", "default": "Our promise" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Thin-line icon", "default": "check",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "moon", "label": "Midnight / moon" },
            { "value": "leaf", "label": "Eggless / leaf" },
            { "value": "oven", "label": "Freshly baked / oven" },
            { "value": "shield", "label": "Certified / shield" },
            { "value": "palette", "label": "Custom design / palette" },
            { "value": "clock", "label": "Clock" },
            { "value": "star", "label": "Star" },
            { "value": "check", "label": "Check" }
          ] },
        { "type": "text", "id": "heading", "label": "Headline" },
        { "type": "text", "id": "text", "label": "Supporting sentence (one line)" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [{
    "name": "Home · Delivery Promise",
    "blocks": [
      { "type": "item", "settings": { "icon": "truck",   "heading": "Same-Day Delivery",    "text": "Order by 4 PM and we deliver across Meerut today." } },
      { "type": "item", "settings": { "icon": "moon",    "heading": "Midnight Delivery",    "text": "Surprise them at 12 AM, beautifully timed." } },
      { "type": "item", "settings": { "icon": "leaf",    "heading": "100% Eggless",         "text": "Every cake is pure-vegetarian, with no compromise on taste." } },
      { "type": "item", "settings": { "icon": "oven",    "heading": "Freshly Made to Order","text": "Baked after you order — never from a shelf." } },
      { "type": "item", "settings": { "icon": "shield",  "heading": "FSSAI Licensed",       "text": "Certified kitchen, hygienic handling, safe packaging." } },
      { "type": "item", "settings": { "icon": "palette", "heading": "Premium Custom Cakes", "text": "Designer cakes crafted from your reference photo." } }
    ]
  }]
}
{% endschema %}
