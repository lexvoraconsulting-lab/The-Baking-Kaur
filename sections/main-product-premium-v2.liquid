}<script>
(function () {
  function forceWhatsappLeft() {
    document.querySelectorAll('.tbk-whatsapp-wrapper').forEach(function (wrap) {
      wrap.style.display = 'block';
      wrap.style.textAlign = 'left';
      wrap.style.justifyContent = 'flex-start';
      wrap.style.alignItems = 'flex-start';

      const btn = wrap.querySelector('.tbk-whatsapp-btn');
      if (btn) {
        btn.style.marginLeft = '0';
        btn.style.marginRight = '0';
        btn.style.display = 'block';
        btn.style.width = '100%';
        btn.style.alignSelf = 'flex-start';
      }
    });
  }

  // Run immediately
  forceWhatsappLeft();

  // Re-run after Shopify / theme JS injects
  const observer = new MutationObserver(forceWhatsappLeft);
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  function fixDeliveryLayout() {
    const blocks = document.querySelectorAll('.hdt-product-form_value.is-type-block');

    blocks.forEach(block => {
      const selects = block.querySelectorAll('select, input[type="date"]');
      if (selects.length >= 2) {

        // Create wrapper once
        if (!block.classList.contains('tbk-delivery-fixed')) {
          block.classList.add('tbk-delivery-fixed');

          const wrap = document.createElement('div');
          wrap.className = 'tbk-delivery-wrap';

          selects.forEach(el => wrap.appendChild(el));
          block.appendChild(wrap);
        }
      }
    });
  }

  fixDeliveryLayout();

  // Shopify re-renders variants → observe
  const obs = new MutationObserver(fixDeliveryLayout);
  obs.observe(document.body, { childList: true, subtree: true });

});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const chocolateSelect = document.getElementById('chocolate_option');
  if (!chocolateSelect) return;

  const priceElement = document.querySelector('[data-product-price]');
  const basePrice = parseInt(priceElement.dataset.basePrice);
  const addonInput = document.getElementById('addon_price');

  function updatePrice() {
    const selectedOption = chocolateSelect.options[chocolateSelect.selectedIndex];
    const addonPrice = parseInt(selectedOption.dataset.price || 0);

    const finalPrice = basePrice + addonPrice;

    priceElement.innerText = 'Rs. ' + finalPrice.toLocaleString('en-IN');
    addonInput.value = addonPrice;
  }

  chocolateSelect.addEventListener('change', updatePrice);
});
</script>

