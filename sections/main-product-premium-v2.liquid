<script>
document.addEventListener("DOMContentLoaded", function() {
  const productForm = document.querySelector("form[action*='/cart/add']");
  if (!productForm) return;

  // ----- locate / move the date input (in case it was added via Custom Liquid) -----
  let dateInput = document.getElementById("delivery-date-{{ section.id }}");
  //if (dateInput && !productForm.contains(dateInput)) {
  //  productForm.appendChild(dateInput);
  //}

  // add an error message if you don't have one
  let errorMsg = document.getElementById("date-error-{{ section.id }}");
  if (!errorMsg && dateInput) {
    errorMsg = document.createElement("p");
    errorMsg.id = "date-error";
    errorMsg.textContent = "Please select a valid date (today to 30 days ahead).";
    errorMsg.style.cssText = "color:red;font-size:14px;display:none;margin-top:6px;";
    dateInput.insertAdjacentElement("afterend", errorMsg);
  }

  // ----- min/max (handle local timezone correctly) -----
  function toLocalYMD(d){
    const tz = d.getTimezoneOffset() * 60000;
    return new Date(d - tz).toISOString().slice(0,10);
  }
  const today = new Date();
  const maxDate = new Date(today);
  maxDate.setDate(today.getDate() + 30);

  if (dateInput) {
    dateInput.min = toLocalYMD(today);
    dateInput.max = toLocalYMD(maxDate);
  }

  function isValidDate(){
    if (!dateInput || !dateInput.value) return false;
    const chosen = new Date(dateInput.value + "T00:00:00");
    const start = new Date(toLocalYMD(today) + "T00:00:00");
    const end   = new Date(toLocalYMD(maxDate) + "T00:00:00");
    return (chosen >= start && chosen <= end);
  }
  function showValidity(){
    if (!errorMsg) return;
    errorMsg.style.display = isValidDate() ? "none" : "block";
  }

  // ----- 1) block normal form submit (covers Add to Cart and many Buy-It-Now flows) -----
  productForm.addEventListener("submit", function(e){
    if (!isValidDate()) {
      e.preventDefault();
      e.stopPropagation();
      showValidity();
      return false;
    }
  }, true); // capture to beat theme listeners

  

  // ----- 3) wallet buttons inside iframes (Apple/Google Pay) → gate the container -----
  const payContainer = document.querySelector(".shopify-payment-button");
  function toggleWalletGate(){
    const ok = isValidDate();
    if (payContainer) {
      payContainer.style.pointerEvents = ok ? "" : "none";
      payContainer.style.opacity = ok ? "" : "0.5";
    }
  }
  if (dateInput) {
    dateInput.addEventListener("change", () => { showValidity(); toggleWalletGate(); });
    dateInput.addEventListener("input",  () => { showValidity(); toggleWalletGate(); });
  }
  // initial state
  showValidity();
  toggleWalletGate();
});
</script>


