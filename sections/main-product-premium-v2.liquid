<!-- sections/main-product.liquid -->

{%- liquid
  assign block_variant_picker = section.blocks | where: 'type', 'variant_picker' | first
  assign update_url = block_variant_picker.settings.enable_historystate
  assign un_no_pick = true
  if block_variant_picker.settings.pick_mode == 'no' and product.variants.size > 1
    assign selected_variant = product.selected_variant
    assign update_url = false
    unless selected_variant
      assign un_no_pick = false
    endunless
  elsif block_variant_picker.settings.pick_mode == 'first' and block_variant_picker.settings.hide_sold_out == false
    assign selected_variant = product.selected_variant | default: product.variants.first
  else
    assign selected_variant = product.selected_or_first_available_variant
  endif
  assign product_form_id = 'product-form-' | append: section.id | append: product.id
  assign tabCheck = false
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --pr-media-width: {{ section.settings.media_width }}%; --section-pt:{{ section.settings.padding_top }}px; --section-pb:{{ section.settings.padding_bottom }}px; --section-prate:{{ section.settings.padding_rate }};
  }
{%- endstyle -%}
<style>

.tbk-premium-product{

display:grid;

grid-template-columns:54% 46%;

gap:40px;

align-items:start;

}

.tbk-product-gallery{

position:sticky;

top:120px;

}

.tbk-product-content{

display:flex;

flex-direction:column;

gap:18px;

}

@media(max-width:768px){

.tbk-premium-product{

grid-template-columns:45% 55%;

gap:12px;

align-items:start;

}

.tbk-product-gallery{

position:relative;

top:auto;

}

}

</style>
<div class="hdt-main-product hdt-section-spacing hdt-s-gradient" color-scheme="{{ section.settings.color_scheme }}">
  <div class="hdt-container">
    <style>

.tbk-premium-product{
    display:grid;
    grid-template-columns:55% 45%;
    gap:56px;
    align-items:start;
}

.tbk-product-gallery{
    position:sticky;
    top:120px;
    align-self:start;
}

.tbk-product-content{
    max-width:560px;
    width:100%;
}

@media(max-width:990px){

.tbk-premium-product{
    display:block;
}

.tbk-product-gallery{
    position:relative;
    .tbk-product-gallery img{
    border-radius:20px;
}
    top:auto;
    margin-bottom:28px;
}

.tbk-product-content{
    max-width:100%;
}

}

</style>
    <div class="tbk-premium-product">
      <div class="tbk-product-gallery">

        <div class="tbk-gallery-main">

    {% render 'product-media',
      product: product,
      product_form_id: product_form_id,
      un_no_pick: un_no_pick,
      selected_variant: selected_variant %}

        </div>

</div>
     
      <div class="tbk-product-content">
        <div id="product-zoom-{{ section.id }}" class="hdt-produc-zoom--wrapp"></div>
        <div id="product-info-{{ section.id }}" class="hdt-product-info__list{% if section.settings.space_content_media %} hdt-product__info-space{% endif %}">
       
        

     {% for block in section.blocks %}
{% case block.type %}
  {% when 'variant_picker' %}
       {% render block %}
    
      <!-- FLAVOUR + WEIGHT -->

    {% when 'price' %}
      <!-- PRICE -->
      {% render block %}

    {% when 'quantity_selector' %}
      <!-- QUANTITY -->
      {% render block %}

    {% when 'delivery_schedule' %}
      <!-- DELIVERY -->
      {% render block %}

    {% when 'buy_buttons' %}
     

      {% render block %}

              

  {% assign has_form_act = true %}

  
  {%- comment -%} Phase D: Add-to-Cart wrapper relocated into the buy_buttons block (Loop 2, after Delivery / before WhatsApp). Hardcoded tbk-premium-features trust row removed — trust chips now come from the custom_liquid "Delievery" block. {%- endcomment -%}

           </div>

{% for block in section.blocks %}
{% case block.type %}

{%- when 'app' -%}
{% render block %}

            {%- when 'title' -%}
              <div class="hdt-product-info__item hdt-product__title" data-type="{{ block.type }}" {{ block.shopify_attributes }}><h1 class="hdt-product__title hdt-font-normal">{{ product.title | escape }}</h1></div>

            {%- when 'vendor' -%}
              {%- liquid
                if product.vendor == blank
                  continue
                endif
              -%}
              <div class="hdt-product-info__item hdt-product__vendor hdt-s-text" data-type="{{ block.type }}" {{ block.shopify_attributes }}>{{ 'products.product.vendor' | t }} <span class="hdt-font-semibold">{%- render 'vendor' with product.vendor -%}</span></div>

            {%- when 'price' -%}
              <div class="hdt-product-info__item hdt-product__price" data-type="{{ block.type }}" {{ block.shopify_attributes }}>
                {%- render 'price', product: product, use_variant: true, form_id: product_form_id, show_badges: true, only_show_sale: true, show_volume_note: false, un_no_pick: un_no_pick -%}
              </div>
            {%- when 'live_view' -%}
              <div class="hdt-product-info__item hdt-product__liveview" data-type="{{ block.type }}" {{ block.shopify_attributes }}>
                <div class="hdt-product__liveview-wrap hdt-font-semibold hdt-inline-flex hdt-align-center">
                  {%- capture count_html -%}
                    {%- assign count = 'now' | date: '%S' | at_most: block.settings.min | at_least: block.settings.max -%}
                    <div class="hdt-product__liveview-count hdt-inline-flex hdt-align-center hdt-justify-center">
                      <number-random config='{ "min":{{ block.settings.min }}, "max":{{ block.settings.max }}, "interval":{{ block.settings.time }}000 }'>{{ count }}</number-random>
                    </div>
                  {%- endcapture -%}
                  {%- if block.settings.content != blank -%}
                    <div class="hdt-product__liveview-content hdt-s-text">
                      {{ block.settings.content | replace: "[count]", count_html }}
                    </div>
                  {%- endif -%}
                </div>
              </div>

              

            {%- when 'sold' %}
              {%- unless product.available %}{%- continue -%}{%- endunless -%}
              {% if block.settings.text == blank %}{% continue %}{% endif -%}
              <div class="hdt-product-info__item hdt-product__sold-flash" {{ block.shopify_attributes }} {%- unless selected_variant.available %} style="display: none;"{%- endunless %}>
                <flash-sold id="sold{{ block.id }}" class="hdt-block" time="120000" flash-sold='{ "mins":{{ block.settings.mins }}, "maxs":{{ block.settings.maxs }}, "mint":{{ block.settings.mint }}, "maxt":{{ block.settings.maxt }}, "id":"{{ product.id }}", "time": 120000 }' form="{{ product_form_id }}">
                  <span class="hdt-product__sold-flash-content hdt-inline-flex hdt-align-center hdt-s-text hdt-font-semibold">
                    {%- if block.settings.icon_svg != 'none' -%}
                    {%- assign class = block.settings.ani | append: ' is--infinite hdt-inine-block' -%}
                      {%- render 'icon_theme_svg', icon_svg: block.settings.icon_svg, class: class -%}
                    {%- endif -%}
                    <span class="hdt-s-text hdt-font-semibold">{{ block.settings.text | replace: '[sold]', '<span data-sold class=""></span>' | replace: '[hour]', '<span data-hour class=""></span>' }}</span>
                  </span>
                </flash-sold>
              </div>
            {%- when 'order' -%}
              {%- unless product.available %}{%- continue -%}{%- endunless -%}
              {%- liquid
                assign has_pre_order = false
                if product.available
                  if selected_variant.inventory_management == "shopify" and selected_variant.inventory_policy == "continue" and selected_variant.inventory_quantity <= 0
                    assign has_pre_order = true
                  endif
                endif
              -%}
              {%- capture hourHTML -%}
              <hdt-countdown-simple config='{ "time": {{ block.settings.time | default: "19041994" | json }} }'><template>[hours] {{ 'sections.countdown_timmer.hr_plural' | t | escape }} [mins] {{ 'sections.countdown_timmer.min_plural' | t | escape }}</template></hdt-countdown-simple>
              {%- endcapture -%}
              <div class="hdt-product-info__item hdt-product__order" data-type="{{ block.type }}" {{ block.shopify_attributes }} style="{%-unless selected_variant.available-%}display: none;{%-endunless-%}{%- if has_pre_order and block.settings.hide_pre %}display: none;{%- endif -%}">
                <order-delivery id="delivery{{ block.id }}" class="" config='{ "hide_pre": {{ block.settings.hide_pre }}, "timezone":false, "format_day":"{{ block.settings.frm_day }}", "mode":"{{ block.settings.mode }}", "cut_day": {{ block.settings.cut_day | json }}, "off_day": "{{ block.settings.off_days | split: " " | join: "," }}", "estimateStartDate": {{ product.metafields.theme.estimateStartDate | default: block.settings.ds | json }}, "estimateEndDate": {{ product.metafields.theme.estimateEndDate | default: block.settings.de | json }}, "time":{{ block.settings.time | default: "19041994" | json }}, "hideWithPreorder":{{ block.settings.hide_pre }} }' form="{{ product_form_id }}">
                  <div class="hdt-product__order-content hdt-inline-flex hdt-align-center">
                    {%- if block.settings.icon_svg != 'none' -%}
                    {%- assign class = block.settings.ani | append: ' is--infinite hdt-inine-block' -%}
                      {%- render 'icon_theme_svg', icon_svg: block.settings.icon_svg, class: class -%}
                    {%- endif -%}
                    <span class="hdt-s-text">{{ block.settings.txt | replace: '[hour]', hourHTML | replace: '[date_start]', '<span data-start-delivery class="hdt-start_delivery hdt-font-semibold"></span>' | replace: '[date_end]', '<span data-end-delivery class="hdt-end_delivery hdt-font-semibold"></span>' }}</span>
                  </div>
                </order-delivery>
              </div>

            {%- when 'countdown_timer' -%}
              {%-  liquid
                unless product.available
                  continue
                endunless
                assign metaobj_theme_countdown = shop.metaobjects.theme_countdown.values | first
                assign theme_countdown = metaobj_theme_countdown.date_time.value
                assign product_countdown = theme_countdown| default: product.metafields.theme.countdown.value
                if product_countdown == blank
                continue
                endif
              -%}

              <countdown-timer class="hdt-product-info__item hdt-product__countdown hdt-block" data-type="{{ block.type }}" {{ block.shopify_attributes }} {%- unless selected_variant.available %} style="display: none;"{%- endunless -%} form="{{ product_form_id }}">
                <hdt-countdown class="hdt-block" config='{"month":"{{ product_countdown | date: '%m' | plus: 0 }}", "date":"{{ product_countdown | date: '%d, %Y %H:%M:%S' }}", "hideTimerOnComplete": true, "hasZero": true }'>
                  <div class="hdt-product__countdown-wrap hdt-text-center hdt-inline-block">
                    {%- if block.settings.content != blank -%}
                      <div class="hdt-product__countdown-title hdt-inline-flex hdt-align-center hdt-s-text hdt-text-xs hdt-font-bold">
                        {%- if block.settings.icon_svg != 'none' -%}
                          {%- assign class = block.settings.ani | append: ' is--infinite hdt-inine-block' -%}
                          {%- render 'icon_theme_svg', icon_svg: block.settings.icon_svg, class: class -%}
                        {%- endif -%}
                        <p class="hdt-inline-block">{{ block.settings.content }}</p>
                      </div>
                    {%- endif -%}
                    <div class="hdt-product__countdown-time hdt-font-semibold">
                      <div class="hdt-product__countdown-inner hdt-relative hdt-flex hdt-flex-wrap hdt-items-center hdt-justify-center" aria-hidden="true">
                        <div class="hdt-product__countdown-item">
                          <hdt-countdown-amount effect="move_top" data-days>00</hdt-countdown-amount>
                          <hdt-countdown-text singular="{{ 'sections.countdown_timmer.day' | t }}" class="hdt-grid">{{ 'sections.countdown_timmer.day_plural' | t }}</hdt-countdown-text>
                        </div><span>:</span>
                        <div class="hdt-product__countdown-item">
                          <hdt-countdown-amount effect="move_top" data-hours>00</hdt-countdown-amount>
                          <hdt-countdown-text singular="{{ 'sections.countdown_timmer.hr' | t }}" class="hdt-grid">{{ 'sections.countdown_timmer.hr_plural' | t }}</hdt-countdown-text>
                        </div><span>:</span>
                        <div class="hdt-product__countdown-item">
                          <hdt-countdown-amount effect="move_top" data-minutes>00</hdt-countdown-amount>
                          <hdt-countdown-text singular="{{ 'sections.countdown_timmer.min' | t }}" class="hdt-grid">{{ 'sections.countdown_timmer.min_plural' | t }}</hdt-countdown-text>
                        </div><span>:</span>
                        <div class="hdt-product__countdown-item">
                          <hdt-countdown-amount effect="move_top" data-seconds>00</hdt-countdown-amount>
                          <hdt-countdown-text singular="{{ 'sections.countdown_timmer.sec' | t }}" class="hdt-grid">{{ 'sections.countdown_timmer.sec_plural' | t }}</hdt-countdown-text>
                        </div>
                      </div>
                    </div>
                  </div>
                </hdt-countdown>
              </countdown-timer>

            {%- when 'quantity_selector' -%}
              {%- liquid
                unless product.available
                  continue
                endunless
              -%}
              <div class="hdt-product-info__item" data-type="{{ block.type }}" {{ block.shopify_attributes }}>
              {%- render 'product-qty-selector', block: block, selected_variant: selected_variant, product_form_id: product_form_id, product: product -%}
              </div>

            {%- when 'variant_picker' -%}
              <div class="hdt-product-info__item hdt-product__variant-picker" data-type="{{ block.type }}" {{ block.shopify_attributes }}>{%- render 'variant-picker', product: product, block: block, product_form_id: product_form_id, update_url: update_url, selected_variant: selected_variant, un_no_pick: un_no_pick, hide_update_value: true -%}</div>

              <!-- Delivery schedule (Date + Time Slot + optional reference image) -->
            <div class="delivery-options">
              <div class="tbk-date-time-row">
                <div class="hdt-product-form_value is-type-block">
                    <label class="hdt-product-form__label hdt-s-text" for="delivery-date-{{ section.id }}">Delivery Date</label>
                    <input form="{{ product_form_id }}" type="date" id="delivery-date-{{ section.id }}" name="properties[Delivery Date]" required>
                </div>
                <div class="hdt-product-form_value is-type-block">
                    <label class="hdt-product-form__label hdt-s-text" for="delivery-slot-{{ section.id }}">Delivery Time Slot</label>
                    <select form="{{ product_form_id }}" id="delivery-slot-{{ section.id }}" name="properties[Delivery Time Slot]" required>
                        <option value="">Select Time Slot</option>
                        <option value="11:00 AM - 1:00 PM">11:00 AM - 1:00 PM</option>
                        <option value="1:00 PM - 3:00 PM">1:00 PM - 3:00 PM</option>
                        <option value="3:00 PM - 5:00 PM">3:00 PM - 5:00 PM</option>
                        <option value="5:00 PM - 7:00 PM">5:00 PM - 7:00 PM</option>
                        <option value="7:00 PM - 9:00 PM">7:00 PM - 9:00 PM</option>
                    </select>
                </div>
              </div>
                <div class="hdt-product-form_value is-type-block">
                    <label class="hdt-product-form__label hdt-s-text" for="cake-message-{{ section.id }}">Cake Message</label>
                    <input form="{{ product_form_id }}" type="text" id="cake-message-{{ section.id }}" name="properties[Cake Message]" placeholder="Add a message for the cake" maxlength="80">
                </div>
                <p id="date-error-{{ section.id }}" style="color:#DD137B; background-color:#e8e6e7; border-radius: 12px; margin-top: 10px; padding: 8px; display:none;font-size:14px;" align="center">
                    ** Note: Please select a valid date (today to 30 days ahead).
                </p>
            </div>

            {%- when 'buy_buttons' -%}
           

  {%- assign has_form_act = true -%}

  <div class="hdt-product-info__item hdt-product__buy-button"
       data-type="{{ block.type }}"
       {{ block.shopify_attributes }}>

    


    {% assign whatsapp_message =
      "Hi The Baking Kaur,%0A%0AI am interested in this product:%0A"
      | append: product.title
      | append: "%0A%0AProduct link:%0A"
      | append: shop.url
      | append: product.url
    %}

    <div class="tbk-addtocart-row">
  {% render 'buy-buttons',
  product: product,
  block: block,
  product_form_id: product_form_id,
  show_hamper_addons: false
%}
    </div>

    <a href="https://wa.me/918218862928?text={{ whatsapp_message }}"
       class="tbk-whatsapp-btn"
       target="_blank" rel="noopener"
       aria-label="Customize on WhatsApp">
