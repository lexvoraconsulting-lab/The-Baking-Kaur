{%- comment -%}
  sections/tbk-announcement-bar.liquid
  The Baking Kaur — Static Trust Bar v2 (polished)
  Desktop: [Left trust pills] [Right delivery badge]
  Tablet:  [First two pills] [Delivery badge]
  Mobile:  [First pill]      [Delivery badge]
{%- endcomment -%}

{%- assign s   = section.settings -%}
{%- assign sid = section.id -%}

<style>
  @keyframes tbk-ann-in-{{ sid }} {
    from { opacity: 0; }
    to   { opacity: 1; }
  }



  #tbk-ann-{{ sid }} {
    --ann-bg:  {{ s.bg_color }};
    --ann-bg2: {{ s.bg_color_2 }};
    --ann-fg:  {{ s.text_color }};
    --ann-h:   {{ s.bar_height }}px;
    background: #FDFAF8;
    color: #7A2147;
    border-bottom: 1px solid #EDD8E3;
    height: var(--ann-h);
    overflow: hidden;
    font-family: var(--tbk-font-ui);
    position: relative;
    z-index: 1;
    animation: tbk-ann-in-{{ sid }} 0.5s ease both;
  }

  /* Subtle light-sweep across the gradient — premium micro-detail */

  #tbk-ann-{{ sid }}.tbk-ann-hidden { display: none; }
  #tbk-ann-{{ sid }} * { box-sizing: border-box; }
  #tbk-ann-{{ sid }} a { color: inherit; text-decoration: none; }

  /* ── Shell ── */
  #tbk-ann-{{ sid }} .tbk-ann-shell {
    max-width: {{ s.container_width }}px;
    margin: 0 auto;
    padding: 0 40px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  /* ── Trust pills (left) ── */
  #tbk-ann-{{ sid }} .tbk-ann-trust {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    font-size: 12px;
font-weight: 600;
letter-spacing: .45px;
    line-height: 1;
    white-space: nowrap;
  }
  #tbk-ann-{{ sid }} .tbk-ann-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
  }
  #tbk-ann-{{ sid }} .tbk-ann-pill-icon {
    font-size: 13px;
    line-height: 1;
    flex: 0 0 auto;
  }
  #tbk-ann-{{ sid }} .tbk-ann-sep {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(122, 33, 71, 0.4);
    margin: 0 14px;
    flex: 0 0 auto;
  }

  /* ── Delivery badge (right) ── */
  #tbk-ann-{{ sid }} .tbk-ann-delivery {
    display: flex;
    align-items: center;
    gap: 7px;
    flex: 0 0 auto;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.3px;
    white-space: nowrap;
   background: rgba(255,255,255,.95);
color: var(--tbk-pink);
border: none;
border-radius: 999px;
padding: 6px 14px;
font-weight: 700;
box-shadow: 0 2px 8px rgba(0,0,0,.08);}
  #tbk-ann-{{ sid }} .tbk-ann-delivery svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
    flex: 0 0 auto;
  }

  /* ── Tablet (768–1023px): hide pill 3 + sep 2 ── */
  @media (min-width: 768px) and (max-width: 1023px) {
    #tbk-ann-{{ sid }} .tbk-ann-shell { padding: 0 20px; }
    #tbk-ann-{{ sid }} .tbk-ann-trust > *:nth-child(n+4) { display: none; }
  }

  /* ── Mobile (≤767px): pill 1 + delivery badge only ── */
  @media (max-width: 767px) {
    #tbk-ann-{{ sid }} .tbk-ann-shell { padding: 0 18px; gap: 10px; }
    #tbk-ann-{{ sid }} .tbk-ann-trust > *:nth-child(n+2) { display: none; }
    #tbk-ann-{{ sid }} .tbk-ann-trust { font-size: 10.5px; }
    #tbk-ann-{{ sid }} .tbk-ann-delivery { font-size: 11px; }
  }
</style>

<div id="tbk-ann-{{ sid }}"
     class="tbk-ann-section"
     role="region"
     aria-label="Store trust information">
  <div class="tbk-ann-shell">

    {%- comment -%} LEFT — trust signals {%- endcomment -%}
    <div class="tbk-ann-trust" aria-label="Why choose us">
      {%- assign pill_shown = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_pill' -%}
          {%- assign pill_text = block.settings.text | strip -%}
          {%- if pill_text == '100% Eggless' -%}{%- continue -%}{%- endif -%}
          {%- if pill_text == 'Premium Ingredients' -%}{%- continue -%}{%- endif -%}
          {%- if pill_shown -%}
            <span class="tbk-ann-sep" aria-hidden="true"></span>
          {%- endif -%}
          <span class="tbk-ann-pill" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="tbk-ann-pill-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </span>
          {%- assign pill_shown = true -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} RIGHT — delivery badge removed per request {%- endcomment -%}

  </div>
</div>

{% schema %}
{
  "name": "TBK Trust Bar",
  "class": "tbk-ann-section",
  "limit": 1,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color",    "id": "bg_color",      "label": "Background",             "default": "#C01457" },
    { "type": "color",    "id": "bg_color_2",    "label": "Gradient end color",     "default": "#8E0E40" },
    { "type": "checkbox", "id": "use_gradient",  "label": "Use gradient",           "default": true },
    { "type": "color",    "id": "text_color",    "label": "Text color",             "default": "#FFFFFF" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "bar_height",       "label": "Bar height",  "min": 32, "max": 48, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "container_width",  "label": "Max width",   "min": 900, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
    { "type": "header", "content": "Delivery badge" },
    { "type": "text",  "id": "delivery_text",    "label": "Delivery badge text",    "default": "Same Day Delivery in Meerut" }
  ],
  "blocks": [
    {
      "type": "trust_pill",
      "name": "Trust pill",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon / emoji", "default": "♡" },
        { "type": "text", "id": "text", "label": "Trust message", "default": "100% Eggless" }
      ]
    }
  ],
  "presets": [
    {
      "name": "TBK Trust Bar",
      "blocks": [
        { "type": "trust_pill", "settings": { "icon": "♡", "text": "100% Eggless" } },
        { "type": "trust_pill", "settings": { "icon": "✦", "text": "Premium Ingredients" } },
        { "type": "trust_pill", "settings": { "icon": "🎂", "text": "Handcrafted with Love" } }
      ]
    }
  ]
}
{% endschema %}
