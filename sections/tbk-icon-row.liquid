{%- comment -%}
  TBK Icon Row — premium icon + title + subtitle row.

  Purpose: replaces Ecomus `feature_columns` for TBK's trust strip, service rows
  and value pillars. `feature_columns` force-injects `hero-apparel-*`
  placeholder SVGs (mountains / shirts / luggage) whenever a block has no image,
  and its `subtitle` setting defaults to the literal string "Subtitle" — both
  render on the storefront and neither can be switched off from the template.
  This section draws thin line icons inline instead, so it never emits
  placeholder artwork and never leaks schema label text.
{%- endcomment -%}

{%- liquid
  assign cols = section.settings.col_dk | plus: 0
  assign cols_tb = section.settings.col_tb | plus: 0
  assign cols_mb = section.settings.col_mb | plus: 0
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --tbk-row-pt: {{ section.settings.padding_top }}px;
    --tbk-row-pb: {{ section.settings.padding_bottom }}px;
    --tbk-row-cols: {{ cols }};
    --tbk-row-cols-tb: {{ cols_tb }};
    --tbk-row-cols-mb: {{ cols_mb }};
  }
{%- endstyle -%}

<div class="tbk-icon-row tbk-icon-row--{{ section.settings.layout }}" color-scheme="{{ section.settings.color_scheme }}">
  <div class="tbk-icon-row__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="tbk-icon-row__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="tbk-icon-row__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <ul class="tbk-icon-row__list" role="list">
      {%- for block in section.blocks -%}
        <li class="tbk-icon-row__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="tbk-icon-row__icon" aria-hidden="true">
              {%- render 'tbk-line-icon', icon: block.settings.icon -%}
            </span>
          {%- endif -%}
          <span class="tbk-icon-row__text">
            {%- if block.settings.title != blank -%}
              <span class="tbk-icon-row__title">{{ block.settings.title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <span class="tbk-icon-row__subtitle">{{ block.settings.subtitle | escape }}</span>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "TBK Icon Row",
  "class": "hdt-section tbk-section-icon-row",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "panel",
      "options": [
        { "value": "panel", "label": "Trust panel (bordered, compact)" },
        { "value": "plain", "label": "Plain row (open, spacious)" }
      ]
    },
    {
      "type": "select",
      "id": "col_dk",
      "label": "Columns (desktop)",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ]
    },
    {
      "type": "select",
      "id": "col_tb",
      "label": "Columns (tablet)",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "select",
      "id": "col_mb",
      "label": "Columns (mobile)",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colors" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "star",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "delivery", "label": "Delivery scooter" },
            { "value": "cake", "label": "Cake" },
            { "value": "palette", "label": "Custom design" },
            { "value": "shield", "label": "Quality shield" },
            { "value": "star", "label": "Star / rating" },
            { "value": "heart", "label": "Heart" },
            { "value": "users", "label": "Customers" },
            { "value": "clock", "label": "Clock" },
            { "value": "leaf", "label": "Fresh / eggless" },
            { "value": "gift", "label": "Gift" },
            { "value": "flower", "label": "Flower" },
            { "value": "balloon", "label": "Balloon" },
            { "value": "pin", "label": "Location pin" },
            { "value": "sparkle", "label": "Sparkle" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [{ "name": "TBK Icon Row" }]
}
{% endschema %}
