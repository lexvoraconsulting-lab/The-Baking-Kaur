__pycache__/
*.pyc

# seo-ops generated outputs — dry-run review CSVs, mutation payloads, run logs.
# Source (.py) and docs (.md) are NOT ignored.
**/ops/*.csv
**/ops/*.jsonl
**/ops/*.log
**/ops/**/PROGRESS.txt
seo-ops/*.csv
seo-ops/*.jsonl
seo-ops/*.log
seo-ops/**/PROGRESS.txt

# ai/vision/images — local smoke-test images only
**/vision/images/*
!**/vision/images/1.png
!**/vision/images/2.png
!**/vision/images/3.png
!**/vision/images/README.md

# ai/pricing — the audit trail is runtime-generated, not source.
**/ai/logs/*.jsonl
**/templates/index.json.bak
**/templates/index.json.backup

# ai/cake_genome/output — per-run pipeline artifacts
**/cake_genome/output/

# Secrets
.env
.env.*
*.pem
*.key
*_token
*_secret
.shopify/

# Stray images
/test-cake.png
/*.png
**/logs/*.png
!**/vision/images/*.png
