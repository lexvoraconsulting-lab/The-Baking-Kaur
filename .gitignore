__pycache__/
*.pyc

# seo-ops generated outputs — dry-run review CSVs, mutation payloads, run logs.
# Source (.py) and docs (.md) are NOT ignored.
seo-ops/*.csv
seo-ops/*.jsonl
seo-ops/*.log
seo-ops/**/PROGRESS.txt

# ai/vision/images — local smoke-test images only (see ai/vision/images/README.md).
# Ignore everything future, keep the 3 existing sample images tracked.
ai/vision/images/*
!ai/vision/images/1.png
!ai/vision/images/2.png
!ai/vision/images/3.png
!ai/vision/images/README.md

# ai/pricing — the audit trail is runtime-generated, not source.
ai/logs/*.jsonl
templates/index.json.bak
templates/index.json.backup

# ai/cake_genome/output — per-run pipeline artifacts (raw responses, genomes,
# validation reports). Reproducible from the image + prompt_version, and every
# run writes a new set. The fixtures/ directory IS tracked: replay inputs are
# test material, not output.
ai/cake_genome/output/

# Secrets — nothing credential-bearing is tracked today (verified), and this
# keeps it that way now the repo is on GitHub and deploys to a VPS.
# CLAUDE.md rule: SHOPIFY_TOKEN and every API key come from the environment.
.env
.env.*
*.pem
*.key
*_token
*_secret
.shopify/

# Stray images at repo root. ai/vision/images/ is the smoke-test location and
# is allowlisted to 1-3.png on purpose (see its README: "not a dataset store").
# Root-level images are neither source nor sample — ignored, not deleted.
/test-cake.png
/*.png
!ai/vision/images/*.png
