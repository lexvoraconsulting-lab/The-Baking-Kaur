        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"qwen2.5vl\", prompt: \"You are a cake product analyst. Analyze the cake image and return ONLY a JSON object with keys: layers (integer), frosting_type (string), decorations (array of strings), colors (array of strings), quality_score (float 0-1), confidence (float 0-1). No prose.\", images: [$json.image_b64], stream: false, format: \"json\" }) }}",
        "options": {
          "timeout": 120000
        }
