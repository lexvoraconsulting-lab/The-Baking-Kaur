      "id": "4ca3a8ae-e216-401f-948d-e04d0455763d",
      "name": "Qwen Vision (Ollama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1120,
        48
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const t = $('When Called').first().json;\nconst resp = $json || {};\nconst raw = resp.response || '';\nlet v = {};\ntry { v = JSON.parse(raw); } catch (e) { v = {}; }\nconst ok = raw && v && Object.keys(v).length > 0;\nreturn [{ json: {\n  image_id: t.image_id,\n  batch_id: t.batch_id,\n  layers: (v.layers === undefined ? null : v.layers),\n  frosting_type: v.frosting_type || \"\",\n  decorations: JSON.stringify(v.decorations || []),\n  colors: JSON.stringify(v.colors || []),\n  quality_score: (v.quality_score === undefined ? null : v.quality_score),\n  confidence: (v.confidence === undefined ? null : v.confidence),\n  model_version: resp.model || \"qwen2.5vl\",\n  latency_ms: resp.total_duration ? Math.round(resp.total_duration / 1000000) : 0,\n  status: ok ? \"success\" : \"parse_error\",\n  raw_response: raw\n} }];"
      },
