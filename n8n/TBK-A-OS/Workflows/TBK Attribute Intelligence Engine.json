{
  "name": "TBK Attribute Intelligence Engine",
  "nodes": [
    {
      "parameters": {
        "content": "BUILD-305 Attribute Intelligence Engine (deterministic)\n\nConsumes BUILD-304 standardized Vision JSON and normalizes every detected\nattribute against the versioned Taxonomy (single source of truth) via the\nreusable TBK Taxonomy Lookup sub-workflow (id yvbx8ctmtVEI6H2B). Preserves raw\nvalue, confidence, source model, mapping rule and validation status. Unknown\nattributes are never discarded (written to tbk_unmapped_attributes AND a\ncanonical row with validation_status=unmapped). Conflicts on single-valued\nattributes are recorded, not silently overwritten. Output = canonical Attribute\nJSON, the input contract for Product Intelligence, Knowledge Graph, Cake Genome,\nSEO and Shopify workflows. No taxonomy values are hardcoded in Code nodes.",
        "height": 260,
        "width": 520
      },
      "id": "6734aa9f-a8a4-417d-9263-2b0f6ca3c2c3",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        784,
        544
      ]
    },
    {
      "parameters": {
        "content": "AI Validation (optional) — OFF by default\n\nDeterministic mapping is the PRIMARY execution path. This disabled extension\npoint is reserved for later use to improve low-confidence mappings via the\nseparate optional AI Validation sub-workflow. It never runs unless a human\nexplicitly enables it.",
        "width": 360
      },
      "id": "13c815f2-f741-4411-a591-10c0d28f39d2",
      "name": "AI Note",
      "type": "n8n-nodes-base.stickyNote",
