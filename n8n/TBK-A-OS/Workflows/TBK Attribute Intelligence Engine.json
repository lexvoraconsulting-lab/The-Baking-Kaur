    {
      "parameters": {
        "jsCode": "const t = $json || {};\nconst image_id = t.image_id || \"\";\nconst batch_id = t.batch_id || \"\";\nconst taxonomy_version = t.taxonomy_version || \"v1\";\nconst source_model = t.model_version || \"\";\nconst items = [];\nfunction push(attribute_type, raw) {\n  if (raw === undefined || raw === null) return;\n  const v = String(raw).trim();\n  if (!v) return;\n  items.push({ json: { image_id, batch_id, taxonomy_version, source_model, attribute_type, raw_value: v, _empty: false } });\n}\nfunction parseArr(s) { try { const a = JSON.parse(s); return Array.isArray(a) ? a : []; } catch (e) { return []; } }\npush(\"frosting_type\", t.frosting_type);\nparseArr(t.decorations).forEach(function (d) { push(\"decoration\", d); });\nparseArr(t.colors).forEach(function (c) { push(\"color\", c); });\nif (items.length === 0) {\n  items.push({ json: { image_id, batch_id, taxonomy_version, source_model, attribute_type: \"\", raw_value: \"\", _empty: true } });\n}\nreturn items;"
      },
