    {
      "parameters": {
        "jsCode": "const recs = $(\"Classify Result\").all().map(function (i) { return i.json; });\nconst kept = recs.filter(function (r) { return !r._conflict_loser; });\nconst attributes = kept.map(function (r) {\n  return {\n    attribute_type: r.attribute_type,\n    raw_value: r.raw_value,\n    canonical_id: r.canonical_id,\n    normalized_value: r.normalized_value,\n    confidence: r.confidence,\n    mapping_rule: r.mapping_rule,\n    validation_status: r.validation_status,\n    conflict_flag: r.conflict_flag\n  };\n});\nconst mapped = kept.filter(function (r) { return r.matched; }).length;\nconst unmapped = kept.filter(function (r) { return !r.matched; }).length;\nconst conflicts = recs.filter(function (r) { return r._conflict_loser; }).length;\nconst first = recs[0] || {};\nreturn [{ json: {\n  image_id: first.image_id || \"\",\n  batch_id: first.batch_id || \"\",\n  taxonomy_version: first.taxonomy_version || \"v1\",\n  attributes: attributes,\n  counts: { mapped: mapped, unmapped: unmapped, conflicts: conflicts },\n  source_model: first.source_model || \"\",\n  created_by: \"TBK_Attribute_Intelligence\"\n} }];"
      },
