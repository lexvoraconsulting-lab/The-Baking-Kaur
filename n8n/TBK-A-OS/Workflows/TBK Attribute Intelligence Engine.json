      "id": "70efa50b-dbef-4805-8cc0-d308ab98b40c",
      "name": "Taxonomy Lookup",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const lookups = $input.all().map(function (i) { return i.json; });\nconst src = $(\"Explode Attributes\").all().map(function (i) { return i.json; }).filter(function (r) { return r && r._empty !== true; });\n// Structural config (NOT taxonomy data): which attribute types are single-valued and therefore conflict-eligible.\nconst SINGLE_VALUED = [\"frosting_type\"];\nconst now = new Date().toISOString();\nconst recs = lookups.map(function (lk, idx) {\n  const s = src[idx] || {};\n  const matched = !!lk.matched;\n  const conf = Number(lk.confidence) || 0;\n  const raw = (lk.raw_value !== undefined ? lk.raw_value : s.raw_value) || \"\";\n  const normalized = (lk.normalized_value !== undefined && lk.normalized_value !== \"\") ? lk.normalized_value : raw;\n  return {\n    image_id: s.image_id || \"\",\n    batch_id: s.batch_id || \"\",\n    taxonomy_version: s.taxonomy_version || lk.taxonomy_version || \"v1\",\n    attribute_type: lk.attribute_type || s.attribute_type || \"\",\n    raw_value: raw,\n    canonical_id: matched ? (lk.canonical_id || \"\") : \"\",\n    normalized_value: normalized,\n    confidence: matched ? conf : 0,\n    source_model: s.source_model || \"\",\n    mapping_rule: lk.mapping_rule || \"none\",\n    matched: matched,\n    conflict_flag: false,\n    _unmatched: !matched,\n    _conflict_loser: false,\n    created_by: \"TBK_Attribute_Intelligence\",\n    validation_status: matched ? (conf >= 0.85 ? \"auto_validated\" : \"low_confidence\") : \"unmapped\",\n    occurrence_count: 1,\n    status: \"pending_review\",\n    suggested_canonical_id: \"\",\n    first_seen: now,\n    last_seen: now,\n    detected_date: now,\n    existing_value: \"\",\n    existing_confidence: 0,\n    incoming_value: \"\",\n    incoming_confidence: 0,\n    resolution: \"\"\n  };\n});\nSINGLE_VALUED.forEach(function (type) {\n  const group = recs.filter(function (r) { return r.attribute_type === type && r.matched; });\n  const distinct = [];\n  group.forEach(function (r) { if (distinct.indexOf(r.canonical_id) === -1) distinct.push(r.canonical_id); });\n  if (group.length > 1 && distinct.length > 1) {\n    let winner = group[0];\n    group.forEach(function (r) { if (r.confidence > winner.confidence) winner = r; });\n    winner.conflict_flag = true;\n    group.forEach(function (r) {\n      if (r !== winner) {\n        r._conflict_loser = true;\n        r.existing_value = winner.normalized_value;\n        r.existing_confidence = winner.confidence;\n        r.incoming_value = r.normalized_value;\n        r.incoming_confidence = r.confidence;\n        r.resolution = \"kept_higher_confidence\";\n      }\n    });\n  }\n});\nreturn recs.map(function (r) { return { json: r }; });"
      },
