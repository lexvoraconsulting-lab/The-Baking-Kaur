{% if collection.handle == 'birthday-cakes' %}
<section class="tbk-birthday-v4" aria-label="Birthday Collection">
  <div class="tbk-birthday-hero"><img src="https://cdn.shopify.com/s/files/1/0667/9930/4873/files/tbk-birthday-collection.jpg?v=1787081306" alt="Birthday Collection - The Baking Kaur Meerut" loading="eager" fetchpriority="high"></div>
  <div class="tbk-birthday-inner">
    <div class="tbk-birthday-heading"><span>OUR SPECIALS</span><h2>Explore Birthday Cakes</h2><div class="tbk-heart">♡</div></div>
    <div class="tbk-birthday-grid">
      {% assign card_handles = 'designer-theme-cakes,birthday-cakes,cake-hampers,flowers-cake-combos,cake-hampers,designer-theme-cakes,wedding-cakes,anniversary-cakes,birthday-cakes' | split: ',' %}
      {% assign card_names = 'Designer Cakes,Chocolate Cakes,Celebration Hampers,Flowers,Hampers,Theme Cakes,Wedding,Anniversary,Birthday' | split: ',' %}
      {% for handle in card_handles %}{% assign i = forloop.index0 %}{% assign card = collections[handle] %}<a class="tbk-birthday-card" style="--i:{{ i }}" href="{{ card.url | default: '/collections/birthday-cakes' }}" aria-label="{{ card_names[i] }}"> <span class="tbk-sr">{{ card_names[i] }}</span></a>{% endfor %}
    </div>
    <div class="tbk-benefits">
      <div><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 42C14 35 7 27 9 18c1-5 6-8 11-5 2 1 3 3 4 5 1-2 2-4 4-5 5-3 10 0 11 5 2 9-5 17-15 24Z"/><path d="M24 18c-2 6-4 11-9 16M24 24c4-2 7-5 9-9"/></svg><div><b>100% EGGLESS</b><small>Pure veg & eggless cakes</small></div></div>
      <div><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 25h32M12 25v10h24V25M16 20c0-5 4-8 8-8s8 3 8 8M21 12c-1-3 1-6 4-6"/><path d="M8 35h32"/></svg><div><b>FRESHLY BAKED</b><small>Made with premium ingredients</small></div></div>
      <div><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M5 31h28V18H5zM33 23h6l5 6v2H33zM12 38a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM37 38a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/></svg><div><b>ON TIME DELIVERY</b><small>Same day & midnight delivery</small></div></div>
      <div><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 42s-4-4-10-4c-5 0-8-3-8-8 0-4 3-7 7-7 2 0 4 1 5 2-1-5 2-10 7-10s8 5 7 10c1-1 3-2 5-2 4 0 7 3 7 7 0 5-3 8-8 8-6 0-10 4-10 4Z"/></svg><div><b>CUSTOM MADE</b><small>Design it, we bake it</small></div></div>
    </div>
  </div>
</section>
<style>
.tbk-birthday-v4{background:#fffdfa;color:#29231f}.tbk-birthday-hero{width:100%;overflow:hidden;background:#f5ebe5}.tbk-birthday-hero img{display:block;width:100%;height:auto}.tbk-birthday-inner{max-width:1440px;margin:0 auto;padding:0 28px 42px}.tbk-birthday-heading{text-align:center;padding:28px 0 20px}.tbk-birthday-heading span{font:700 10px/1 Arial,sans-serif;letter-spacing:.18em;color:#bd908b}.tbk-birthday-heading h2{font:400 30px/1.2 Georgia,serif;margin:7px 0 8px;color:#28221f}.tbk-heart{font:28px/1 Georgia,serif;color:#d98b91;position:relative}.tbk-heart:before,.tbk-heart:after{content:'';display:inline-block;width:42px;border-top:1px solid #e5c1bf;vertical-align:middle;margin:0 9px 7px}.tbk-birthday-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.tbk-birthday-card{display:block;width:100%;aspect-ratio:600/803;background-image:url('data:image/webp;base64,');background-size:100% auto;background-position:center calc(var(--i) * -12.5%);background-repeat:no-repeat;border-radius:9px;overflow:hidden;box-shadow:0 2px 8px rgba(75,45,40,.07);transition:transform .2s ease,box-shadow .2s ease}.tbk-birthday-card:hover{transform:translateY(-2px);box-shadow:0 7px 18px rgba(75,45,40,.12)}.tbk-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.tbk-benefits{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;padding:28px 12px 0;margin-top:8px;border-top:1px solid #f0e8e4}.tbk-benefits>div{display:flex;align-items:center;justify-content:center;gap:12px}.tbk-benefits svg{width:43px;height:43px;fill:none;stroke:#ad8a84;stroke-width:1.45;stroke-linecap:round;stroke-linejoin:round;flex:none}.tbk-benefits b{display:block;font:600 12px/1.2 Arial,sans-serif;letter-spacing:.07em;color:#2c2927}.tbk-benefits small{display:block;font:400 10px/1.45 Arial,sans-serif;color:#746c68;margin-top:4px}.tbk-benefits>div:nth-child(1) svg{stroke:#b58f88}.tbk-benefits>div:nth-child(2) svg{stroke:#b58f88}.tbk-benefits>div:nth-child(3) svg{stroke:#b58f88}.tbk-benefits>div:nth-child(4) svg{stroke:#b58f88}@media(max-width:900px){.tbk-birthday-inner{padding:0 14px 30px}.tbk-birthday-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.tbk-benefits{grid-template-columns:repeat(2,1fr);gap:18px 8px}.tbk-benefits>div{justify-content:flex-start}}@media(max-width:560px){.tbk-birthday-heading{padding:20px 0 13px}.tbk-birthday-heading h2{font-size:24px}.tbk-birthday-grid{gap:8px}.tbk-benefits{grid-template-columns:1fr;padding:22px 8px 0}.tbk-benefits>div{justify-content:flex-start}.tbk-benefits b{font-size:11px}.tbk-benefits small{font-size:9px}}
</style>
</section>
{% endif %}
{% schema %}{"name":"Birthday Collection V4","settings":[],"presets":[{"name":"Birthday Collection V4"}]}{% endschema %}