<section class="tbk-theme-products" aria-label="Theme Cakes"><div class="tbk-theme-products__inner"><div class="tbk-theme-products__eyebrow">OUR THEME CAKE COLLECTION</div><h2>Theme Cakes</h2><div class="tbk-theme-products__heart">♡</div>{% paginate collection.products by 24 %}{% if collection.products_count > 0 %}<div class="tbk-theme-grid">{% for product in collection.products %}<article class="tbk-theme-card"><a href="{{ product.url }}" class="tbk-theme-card__image" aria-label="{{ product.title | escape }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '360,540,700', sizes: '(max-width: 749px) 50vw, 25vw', alt: product.featured_image.alt | default: product.title }}{% endif %}</a><div class="tbk-theme-card__body"><h3><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="tbk-theme-card__price">{{ product.price | money }}</div><a class="tbk-theme-card__cta" href="{{ product.url }}">EXPLORE →</a></div></article>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="tbk-theme-pagination" aria-label="Theme products pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% else %}<p class="tbk-theme-empty">Theme cakes will appear here.</p>{% endif %}{% endpaginate %}</div></section><style>.tbk-theme-products{background:#fffdfa;padding:44px 20px 64px}.tbk-theme-products__inner{max-width:1280px;margin:0 auto}.tbk-theme-products__eyebrow{text-align:center;letter-spacing:.18em;font-size:12px;color:#b98587;font-weight:600;margin-bottom:8px}.tbk-theme-products h2{text-align:center;font-family:Georgia,serif;font-size:clamp(30px,4vw,48px);font-weight:400;margin:0;color:#2d2523}.tbk-theme-products__heart{text-align:center;color:#c98286;font-size:30px;line-height:1;margin:12px 0 28px}.tbk-theme-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.tbk-theme-card{background:#fff;border:1px solid #eee4df;border-radius:14px;overflow:hidden;box-shadow:0 5px 18px rgba(70,45,35,.06)}.tbk-theme-card__image{display:block;aspect-ratio:1/1;overflow:hidden;background:#f7f2ee}.tbk-theme-card__image img{display:block;width:100%;height:100%;object-fit:cover}.tbk-theme-card__body{text-align:center;padding:16px 12px 18px}.tbk-theme-card h3{font-size:16px;line-height:1.35;margin:0 0 8px}.tbk-theme-card h3 a{color:#302825;text-decoration:none}.tbk-theme-card__price{font-weight:600;margin-bottom:12px;color:#7e4e50}.tbk-theme-card__cta{display:inline-block;color:#b56e72;border:1px solid #e7c7c8;border-radius:5px;padding:8px 18px;font-size:12px;font-weight:700;letter-spacing:.08em;text-decoration:none}.tbk-theme-pagination{text-align:center;margin-top:32px}.tbk-theme-pagination a{margin:0 5px}@media(max-width:900px){.tbk-theme-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}}@media(max-width:520px){.tbk-theme-products{padding:32px 12px 48px}.tbk-theme-grid{gap:10px}.tbk-theme-card__body{padding:12px 8px 14px}.tbk-theme-card h3{font-size:14px}.tbk-theme-card__cta{padding:7px 12px;font-size:11px}}</style>{% schema %}{"name":"TBK Theme Products","settings":[],"presets":[{"name":"TBK Theme Products"}]}{% endschema %}