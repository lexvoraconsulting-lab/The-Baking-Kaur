{%- assign blog_articles = blog.articles -%}<section class="tbk-blog-hub" aria-labelledby="tbk-blog-title"><div class="tbk-blog-hub__container"><nav class="tbk-blog-breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>{{ blog.title }}</span></nav><header class="tbk-blog-hero"><div class="tbk-blog-hero__copy"><p class="tbk-blog-eyebrow">TBK JOURNAL</p><h1 id="tbk-blog-title">Cakes, Gifting &amp; Celebration Guides in Meerut</h1><p class="tbk-blog-intro">Practical cake guides, celebration ideas, gifting inspiration and Meerut delivery advice from The Baking Kaur.</p><nav class="tbk-blog-topics" aria-label="Blog topics"><a class="is-active" href="{{ blog.url }}">All</a><a href="{{ blog.url }}/tagged/Birthday%20Cakes">Birthday</a><a href="{{ blog.url }}/tagged/Anniversary">Anniversary</a><a href="{{ blog.url }}/tagged/Wedding">Wedding</a><a href="{{ blog.url }}/tagged/Designer%20Cakes">Designer Cakes</a><a href="{{ blog.url }}/tagged/Meerut">Meerut</a><a href="{{ blog.url }}/tagged/Gifting">Gifting</a><a href="{{ blog.url }}/tagged/Cake%20Delivery%20Meerut">Delivery</a></nav></div><div class="tbk-blog-hero__media"><img src="https://cdn.shopify.com/s/files/1/0667/9930/4873/files/tbk-journal-premium-hero-v2.png?v=1786985816" alt="Premium cake and celebration editorial scene for The Baking Kaur Journal in Meerut" width="1698" height="926" fetchpriority="high"></div></header><section class="tbk-blog-latest" aria-labelledby="tbk-latest-title"><div class="tbk-blog-section-heading"><h2 id="tbk-latest-title">Latest Guides &amp; Articles</h2><a href="{{ blog.url }}">View all articles →</a></div><div class="tbk-blog-grid">{%- for article in blog_articles limit:4 -%}<article class="tbk-blog-card">{%- if article.image -%}<a href="{{ article.url }}" class="tbk-blog-card__image"><img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" loading="lazy" width="900" height="600"></a>{%- endif -%}<div class="tbk-blog-card__body">{%- if article.tags.size > 0 -%}<span class="tbk-blog-card__tag">{{ article.tags.first | escape }}</span>{%- endif -%}<h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><p>{{ article.summary | strip_html | truncate: 150 }}</p><div class="tbk-blog-meta"><span>{{ article.published_at | date: '%b %d, %Y' }}</span><span>•</span><span>Guide</span></div><a class="tbk-blog-card__link" href="{{ article.url }}">Read the guide →</a></div></article>{%- else -%}<p>No guides are published yet.</p>{%- endfor -%}</div></section></div></section><style>.tbk-blog-hub{background:#fff;padding:24px 0 64px}.tbk-blog-hub__container{width:min(1180px,calc(100% - 32px));margin:auto}.tbk-blog-breadcrumbs{display:flex;gap:8px;font-size:12px;color:#777;margin:0 0 22px}.tbk-blog-breadcrumbs a{text-decoration:none}.tbk-blog-hero{display:grid;grid-template-columns:1fr 1fr;min-height:390px;overflow:hidden;border-radius:24px;background:#fbf2f4;margin-bottom:48px}.tbk-blog-hero__copy{padding:58px 46px 48px;display:flex;flex-direction:column;justify-content:center}.tbk-blog-eyebrow{font-size:11px;letter-spacing:.16em;font-weight:700;margin:0 0 14px;color:#a30051}.tbk-blog-hub h1{font-family:Georgia,serif;font-size:clamp(36px,4.1vw,58px);line-height:1.05;margin:0 0 18px;color:#222}.tbk-blog-intro{font-size:17px;line-height:1.65;max-width:620px;margin:0 0 28px;color:#4d4d4d}.tbk-blog-hero__media{min-height:390px;position:relative;overflow:hidden;width:100%;min-width:0}.tbk-blog-hero__media img{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;max-width:none!important;min-width:100%!important;object-fit:cover!important;display:block!important}.tbk-blog-topics{display:flex;flex-wrap:wrap;gap:8px}.tbk-blog-topics a{padding:9px 13px;border:1px solid rgba(163,0,81,.18);border-radius:999px;text-decoration:none;font-size:12px;white-space:nowrap;background:#fff}.tbk-blog-topics a.is-active{background:#b00059;color:#fff;border-color:#b00059}.tbk-blog-section-heading{display:flex;align-items:center;justify-content:space-between;margin:0 0 20px}.tbk-blog-section-heading h2{font-family:Georgia,serif;font-size:28px;margin:0;color:#222}.tbk-blog-section-heading a{font-size:13px;font-weight:700;text-decoration:none;color:#a30051}.tbk-blog-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.tbk-blog-card{border:1px solid rgba(0,0,0,.09);border-radius:16px;overflow:hidden;background:#fff;box-shadow:0 8px 26px rgba(0,0,0,.05)}.tbk-blog-card__image{display:block;aspect-ratio:3/2;overflow:hidden;background:#f5f5f5}.tbk-blog-card__image img{width:100%;height:100%;object-fit:cover;display:block}.tbk-blog-card__body{padding:18px}.tbk-blog-card__tag{font-size:10px;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:#b00059}.tbk-blog-card h3{font-size:18px;line-height:1.25;margin:8px 0}.tbk-blog-card h3 a{text-decoration:none;color:#252525}.tbk-blog-card p{font-size:13px;line-height:1.55;color:#666;margin:0 0 10px}.tbk-blog-meta{display:flex;gap:7px;font-size:10px;color:#888;margin-bottom:12px}.tbk-blog-card__link{font-size:12px;font-weight:700;text-decoration:none;color:#a30051}@media(max-width:900px){.tbk-blog-hero{grid-template-columns:1fr}.tbk-blog-hero__copy{padding:36px 28px}.tbk-blog-hero__media{min-height:300px}.tbk-blog-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:749px){.tbk-blog-hub__container{width:calc(100% - 24px)}.tbk-blog-hub{padding:18px 0 44px}.tbk-blog-hero{border-radius:18px;margin-bottom:32px}.tbk-blog-hero__copy{padding:28px 20px 22px}.tbk-blog-hub h1{font-size:34px}.tbk-blog-intro{font-size:14px;line-height:1.55;margin-bottom:20px}.tbk-blog-topics{overflow:auto;flex-wrap:nowrap;padding-bottom:5px;scrollbar-width:none}.tbk-blog-topics::-webkit-scrollbar{display:none}.tbk-blog-topics a{flex:0 0 auto}.tbk-blog-hero__media{min-height:250px;height:280px}.tbk-blog-section-heading h2{font-size:24px}.tbk-blog-section-heading a{font-size:12px}.tbk-blog-grid{grid-template-columns:1fr;gap:16px}.tbk-blog-card{display:grid;grid-template-columns:38% 62%}.tbk-blog-card__image{aspect-ratio:1/1}.tbk-blog-card__body{padding:14px}.tbk-blog-card h3{font-size:17px;margin:6px 0}.tbk-blog-card p{font-size:12px;line-height:1.45}.tbk-blog-meta{font-size:9px}}</style>{% schema %}{"name":"TBK Premium Blog Hub","settings":[]}{% endschema %}