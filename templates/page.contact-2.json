    "custom_liquid_RFqxXP": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-contact-text\">\n\n  <h2><h2>Get in Touch for Custom Cake Orders in Meerut</h2>\n</h2>\n\n  <p>\n    Looking for a trusted <strong>luxury cake bakery in Meerut</strong>? \n    <strong>The Baking Kaur</strong> specialises in premium, made-to-order cakes \n    for weddings, birthdays, anniversaries, and special celebrations across \n    <strong>Meerut, Uttar Pradesh</strong>.\n  </p>\n\n  <p>\n    Every cake is freshly baked using <strong>high-quality ingredients</strong>, \n    crafted with attention to detail, and designed to reflect your taste, theme, \n    and occasion. We proudly offer <strong>100% eggless luxury cakes</strong> with \n    reliable same-day and scheduled delivery.\n  </p>\n\n  <h3>Why Customers Choose The Baking Kaur</h3>\n\n  <ul class=\"tbk-contact-list\">\n    <li>Made-to-order luxury cakes with premium ingredients</li>\n    <li>Expertise in wedding, birthday, and designer cakes</li>\n    <li>100% eggless options with balanced flavours</li>\n    <li>Strict hygiene standards and professional baking practices</li>\n    <li>Reliable same-day and scheduled delivery across Meerut</li>\n  </ul>\n\n  <p>\n    Whether you are planning a grand wedding cake, a customised birthday cake, \n    or an elegant anniversary dessert, our team is here to help you create \n    something truly memorable.\n  </p>\n\n</div>\n\n<style>\n.tbk-contact-text {\n  max-width: 900px;\n  margin: 0 auto;\n  font-size: 15px;\n  line-height: 1.8;\n  color: #4a",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
    },
