    "custom_liquid_8dqbBf": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-contact-faq\">\n\n  <h2>Contact & Ordering FAQs</h2>\n\n  <div class=\"tbk-faq-item\">\n    <h3>How can I contact The Baking Kaur for a custom cake?</h3>\n    <p>\n      You can contact us via WhatsApp, phone call, or by submitting the enquiry form on this page.\n      Our team responds promptly to help you with custom cake orders in Meerut.\n    </p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Do you accept same-day cake orders in Meerut?</h3>\n    <p>\n      Yes, same-day orders may be available for select cake designs.\n      We recommend contacting us via WhatsApp for quick confirmation.\n    </p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>What details should I share when contacting you?</h3>\n    <p>\n      Please share the occasion, delivery or pickup date, cake weight, preferred flavour,\n      design reference (if any), and your location in Meerut.\n    </p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Do you deliver cakes across all areas of Meerut?</h3>\n    <p>\n      Yes, we provide cake delivery across major areas of Meerut.\n      Delivery availability depends on order type and time slot.\n    </p>\n  </div>\n\n</div>\n\n<style>\n.tbk-contact-faq {\n  max-width: 800px;\n  margin: 60px auto;\n  padding: 0 20px;\n}\n\n.tbk-contact-faq h2 {\n  font-size: 22px;\n  text-align: center;\n  margin-bottom: 26px;\n}\n\n.tbk-faq-item {\n  margin-bottom: 20px;\n}\n\n.tbk-faq-item h3 {\n  font-size: 16px;\n  margin-bottom: 6px;\n}\n\n.",
        "color_scheme": "",
