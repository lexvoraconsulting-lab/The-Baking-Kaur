    "custom_liquid_dh4TQC": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-contact-form-wrapper\">\n\n  <h2>Get in Touch with The Baking Kaur</h2>\n\n  <p class=\"tbk-contact-form-text\">\n    Planning a wedding, birthday, anniversary, or special celebration in\n    <strong>Meerut, Uttar Pradesh</strong>? Share your requirements below and our\n    team will get back to you with personalised cake options.\n  </p>\n\n  <form method=\"post\" action=\"/contact#contact_form\" id=\"contact_form\" accept-charset=\"UTF-8\">\n    <input type=\"hidden\" name=\"form_type\" value=\"contact\">\n    <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n\n    <div class=\"tbk-form-group\">\n      <input type=\"text\" name=\"contact[name]\" placeholder=\"Your Name *\" required>\n    </div>\n\n    <div class=\"tbk-form-group\">\n      <input type=\"email\" name=\"contact[email]\" placeholder=\"Your Email *\" required>\n    </div>\n\n    <div class=\"tbk-form-group\">\n      <input type=\"tel\" name=\"contact[phone]\" placeholder=\"Your Phone / WhatsApp Number *\" required>\n    </div>\n\n    <div class=\"tbk-form-group\">\n      <textarea name=\"contact[body]\" rows=\"5\" placeholder=\"Tell us about your cake requirement (occasion, date, flavour, weight) *\" required></textarea>\n    </div>\n\n    <button type=\"submit\" class=\"tbk-form-submit\">\n      Submit Enquiry\n    </button>\n  </form>\n\n</div>\n\n<style>\n.tbk-contact-form-wrapper {\n  max-width: 720px;\n  margin: 70px auto;\n  padding: 0 20px;\n  text-align: center;\n}\n\n.tbk-contact-form-wrapper h2 {\n  font-size: 24px;\n  margin-bottom: 12px;\n}\n\n.tbk-contact-form-text {\n  font-size: 15px;\n  line-height: 1.7;\n  color: #4a4a4a;\n  margin-bottom: 30px;\n}\n\n.tbk-form-group {\n  margin-bottom: 16px;\n}\n\n.tbk-form-group input,\n.tbk-form-group textarea {\n  width: 100%;\n  padding: 14px;\n  font-size: 14px;\n  border: 1px solid #ddd;\n  border-radius: 6px;\n}\n\n.tbk-form-group input:focus,\n.tbk-form-group textarea:focus {\n  outline: none;\n  border-color: #7a1f3d;\n}\n\n.tbk-form-submit {\n  background: #7a1f3d;\n  color: #fff;\n  padding: 14px 30px;\n  border: none;\n  border-radius: 6px;\n  font-size: 15px;\n  cursor: pointer;\n}\n\n.tbk-form-submit:hover {\n  opacity: 0.9;\n}\n\n/* Mobile */\n@media (max-width: 768px) {\n  .tbk-contact-form-wrapper h2 {\n    font-size: 20px;\n  }\n}\n</style>",
