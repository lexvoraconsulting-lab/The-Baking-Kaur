    "custom_liquid_LkxWDU": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-faq-wrapper\">\n  <h2 class=\"tbk-faq-heading\">Frequently Asked Questions</h2>\n\n  <div class=\"tbk-faq-item\">\n    <h3>How can I contact The Baking Kaur?</h3>\n    <p>You can contact The Baking Kaur by phone, WhatsApp, email, or by visiting our store in Meerut. For quick responses and custom cake discussions, WhatsApp is the fastest option.</p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Do you offer same-day cake delivery in Meerut?</h3>\n    <p>Yes, we offer same-day and scheduled cake delivery across Meerut, Uttar Pradesh, depending on cake design, size, and availability.</p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Where is The Baking Kaur bakery located?</h3>\n    <p>Our bakery is located at Fateh Complex, Thapar Nagar – Lane No. 7, Meerut, Uttar Pradesh – 250001. Store visits are welcome during business hours.</p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>What are your store opening hours?</h3>\n    <p>We are open every day from 10:00 AM to Midnight (12:00 AM) for both in-store visits and order pickups.</p>\n  </div>\n\n  <div class=\"tbk-faq-item\">\n    <h3>Can I discuss a custom cake order before placing it?</h3>\n    <p>Absolutely. We encourage customers to contact us before placing a custom cake order so we can understand your design, flavour, and delivery requirements.</p>\n  </div>\n\n</div>\n\n<style>\n.tbk-faq-wrapper {\n  max-width: 900px;\n  margin: 60px auto;\n  padding: 20px;\n}\n\n.tbk-faq-heading {\n  text-align: center;\n  font-size: 26px;\n  margin-bottom: 30px;\n}\n\n.tbk-faq-item {\n  margin-bottom: 20px;\n}\n\n.tbk-faq-item h3 {\n  font-size: 16px;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.tbk-faq-item p {\n  font-size: 15px;\n  line-height: 1.7;\n  color: #4a4a4a;\n}\n</style>",
        "color_scheme": "",
        "padding_top": 40,
