    "custom_liquid_mfcNcg": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-contact-details\">\n\n  <h2>Visit Our Luxury Cake Bakery in Meerut</h2>\n\n  <ul class=\"tbk-contact-list\">\n    <li>\n      <strong>📍 Address:</strong><br>\n      Fateh Complex, Thapar Nagar – Lane No. 7,<br>\n      Meerut, Uttar Pradesh – 250001\n    </li>\n\n    <li>\n      <strong>📞 Phone:</strong><br>\n      <a href=\"tel:+91\">+91 82188 62928</a>\n    </li>\n\n    <li>\n      <strong>💬 WhatsApp:</strong><br>\n      <a href=\"https://wa.me/91?text=Hi%20The%20Baking%20Kaur%2C%20I%20want%20to%20order%20a%20custom%20cake.\" target=\"_blank\">\n        Chat with us on WhatsApp\n      </a>\n    </li>\n\n    <li>\n      <strong>📧 Email:</strong><br>\n      <a href=\"mailto:thebakingkaur@gmail.com\">thebakingkaur@gmail.com</a>\n    </li>\n\n    <li>\n      <strong>⏰ Store Timings:</strong><br>\n      Open daily from <strong>10:00 AM to 12:00 Midnight</strong>\n    </li>\n  </ul>\n\n</div>\n\n<style>\n.tbk-contact-details {\n  max-width: 800px;\n  margin: 50px auto;\n  padding: 0 20px;\n}\n\n.tbk-contact-details h2 {\n  font-size: 22px;\n  margin-bottom: 18px;\n}\n\n.tbk-contact-list {\n  list-style: none;\n  padding: 0;\n}\n\n.tbk-contact-list li {\n  margin-bottom: 18px;\n  font-size: 15px;\n  line-height: 1.7;\n  color: #4a4a4a;\n}\n\n.tbk-contact-list a {\n  color: #7a1f3d;\n  text-decoration: none;\n  font-weight: 500;\n}\n\n.tbk-contact-list a:hover {\n  text-decoration: underline;\n}\n</style>",
        "color_scheme": "",
