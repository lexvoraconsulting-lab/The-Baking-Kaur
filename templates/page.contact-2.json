    "custom_liquid_DjBiJi": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div class=\"tbk-faq-wrapper\">\n  <h2>Contact & Delivery FAQs</h2>\n\n  <details>\n    <summary>Do you offer late-night cake delivery in Meerut?</summary>\n    <p>Yes, we provide late-night and midnight cake delivery in Meerut for birthdays, anniversaries, and special celebrations.</p>\n  </details>\n\n  <details>\n    <summary>Do you provide surprise cake delivery?</summary>\n    <p>Yes, we specialise in surprise cake delivery including doorstep surprises and midnight celebrations.</p>\n  </details>\n\n  <details>\n    <summary>Is doorstep cake delivery available?</summary>\n    <p>Yes, all cakes are delivered safely to your doorstep anywhere in Meerut with hygienic packaging.</p>\n  </details>\n\n  <details>\n    <summary>Do you offer same-day cake delivery?</summary>\n    <p>Same-day cake delivery is available in Meerut depending on cake design and availability.</p>\n  </details>\n\n  <details>\n    <summary>How can I contact The Baking Kaur?</summary>\n    <p>You can contact us via WhatsApp, phone, email, or by visiting our bakery in Meerut.</p>\n  </details>\n</div>\n\n<style>\n.tbk-faq-wrapper {\n  max-width: 900px;\n  margin: 40px auto;\n  padding: 10px;\n}\n.tbk-faq-wrapper h2 {\n  margin-bottom: 20px;\n}\n.tbk-faq-wrapper details {\n  margin-bottom: 12px;\n}\n.tbk-faq-wrapper summary {\n  font-weight: 600;\n  cursor: pointer;\n}\n</style>",
