    "faq_section": {
      "type": "accordion",
      "blocks": {
        "faq_1": {
          "type": "accordion_item",
          "settings": {
            "heading": "Do you deliver cakes in Meerut?",
            "richtext": "<p>Yes, we deliver cakes and celebration hampers across Meerut with same-day delivery available for orders placed before 12 PM.</p>"
          }
        },
        "faq_2": {
          "type": "accordion_item",
          "settings": {
            "heading": "Can I order a custom cake?",
            "richtext": "<p>Absolutely! Share your inspiration via Pinterest, Instagram, or reference images on WhatsApp and we'll create a custom design based on your theme, colours, and preferences.</p>"
          }
        },
        "faq_3": {
          "type": "accordion_item",
          "settings": {
            "heading": "Do you offer midnight delivery?",
            "richtext": "<p>Yes, we offer midnight surprise delivery for birthdays and anniversaries. Contact us on WhatsApp to book your midnight celebration.</p>"
          }
        },
        "faq_4": {
          "type": "accordion_item",
          "settings": {
            "heading": "Can I combine cakes with flowers and balloons?",
            "richtext": "<p>Yes! We offer premium gift combinations: Cake + Flowers, Cake + Balloons, and Cake + Flowers + Balloons. Perfect for surprise deliveries.</p>"
          }
        },
        "faq_5": {
          "type": "accordion_item",
          "settings": {
            "heading": "How do I place a custom cake order?",
            "richtext": "<p>Share your cake inspiration on WhatsApp at +91-8218862928, discuss design details with our team, confirm sizing and flavour, and we'll prepare it fresh for your celebration.</p>"
          }
        }
      },
      "block_order": ["faq_1", "faq_2", "faq_3", "faq_4", "faq_5"],
