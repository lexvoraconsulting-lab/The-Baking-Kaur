        },
        "f4": {
          "type": "accordion_item",
          "settings": {
            "title": "Can I combine cakes with flowers or balloons?",
            "content": "Yes. We offer combinations of cake with flowers, cake with balloons, and cake with both — ideal for surprise deliveries."
