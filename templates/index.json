          "type": "accordion_item",
          "settings": {
            "title": "Can I order a custom cake?",
            "content": "Yes. Share your inspiration on WhatsApp and we'll create a design based on your theme, colours and preferences."
          }
        },
        "f3": {
          "type": "accordion_item",
          "settings": {
            "title": "Do you offer midnight delivery?",
            "content": "Yes, we offer midnight surprise delivery for birthdays and anniversaries. Contact us on WhatsApp to book one."
