    "custom_liquid_Jk7Yjj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div style=\"text-align:center;padding:60px 20px;max-width:1100px;margin:auto;\">\n\n<h1 style=\"\nfont-size:56px;\nfont-weight:700;\ncolor:#6a003c;\nline-height:1.2;\nmargin-bottom:20px;\">\nMeerut's Trusted Eggless Celebration Brand\n</h1>\n\n<p style=\"\nfont-size:20px;\ncolor:#555;\nmax-width:850px;\nmargin:0 auto 30px auto;\nline-height:1.8;\">\n100% Eggless Custom Cakes • Pinterest-to-Reality Designs • Luxury Hampers • Wedding Cakes • Flowers • Midnight Surprise Deliveries\n</p>\n\n<div style=\"margin-bottom:25px;\">\n\n<a href=\"https://wa.me/918218862928\"\nstyle=\"\ndisplay:inline-block;\nbackground:#25D366;\ncolor:white;\npadding:15px 30px;\ntext-decoration:none;\nborder-radius:8px;\nfont-weight:600;\nmargin:5px;\">\nOrder on WhatsApp\n</a>\n\n<a href=\"/collections/all\"\nstyle=\"\ndisplay:inline-block;\nbackground:#6a003c;\ncolor:white;\npadding:15px 30px;\ntext-decoration:none;\nborder-radius:8px;\nfont-weight:600;\nmargin:5px;\">\nExplore Collections\n</a>\n\n</div>\n\n<div style=\"\nmargin-top:20px;\ndisplay:inline-block;\npadding:14px 22px;\nbackground:#f8f4f2;\nborder-radius:10px;\nfont-size:16px;\nfont-weight:600;\ncolor:#6a003c;\">\n⭐ 4.8 Google Rating · 🎂 10,000+ Celebrations Served\n</div>\n\n<div style=\"\ndisplay:flex;\nflex-wrap:wrap;\njustify-content:center;\ngap:12px;\nmargin-top:25px;\">\n\n<div style=\"padding:12px 18px;background:#f8f4f2;border-radius:8px;font-weight:500;\">\n🎂 100% Eggless\n</div>\n\n<div style=\"padding:12px 18px;background:#f8f4f2;border-radius:8px;font-weight:500;\">\n✨ Freshly Made To Order\n</div>\n\n<div style=\"padding:12px 18px;background:#f8f4f2;border-radius:8px;font-weight:500;\">\n📌 Pinterest To Reality Cakes\n</div>\n\n<div style=\"padding:12px 18px;background:#f8f4f2;border-radius:8px;font-weight:500;\">\n⚡ Same-Day Delivery\n</div>\n\n<div style=\"padding:12px 18px;background:#f8f4f2;border-radius:8px;font-weight:500;\">\n🌙 Midnight Surprise Delivery\n</div>\n\n<div style=\"padding:12px 18px;background:#f8f4f2;border-radius:8px;font-weight:500;\">\n🏆 Since 2018\n</div>\n\n</div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
    },
    "custom_liquid_VtmKQM": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div style=\"max-width:1200px;margin:80px auto;padding:0 20px;text-align:center;\">\n\n<h2 style=\"\nfont-size:48px;\nfont-weight:700;\ncolor:#6a003c;\nmargin-bottom:20px;\">\nPinterest To Reality Cakes\n</h2>\n\n<p style=\"\nfont-size:20px;\ncolor:#555;\nmax-width:900px;\nmargin:0 auto 50px auto;\nline-height:1.8;\">\nSeen a cake on Pinterest, Instagram or Google? Share your inspiration and our team will recreate it with your personal touch, celebration theme and custom preferences.\n</p>\n\n<div style=\"\ndisplay:grid;\ngrid-template-columns:repeat(auto-fit,minmax(240px,1fr));\ngap:20px;\nmax-width:1100px;\nmargin:0 auto;\">\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 25px;\nborder-radius:16px;\nmin-height:220px;\nbox-sizing:border-box;\ncursor:pointer;\">\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:28px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\n1. Share Inspiration\n</h3>\n\n<p style=\"\nfont-size:16px;\nline-height:1.7;\ncolor:#555;\">\nSend Pinterest links, Instagram screenshots or reference cake images.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 25px;\nborder-radius:16px;\nmin-height:220px;\nbox-sizing:border-box;\ncursor:pointer;\">\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:28px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\n2. Customize Design\n</h3>\n\n<p style=\"\nfont-size:16px;\nline-height:1.7;\ncolor:#555;\">\nWe adapt the design according to your theme, colours, flavour and occasion.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 25px;\nborder-radius:16px;\nmin-height:220px;\nbox-sizing:border-box;\ncursor:pointer;\">\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:28px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\n3. Fresh Preparation\n</h3>\n\n<p style=\"\nfont-size:16px;\nline-height:1.7;\ncolor:#555;\">\nEach cake is handcrafted fresh using premium ingredients and attention to detail.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 25px;\nborder-radius:16px;\nmin-height:220px;\nbox-sizing:border-box;\ncursor:pointer;\">\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:28px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\n4. Celebrate\n</h3>\n\n<p style=\"\nfont-size:16px;\nline-height:1.7;\ncolor:#555;\">\nDelivered fresh for birthdays, anniversaries, weddings and special celebrations.\n</p>\n\n</div>\n\n</div>\n\n<div style=\"margin-top:50px;\">\n\n<a href=\"https://wa.me/918218862928\"\nstyle=\"\ndisplay:inline-block;\nbackground:#25D366;\ncolor:white;\npadding:16px 32px;\ntext-decoration:none;\nborder-radius:10px;\nfont-weight:600;\nfont-size:16px;\">\nShare Your Cake Inspiration\n</a>\n\n</div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
    },
    "custom_liquid_fa96XH": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div style=\"max-width:1200px;margin:90px auto;padding:0 20px;text-align:center;\">\n\n<h2 style=\"\nfont-size:48px;\nfont-weight:700;\ncolor:#6a003c;\nmargin-bottom:20px;\">\nLuxury Wedding Cakes & Celebrations\n</h2>\n\n<p style=\"\nfont-size:20px;\nline-height:1.8;\ncolor:#555;\nmax-width:900px;\nmargin:0 auto 50px auto;\">\nFrom intimate engagements to grand wedding celebrations, The Baking Kaur creates elegant wedding cakes inspired by your story, theme and vision.\n</p>\n\n<div style=\"\ndisplay:grid;\ngrid-template-columns:repeat(auto-fit,minmax(250px,1fr));\ngap:20px;\nmax-width:1100px;\nmargin:0 auto;\">\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:30px;\nborder-radius:16px;\">\n<h3 style=\"color:#6a003c;font-size:26px;\">💍 Engagement Cakes</h3>\n<p style=\"color:#555;line-height:1.7;\">\nElegant cakes crafted for proposals and engagement celebrations.\n</p>\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:30px;\nborder-radius:16px;\">\n<h3 style=\"color:#6a003c;font-size:26px;\">🎂 Multi-Tier Wedding Cakes</h3>\n<p style=\"color:#555;line-height:1.7;\">\nLuxury wedding cakes designed for grand celebrations and premium venues.\n</p>\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:30px;\nborder-radius:16px;\">\n<h3 style=\"color:#6a003c;font-size:26px;\">🌸 Floral Wedding Cakes</h3>\n<p style=\"color:#555;line-height:1.7;\">\nBeautiful floral-inspired wedding cake designs handcrafted for your special day.\n</p>\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:30px;\nborder-radius:16px;\">\n<h3 style=\"color:#6a003c;font-size:26px;\">🏛 Venue Delivery</h3>\n<p style=\"color:#555;line-height:1.7;\">\nProfessional delivery, setup and coordination for wedding venues.\n</p>\n</div>\n\n</div>\n\n<div style=\"margin-top:50px;\">\n\n<a href=\"/collections/wedding-cakes\"\nstyle=\"\ndisplay:inline-block;\nbackground:#6a003c;\ncolor:white;\npadding:16px 34px;\nborder-radius:10px;\ntext-decoration:none;\nfont-weight:600;\">\nExplore Wedding Cakes\n</a>\n\n</div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
    },
    "custom_liquid_P4crxj": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div style=\"max-width:1200px;margin:90px auto;padding:0 20px;text-align:center;\">\n\n<h2 style=\"\nfont-size:48px;\nfont-weight:700;\ncolor:#6a003c;\nmargin-bottom:20px;\">\nSurprise Experiences by The Baking Kaur\n</h2>\n\n<p style=\"\nfont-size:20px;\nline-height:1.8;\ncolor:#555;\nmax-width:900px;\nmargin:0 auto 50px auto;\">\nMore than cakes. Create unforgettable moments with our surprise celebration experiences across Meerut.\n</p>\n\n<div style=\"\ndisplay:grid;\ngrid-template-columns:repeat(auto-fit,minmax(320px,1fr));\ngap:25px;\nmax-width:1200px;\nmargin:0 auto;\">\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 30px;\nborder-radius:16px;\">\n\n<div style=\"font-size:40px;margin-bottom:15px;\">🌙</div>\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:30px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\nMidnight Delivery\n</h3>\n\n<p style=\"color:#555;line-height:1.8;\">\nMake birthdays and anniversaries unforgettable with midnight cake surprises.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 30px;\nborder-radius:16px;\">\n\n<div style=\"font-size:40px;margin-bottom:15px;\">🌹</div>\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:30px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\nCake & Flowers\n</h3>\n\n<p style=\"color:#555;line-height:1.8;\">\nPremium gifting combinations delivered fresh for every special occasion.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 30px;\nborder-radius:16px;\">\n\n<div style=\"font-size:40px;margin-bottom:15px;\">🎈</div>\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:30px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\nCake & Balloons\n</h3>\n\n<p style=\"color:#555;line-height:1.8;\">\nReady-to-surprise celebration packages crafted for memorable moments.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 30px;\nborder-radius:16px;\">\n\n<div style=\"font-size:40px;margin-bottom:15px;\">💍</div>\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:30px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\nProposal Setup\n</h3>\n\n<p style=\"color:#555;line-height:1.8;\">\nCustomized romantic surprise experiences designed for unforgettable proposals.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 30px;\nborder-radius:16px;\">\n\n<div style=\"font-size:40px;margin-bottom:15px;\">🏨</div>\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:30px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\nHotel Surprises\n</h3>\n\n<p style=\"color:#555;line-height:1.8;\">\nCelebrate birthdays, anniversaries and special occasions in style.\n</p>\n\n</div>\n\n<div style=\"\nbackground:#faf7f5;\nbox-shadow:0 4px 15px rgba(0,0,0,0.05);\npadding:35px 30px;\nborder-radius:16px;\">\n\n<div style=\"font-size:40px;margin-bottom:15px;\">🚗</div>\n\n<h3 style=\"\ncolor:#6a003c;\nfont-size:30px;\nfont-weight:700;\nline-height:1.3;\nmargin-bottom:15px;\">\nCar Boot Surprise\n</h3>\n\n<p style=\"color:#555;line-height:1.8;\">\nUnique surprise experiences curated for loved ones and special celebrations.\n</p>\n\n</div>\n\n</div>\n\n<div style=\"margin-top:50px;\">\n\n<a href=\"https://wa.me/918218862928\"\nstyle=\"\ndisplay:inline-block;\nbackground:#25D366;\ncolor:white;\npadding:16px 34px;\nborder-radius:10px;\ntext-decoration:none;\nfont-weight:600;\nfont-size:16px;\">\nPlan A Surprise\n</a>\n\n</div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
