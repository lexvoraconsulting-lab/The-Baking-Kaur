    "custom_liquid_ahw7ni": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<h2 style=\"\ntext-align:center;\nfont-size:52px;\nfont-weight:700;\ncolor:#6a003c;\nmargin-bottom:20px;\">\nFrequently Asked Questions\n</h2>\n\n<p style=\"\ntext-align:center;\nfont-size:18px;\ncolor:#666;\nmax-width:700px;\nmargin:0 auto 50px auto;\nline-height:1.8;\">\nEverything you need to know about our eggless cakes, customization options, delivery services and celebration experiences in Meerut.\n</p>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 40,
        "padding_rate": 75
      }
    },
