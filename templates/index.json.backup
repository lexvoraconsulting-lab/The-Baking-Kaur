    "final_cta_tbk": {
      "type": "custom-liquid",
      "name": "Final Celebration CTA",
      "settings": {
        "section_fullwidth": false,
        "custom_liquid": "<div style=\"text-align:center;padding:80px 20px;max-width:900px;margin:auto;background:linear-gradient(135deg, #f8f4f2 0%, #fefcfb 100%);border-radius:16px;\">\n\n<h2 style=\"\nfont-size:48px;\nfont-weight:700;\ncolor:#6a003c;\nline-height:1.2;\nmargin-bottom:15px;\">\nLet's Create Something Worth Celebrating\n</h2>\n\n<p style=\"\nfont-size:18px;\ncolor:#555;\nmax-width:700px;\nmargin:0 auto 35px auto;\nline-height:1.8;\">\nWhether it's a birthday, anniversary, wedding, or milestone moment — we'll craft a cake that makes it unforgettable. From custom designs to midnight surprises, we're here to celebrate with you.\n</p>\n\n<div style=\"display:flex;flex-wrap:wrap;justify-content:center;gap:15px;\">\n\n<a href=\"/collections/all\"\nstyle=\"\ndisplay:inline-block;\nbackground:#6a003c;\ncolor:white;\npadding:16px 36px;\ntext-decoration:none;\nborder-radius:8px;\nfont-weight:600;\nfont-size:16px;\">\nExplore Cakes\n</a>\n\n<a href=\"https://wa.me/918218862928\"\nstyle=\"\ndisplay:inline-block;\nbackground:#25D366;\ncolor:white;\npadding:16px 36px;\ntext-decoration:none;\nborder-radius:8px;\nfont-weight:600;\nfont-size:16px;\">\nOrder on WhatsApp\n</a>\n\n</div>\n\n</div>",
        "color_scheme": "",
        "padding_top": 60,
        "padding_bottom": 60,
        "padding_rate": 50
      }
    },
