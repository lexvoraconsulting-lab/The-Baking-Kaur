    [/ÃƒÂ¢Ã‚Â€Ã‚Â—/g, '—'],
    [/Ã¢Â€Â“/g, '–'],
    [/Ã¢Â€Â—/g, '—'],
    [/Ã‚Â°/g, '°'],
    [/Ã‚Â/g, '']
  ];

  // ponytail: cheap pre-check so pages with no mojibake skip the DOM walk entirely
  const anyMojibake = new RegExp(map.map(rule => rule[0].source).join('|'));

  function fix(node) {
    let text = node.nodeValue;
    map.forEach(rule => {
      while (rule[0].test(text)) {
        text = text.replace(rule[0], rule[1]);
      }
    });
    node.nodeValue = text;
  }

  function runFix() {
    if (!anyMojibake.test(document.body.textContent)) return;
    const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
    let node;
    while ((node = walker.nextNode())) {
      fix(node);
    }
  }

  window.addEventListener('load', function () {
    setTimeout(runFix, 500);
  });

})();
</script>

