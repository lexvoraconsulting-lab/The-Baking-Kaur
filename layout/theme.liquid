               <script>
(function () {

  function removeStickyATC() {
    var selectors = [
      '.tbk-sticky-atc',
      '.tbk-sticky-btn',
      '.sticky-atc',
      '.sticky-cart',
      '[class*="sticky"][class*="cart"]'
    ];

    selectors.forEach(function(selector) {
      document.querySelectorAll(selector).forEach(function(el) {
        el.remove();
      });
    });
  }

  // Run immediately
  removeStickyATC();

  // Also watch for dynamically injected elements
  var observer = new MutationObserver(function () {
    removeStickyATC();
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

})();
</script>

<script>
(function () {
  function removePrevArrows() {
    document.querySelectorAll(
      '.hdt-prev, .hdt-nav-prev, .hdt-slider-prev, .swiper-button-prev, button, span'
    ).forEach(el => {
      if (el.innerText && el.innerText.trim() === '<') {
        el.remove();
      }
    });
  }

  removePrevArrows();

  const obs = new MutationObserver(removePrevArrows);
  obs.observe(document.body, { childList: true, subtree: true });
})();
</script>
