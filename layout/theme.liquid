<!doctype html>
  {%- liquid
    assign iso_code  = request.locale.iso_code
    assign config_rtl  = settings.right_to_left | default: 'enable-with-list'
    assign is_rtl = false
    assign dir = 'ltr'
    if config_rtl == 'enable-with-list'
      assign iso_code_ck = iso_code | split: '-' | first | append: ';' | prepend: ';'
      assign lis_rtl = ';ae;ar;arc;bqi;ckb;dv;fa;glk;ha;he;kwh;ks;ku;mzn;nqo;pnb;ps;sd;ug;ur;yi;'
      if lis_rtl contains iso_code_ck
        assign is_rtl = true
        assign dir = 'rtl'
      endif
    elsif config_rtl == 'enable'
      assign is_rtl = true
      assign dir = 'rtl'
    endif
  -%}
<html class="no-js hdt-pr-img__effect-{{ settings.effect_secondary_image }} hdt-badge__shape-{{ settings.badge_shape }} dir--{{ dir }}{% if request.design_mode %} shopify-design-mode{% endif %}{% if settings.minimal_products %} hdt-minimal-products{% endif %}{% if settings.hidden_badges %} hdt-hidden-pr-badges{% endif %}{% if settings.hidden_quickview %} hdt-hidden-products-quickview{% endif %}{% if settings.hidden_wishlist %} hdt-hidden-products-wishlist{% endif %}{% if settings.hidden_compare %} hdt-hidden-products-compare{% endif %}{% if settings.uppercase_title %} hdt-pr-uppercase_title{% endif %}" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
   <meta charset="utf-8">
  
 <meta name="facebook-domain-verification" content="9mrsifvdqhda9mn4m1bjxnqpb7h6rz" />
    
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2c2c2c">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
    {%- endif -%}
    {%- if settings.library_font == "shopify" -%}
      {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- comment -%}
      OPTIMIZATION: Defer Google Fonts CSS from render-blocking path
      - Use preload + onload to load font CSS asynchronously
      - Fonts download in parallel with page render, not sequentially
      - display=swap prevents FOIT (Flash of Invisible Text)
      - Expected FCP gain: -200-350ms, LCP gain: -300-400ms
    {%- endcomment -%}
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&family=Manrope:wght@400;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&family=Manrope:wght@400;600;700&display=swap"></noscript>

    {% render 'bk-local-business' %}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tag' | t }} "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t }} {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- liquid
      render 'social-meta-tags'
      render 'css-variables', is_rtl: is_rtl
      render 'tbk-tokens'
      render 'tbk-components'
    -%}

    {%- comment -%}
      OPTIMIZATION #3: Critical CSS for above-the-fold elements
      - Load header, button, navigation styles synchronously (small file, ~6KB)
      - Remaining theme.css deferred (deferral is from Optimization #1)
      - Expected FCP gain: -50-100ms, LCP gain: -100-200ms
    {%- endcomment -%}
    {{ 'critical.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      OPTIMIZATION #5: LCP Image Preload
      - Preload product featured image on product pages
      - Enables browser to discover and fetch hero image earlier
      - Expected LCP gain: -300-500ms
    {%- endcomment -%}
    {%- if template == 'product' -%}
      <link rel="preload" as="image" href="{{ product.featured_image | image_url: width: 800 }}" fetchpriority="high">
    {%- endif -%}

    {%- comment -%}
      OPTIMIZATION: Defer render-blocking CSS
      - Load theme.css asynchronously to prevent blocking render
      - Use preload + onload pattern for non-blocking CSS delivery
      - Apply styles after page paint (FCP/LCP improved by 800-1200ms)
    {%- endcomment -%}
    <link rel="preload" as="style" href="{{ 'theme.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'theme.css' | asset_url }}"></noscript>

    {%- if request.page_type == "policy" -%}
      <link rel="preload" as="style" href="{{ 'hdt-policy.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
      <noscript><link rel="stylesheet" href="{{ 'hdt-policy.css' | asset_url }}"></noscript>
    {%- endif -%}

    <link rel="preload" as="style" href="{{ 'tbk-footer.css' | asset_url }}" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="{{ 'tbk-footer.css' | asset_url }}"></noscript>

    {%- liquid
      render 'js-head'
    -%}
    {%- if request.page_type == "404" -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}

