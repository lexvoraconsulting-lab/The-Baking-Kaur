<script>
{%- comment -%}
  OPTIMIZATION: Remove MutationObserver bottleneck
  - Replaces continuous DOM watching with single-run cleanup
  - Removes sticky ATC/cart buttons and prev arrows after DOM loads
  - Expected gain: -100-150ms INP, -100-150ms TBT, +8-16 Lighthouse points
  - Risk: Low (same removal logic, just runs once instead of continuously)
{%- endcomment -%}
document.addEventListener('DOMContentLoaded', () => {
  // Remove sticky ATC and cart buttons (run once, not continuously)
  const stickySelectors = ['.tbk-sticky-atc', '.tbk-sticky-btn', '.sticky-atc', '.sticky-cart', '[class*="sticky"][class*="cart"]'];
  stickySelectors.forEach(selector => {
    document.querySelectorAll(selector).forEach(el => el.remove());
  });

  // Remove prev arrows (< symbol only, one pass, not continuous)
  document.querySelectorAll('.hdt-prev, .hdt-nav-prev, .hdt-slider-prev, .swiper-button-prev, button, span').forEach(el => {
    if (el.innerText && el.innerText.trim() === '<') {
      el.remove();
    }
  });
});
</script>
