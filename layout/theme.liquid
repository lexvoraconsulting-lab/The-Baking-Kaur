{%- comment -%}
  OPTIMIZATION #8: Lazy Load Below-Fold Sections
  - Use Intersection Observer to detect when tabs/related sections become visible
  - Defers image loading until section enters viewport (via data-src)
  - Expected LCP gain: -100-150ms, TBT gain: -50-100ms
  - No layout shift: images pre-converted to data-src before rendering
{%- endcomment -%}
<script>
(function() {
  'use strict';

  if (!window.IntersectionObserver) return;

  const OBSERVE_SECTIONS = ['tabs', 'related'];
  const LOAD_OPTIONS = {
    root: null,
    rootMargin: '100px',
    threshold: 0.01
  };

  /**
   * Convert images to lazy format (src → data-src)
   * Prevents download until section is visible
   */
  function deferSectionImages(section) {
    if (!section) return;

    const images = section.querySelectorAll('img');
    images.forEach(img => {
      // Skip if already deferred or has no src
      if (!img.src || img.dataset.src) return;

      // Move src to data-src to prevent loading
      img.dataset.src = img.src;
      img.src = ''; // Clear src to stop image download

      // Add loading class
      img.classList.add('lazy-image');
    });
  }

  /**
   * Load images when section becomes visible
   */
  function loadSectionImages(section) {
    if (!section) return;

    // Restore images from data-src to src
    const lazyImages = section.querySelectorAll('img[data-src]');
    lazyImages.forEach(img => {
      img.src = img.dataset.src;
      img.removeAttribute('data-src');
      img.classList.add('lazy-loaded');
    });

    section.classList.add('section-loaded');
  }

  /**
   * Set up lazy loading for below-fold sections
   */
  function initLazyLoading() {
    // Step 1: Defer images in below-fold sections
    OBSERVE_SECTIONS.forEach(sectionId => {
      const section = document.getElementById(sectionId);
      if (section) deferSectionImages(section);
    });

    // Step 2: Watch for when sections become visible
    const observer = new IntersectionObserver(function(entries) {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          loadSectionImages(entry.target);
          observer.unobserve(entry.target);
        }
      });
    }, LOAD_OPTIONS);

    OBSERVE_SECTIONS.forEach(sectionId => {
      const section = document.getElementById(sectionId);
      if (section) observer.observe(section);
    });
  }

  // Run as early as possible
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLazyLoading);
  } else {
    initLazyLoading();
  }
})();
</script>

