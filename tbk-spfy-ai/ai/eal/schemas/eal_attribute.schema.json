{
  "$defs": {
    "ExternalIdModel": {
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "id_type": {
          "title": "Id Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "system",
        "id_type",
        "value"
      ],
      "title": "ExternalIdModel",
      "type": "object"
    },
    "HumanVerificationModel": {
      "properties": {
        "status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "pending_review",
            "verified",
            "rejected",
            "corrected"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "original_value": {
          "default": null,
          "title": "Original Value"
        }
      },
      "title": "HumanVerificationModel",
      "type": "object"
    },
    "ProvenanceModel": {
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "taxonomy_version": {
          "title": "Taxonomy Version",
          "type": "string"
        },
        "extracted_at": {
          "title": "Extracted At",
          "type": "string"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "provider",
        "model",
        "schema_version",
        "taxonomy_version",
        "extracted_at"
      ],
      "title": "ProvenanceModel",
      "type": "object"
    }
  },
  "properties": {
    "canonical_path": {
      "title": "Canonical Path",
      "type": "string"
    },
    "namespace": {
      "title": "Namespace",
      "type": "string"
    },
    "group": {
      "title": "Group",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "image",
        "region",
        "object"
      ],
      "title": "Entity Type",
      "type": "string"
    },
    "value": {
      "title": "Value"
    },
    "value_state": {
      "enum": [
        "present",
        "null",
        "unknown"
      ],
      "title": "Value State",
      "type": "string"
    },
    "data_type": {
      "enum": [
        "string",
        "integer",
        "float",
        "boolean",
        "enum",
        "date",
        "datetime",
        "array",
        "object",
        "vector",
        "reference"
      ],
      "title": "Data Type",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ProvenanceModel"
    },
    "attribute_id": {
      "title": "Attribute Id",
      "type": "string"
    },
    "eal_version": {
      "default": "1.0",
      "title": "Eal Version",
      "type": "string"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "vocabulary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vocabulary"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "human_verification": {
      "$ref": "#/$defs/HumanVerificationModel"
    },
    "external_ids": {
      "items": {
        "$ref": "#/$defs/ExternalIdModel"
      },
      "title": "External Ids",
      "type": "array"
    }
  },
  "required": [
    "canonical_path",
    "namespace",
    "group",
    "entity_id",
    "entity_type",
    "value",
    "value_state",
    "data_type",
    "provenance",
    "attribute_id"
  ],
  "title": "EALAttributeRecordModel",
  "type": "object"
}
