    {
      "parameters": {
        "jsCode": "const t = $('When Called').first().json || {};\nconst auditId = $('Generate Audit ID').first().json.data;\nconst imageId = t.image_id || \"\";\nconst stage = t.stage || \"\";\nlet status = t.status || \"unknown\";\nif (!imageId || !stage) { status = \"incomplete_metadata\"; }\nconst latency = (t.latency_ms === undefined || t.latency_ms === null) ? 0 : t.latency_ms;\nconst confidence = (t.confidence_score === undefined || t.confidence_score === null) ? null : t.confidence_score;\nreturn [{ json: {\n  audit_id: auditId,\n  image_id: imageId,\n  batch_id: t.batch_id || \"\",\n  stage: stage,\n  status: status,\n  latency_ms: latency,\n  error_message: t.error_message || \"\",\n  model_version: t.model_version || \"\",\n  confidence_score: confidence,\n  created_by: \"TBK_Vision_Orchestrator\"\n} }];"
      },
