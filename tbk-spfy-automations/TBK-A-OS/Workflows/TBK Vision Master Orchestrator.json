    {
      "parameters": {
        "jsCode": "const results = $('Validate Files').all().map(i => i.json);\nconst validated = results.filter(r => r.validated === true).length;\nconst rejected = results.length - validated;\nlet status = 'partial';\nif (validated === 0) { status = 'failed'; }\nelse if (rejected === 0) { status = 'success'; }\nconst ctx = $('Prepare Context').first().json;\nconst started = new Date(ctx.started_at).getTime();\nconst duration_ms = Date.now() - started;\nreturn [{ json: {\n  batch_id: ctx.batch_id,\n  status,\n  validated_count: validated,\n  rejected_count: rejected,\n  duration_ms\n} }];"
      },
