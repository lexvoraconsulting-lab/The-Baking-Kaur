      "parameters": {
        "jsCode": "const rows = $input.all().filter(i => i.json && Object.keys(i.json).length > 0 && i.json.file_hash);\nconst duplicate = rows.length > 0;\nconst imageId = $('Generate Image ID').first().json.data;\nconst t = $('When Called').first().json;\nconst fileHash = $('Hash Content').first().json.file_hash;\nreturn [{ json: {\n  image_id: imageId,\n  batch_id: t.batch_id,\n  file_hash: fileHash,\n  s3_path: t.file_url,\n  status: duplicate ? 'rejected' : 'queued',\n  validated: !duplicate,\n  rejection_reason: duplicate ? 'duplicate_hash_exists' : null\n} }];"
      },
