{% comment %}
  ============================================================
  The Baking Kaur — Main Product Section (Online Store 2.0)
  ------------------------------------------------------------
  Model:
    • Weight & Flavour  -> product VARIANTS (Weight drives price)
    • Delivery date/time & Message -> LINE ITEM PROPERTIES
  Requires product options named exactly "Weight" and "Flavour"
  (case-insensitive). Falls back gracefully if they are absent.
  ============================================================
{% endcomment %}

{{ 'baking-kaur.css' | asset_url | stylesheet_tag }}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="bk-wrap" data-bk-product>
  <nav class="bk-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">Home</a><span>›</span>
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a><span>›</span>
    {%- endif -%}
    <span class="is-current">{{ product.title }}</span>
  </nav>

  <div class="bk-hero">
    {% comment %} ---------- LEFT: gallery ---------- {% endcomment %}
    <div class="bk-gallery">
      <div class="bk-gallery__main">
        {%- if product.featured_media -%}
          <img
            id="bk-main-image"
            src="{{ product.featured_media | image_url: width: 920 }}"
            srcset="{{ product.featured_media | image_url: width: 460 }} 460w, {{ product.featured_media | image_url: width: 920 }} 920w"
            sizes="(min-width: 750px) 460px, 100vw"
            alt="{{ product.featured_media.alt | escape | default: product.title }}"
            width="460" height="460" loading="eager">
        {%- else -%}
          <div class="bk-gallery__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}

        {%- if section.settings.show_bestseller_badge -%}
          <span class="bk-badge">Bestseller</span>
        {%- endif -%}

        <button type="button" class="bk-wish" aria-label="Add to wishlist" data-bk-wish>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#B23A63" stroke-width="1.7"><path d="M12 21s-7.5-4.6-10-9.1C.3 8.4 2 5 5.4 5c2 0 3.4 1.1 4.6 2.6C11.2 6.1 12.6 5 14.6 5 18 5 19.7 8.4 18 11.9 15.5 16.4 12 21 12 21z"/></svg>
        </button>
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="bk-thumbs" role="list">
          {%- for media in product.media limit: 8 -%}
            <li>
              <button type="button" class="bk-thumb{% if forloop.first %} is-active{% endif %}"
                      data-bk-thumb
                      data-full="{{ media | image_url: width: 920 }}"
                      aria-label="View image {{ forloop.index }}">
                <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" width="80" height="80" loading="lazy">
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {% comment %} ---------- RIGHT: buy box ---------- {% endcomment %}
    <div class="bk-buybox">
      <div class="bk-rating">
        <span class="bk-rating__star" aria-hidden="true">★</span>
        <span class="bk-rating__value">{{ section.settings.rating_value }}</span>
        <span class="bk-rating__sep"></span>
        <span class="bk-rating__count">{{ section.settings.rating_count }} Reviews</span>
      </div>

      <h1 class="bk-title">{{ product.title }}</h1>

      <div class="bk-price" data-bk-price>
        {{ current_variant.price | money }}
      </div>

      <div class="bk-pills">
        <span class="bk-pill">100% Eggless</span>
        <span class="bk-pill">Same Day Delivery</span>
        <span class="bk-pill">Freshly Made</span>
      </div>

      {%- form 'product', product, id: 'bk-product-form', class: 'bk-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-bk-variant-id>

        {% comment %} ----- Variant options (Weight, Flavour, …) ----- {% endcomment %}
        {%- unless product.has_only_default_variant -%}
          <div class="bk-fields">
            {%- for option in product.options_with_values -%}
              <label class="bk-field">
                <span class="bk-field__label">{{ option.name }}</span>
                <select class="bk-field__select"
                        name="options[{{ option.name | escape }}]"
                        data-bk-option-index="{{ forloop.index0 }}"
                        data-bk-option-selector>
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </label>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {% comment %} ----- Line-item properties ----- {% endcomment %}
        <div class="bk-fields bk-fields--props">
          <label class="bk-field">
            <span class="bk-field__label">{{ section.settings.date_property_label }}</span>
            <input class="bk-field__input" type="date"
                   name="properties[{{ section.settings.date_property_label }}]"
                   min="{{ 'now' | date: '%Y-%m-%d' }}">
          </label>

          <label class="bk-field">
            <span class="bk-field__label">{{ section.settings.slot_property_label }}</span>
            <select class="bk-field__select" name="properties[{{ section.settings.slot_property_label }}]">
              {%- assign slots = section.settings.slot_options | split: ',' -%}
              {%- for s in slots -%}
                <option value="{{ s | strip | escape }}">{{ s | strip }}</option>
              {%- endfor -%}
            </select>
          </label>
        </div>

        <label class="bk-field bk-field--full">
          <span class="bk-field__label">{{ section.settings.message_property_label }} (optional)</span>
          <input class="bk-field__input" type="text" maxlength="60"
                 name="properties[{{ section.settings.message_property_label }}]"
                 placeholder="e.g. Happy Birthday ♥">
        </label>

        {% comment %} ----- Availability + CTAs ----- {% endcomment %}
        <div class="bk-cta">
          <button type="submit" name="add" class="bk-btn bk-btn--primary"
                  {% unless current_variant.available %}disabled{% endunless %} data-bk-add>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
            <span data-bk-add-text>
              {%- if current_variant.available -%}ADD TO CART&nbsp;·&nbsp;{{ current_variant.price | money }}{%- else -%}Sold Out{%- endif -%}
            </span>
          </button>

          {%- if product.selling_plan_groups == empty -%}
            {{ form | payment_button }}
          {%- endif -%}
        </div>

        {%- if section.settings.enable_whatsapp -%}
          <a class="bk-btn bk-btn--whatsapp"
             href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ 'I would like to customise: ' | append: product.title | url_encode }}"
             target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 .9-2.2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.8.9c.3.1.4.2.5.3.1.3.1.7-.1 1.2z"/></svg>
            WhatsApp Customization
          </a>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{%- if section.settings.enable_sticky_bar -%}
  <div class="bk-sticky" data-bk-sticky hidden>
    <div class="bk-sticky__price" data-bk-sticky-price>{{ current_variant.price | money }}</div>
    <button type="submit" form="bk-product-form" name="add" class="bk-btn bk-btn--primary bk-sticky__add">
      ADD TO CART
    </button>
    {%- if section.settings.enable_whatsapp -%}
      <a class="bk-btn bk-btn--whatsapp bk-sticky__wa" href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2z"/></svg>
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% comment %} ---------- Variant data + JSON-LD ---------- {% endcomment %}
<script type="application/json" data-bk-variants>
  {{ product.variants | json }}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "image": [{% for media in product.media limit: 4 %}{{ media | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "sku": {{ current_variant.sku | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
    "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
    "offerCount": {{ product.variants.size }},
    "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ product.url | prepend: shop.url | json }}
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ section.settings.rating_value | json }},
    "reviewCount": "500"
  }
}
</script>

{{ 'baking-kaur.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "BK Main Product",
  "tag": "section",
  "class": "bk-section-main",
  "settings": [
    { "type": "header", "content": "Rating" },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.8" },
    { "type": "text", "id": "rating_count", "label": "Rating count", "default": "500+" },
    { "type": "header", "content": "Badges & bars" },
    { "type": "checkbox", "id": "show_bestseller_badge", "label": "Show Bestseller badge on image", "default": false },
    { "type": "checkbox", "id": "enable_sticky_bar", "label": "Enable sticky mobile buy bar", "default": true },
    { "type": "header", "content": "WhatsApp" },
    { "type": "checkbox", "id": "enable_whatsapp", "label": "Enable WhatsApp button", "default": true },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (country code, no +)", "default": "91XXXXXXXXXX" },
    { "type": "header", "content": "Line item properties" },
    { "type": "text", "id": "date_property_label", "label": "Delivery date label", "default": "Delivery date" },
    { "type": "text", "id": "slot_property_label", "label": "Time slot label", "default": "Time slot" },
    { "type": "textarea", "id": "slot_options", "label": "Time slot options (comma separated)", "default": "Select Time Slot, 12-3 PM, 3-6 PM, 6-9 PM, Midnight" },
    { "type": "text", "id": "message_property_label", "label": "Message label", "default": "Message on cake" }
  ],
  "presets": [{ "name": "BK Main Product" }]
}
{% endschema %}
