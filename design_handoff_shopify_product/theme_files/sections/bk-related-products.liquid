{{ 'baking-kaur.css' | asset_url | stylesheet_tag }}
<section class="bk-wrap">
  <h2 class="bk-section-heading">{{ section.settings.heading }}</h2>
  <div class="bk-related">
    {%- if section.settings.product_list.count > 0 -%}
      {%- for product in section.settings.product_list limit: section.settings.products_to_show -%}
        <a class="bk-related__card" href="{{ product.url }}">
          <div class="bk-related__media">
            {%- if product.featured_media -%}
              <img src="{{ product.featured_media | image_url: width: 360 }}" alt="{{ product.featured_media.alt | escape | default: product.title }}" width="180" height="180" loading="lazy">
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="bk-related__body">
            <div class="bk-related__name">{{ product.title }}</div>
            <div class="bk-related__meta">
              <span class="bk-related__price">{{ product.price | money }}</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      <p class="bk-empty">Select products in the theme editor to populate “You May Also Like”.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BK Related Products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "product_list", "id": "product_list", "label": "Products", "limit": 8 },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "presets": [{ "name": "BK Related Products" }]
}
{% endschema %}
